RESEND_API_KEY=

# Listings. The website build needs none of the NOTION_* values: it reads only committed files.
LISTINGS_ENQUIRY_MODE=
LISTINGS_MEDIA_BASE_URL=

# Notion (read only). Put these in .env.listings, which is git-ignored, and run `npm run listings:*`.
# NOTION_TOKEN=
# NOTION_PROPERTIES_DATA_SOURCE_ID=
# NOTION_API_VERSION=
