{
  "name": "10_sdahc_website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:listings": "node scripts/test-listings.mjs",
    "check:privacy": "node scripts/check-dist-privacy.mjs",
    "listings:preview": "node --env-file-if-exists=.env.listings scripts/local-preview.mjs",
    "dev:preview": "LISTINGS_LOCAL_PREVIEW=1 astro dev --host 127.0.0.1",
    "listings:photos": "node scripts/prepare-listing-photos.mjs",
    "listings:schema": "node --env-file-if-exists=.env.listings scripts/listings-sync.mjs --schema",
    "listings:preflight": "node --env-file-if-exists=.env.listings scripts/listings-sync.mjs --preflight",
    "listings:propose": "node --env-file-if-exists=.env.listings scripts/listings-sync.mjs --propose",
    "listings:withdraw": "node scripts/listings-sync.mjs --withdraw",
    "check:withdrawal": "node scripts/check-withdrawal.mjs",
    "check:readiness": "node scripts/check-readiness.mjs",
    "listings:manifest": "node scripts/print-schema-manifest.mjs",
    "listings:doctor": "node --env-file-if-exists=.env.listings scripts/listings-sync.mjs --doctor",
    "listings:test-delivery": "node --env-file-if-exists=.env --env-file-if-exists=.env.listings scripts/test-enquiry-delivery.mjs",
    "listings:photos:verify": "node scripts/prepare-listing-photos.mjs --verify"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.5",
    "resend": "^6.29.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
