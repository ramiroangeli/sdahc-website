<style>
.mapgrid{display:grid;grid-template-columns:1.3fr .9fr;gap:44px;align-items:center;margin-top:44px}
svg.ausmap{width:100%;height:auto;display:block;overflow:visible}
.st{fill:var(--mapfill);stroke:var(--navy);stroke-width:1.1;cursor:pointer;transition:fill .2s,filter .2s}
.st:hover{fill:var(--maphover)}
.st.sel{fill:var(--blue);filter:drop-shadow(0 0 16px rgba(4,118,217,.55))}
.st:focus-visible,.actdot:focus-visible,.chip:focus-visible{outline:2px solid #fff;outline-offset:2px}
.lbl{font-family:var(--sans);font-weight:600;font-size:19px;fill:var(--pale);text-anchor:middle;pointer-events:none;paint-order:stroke;stroke:var(--navy);stroke-width:3px}
.lbl.on{fill:#fff}
.actdot{fill:var(--mapfill);stroke:var(--navy);stroke-width:1.2;cursor:pointer;transition:fill .2s}
.actdot.sel{fill:var(--blue);filter:drop-shadow(0 0 12px rgba(4,118,217,.6))}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
.chip{font-family:var(--geo);font-size:12px;font-weight:500;letter-spacing:.08em;color:var(--pale);background:transparent;border:1px solid rgba(185,203,224,.3);padding:7px 12px;cursor:pointer;transition:.15s}
.chip:hover{border-color:var(--pale);color:#fff}
.chip.sel{background:var(--blue);border-color:var(--blue);color:#fff}
.panel{background:var(--paper);color:var(--navy);border-radius:3px;padding:32px;box-shadow:0 24px 60px rgba(0,10,25,.45)}
.panel .kick{font-family:var(--geo);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin:0}
.panel h3{font-family:var(--serif);font-weight:600;font-size:26px;margin:8px 0 20px;color:var(--navy)}
.pstat{display:flex;align-items:baseline;justify-content:space-between;gap:14px;padding-bottom:13px;margin-bottom:13px;border-bottom:1px solid rgba(6,51,107,.14)}
.pstat:last-of-type{border-bottom:0}
.pstat .num{font-family:var(--cond);font-weight:600;font-size:42px;line-height:.9;color:var(--navy2);font-variant-numeric:tabular-nums}
.pstat .lab{font-size:13.5px;color:var(--slate);text-align:right;max-width:14ch}
.go{display:inline-block;margin-top:22px;font-family:var(--geo);font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:var(--blue);padding:11px 16px;text-decoration:none}
.go:hover{background:#0866bd}
.sampletag{font-size:11px;color:var(--muted);margin:16px 0 0;padding-left:10px;border-left:2px solid var(--amber)}
@media(max-width:860px){.mapgrid{grid-template-columns:1fr}.panel{order:2}}
</style>
<script>
import DATA from '../data/sda-states.json';

const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
function clamp(v,a,b){return Math.max(a,Math.min(b,v))}
const abbrs=Object.keys(DATA);
const NAT={name:'Australia',d:abbrs.reduce((s,a)=>s+DATA[a].d,0),p:abbrs.reduce((s,a)=>s+DATA[a].p,0),r:abbrs.reduce((s,a)=>s+DATA[a].r,0)};
function G(i){return document.getElementById(i)}const el={d:G('n-d'),p:G('n-p'),r:G('n-r'),name:G('p-name'),kick:G('p-kick'),go:G('p-go')};
function fmt(x){return x.toLocaleString('en-AU')}
const initialState=document.querySelector('.mapgrid').dataset.initialState||'AU';
let locked=initialState,raf;
function nums(o,an){const tg={d:o.d,p:o.p,r:o.r};if(!an||reduce){for(const k in tg)el[k].textContent=fmt(tg[k]);return;}
 cancelAnimationFrame(raf);const t0=performance.now();(function tk(n){const k=clamp((n-t0)/520,0,1),z=1-Math.pow(1-k,3);
  for(const q in tg)el[q].textContent=fmt(Math.round(tg[q]*z));if(k<1)raf=requestAnimationFrame(tk);})(t0);}
function paint(s){document.querySelectorAll('.st').forEach(x=>x.classList.toggle('sel',x.dataset.s===s));
 document.querySelectorAll('.lbl').forEach(l=>l.classList.toggle('on',l.dataset.lbl===s));
 document.querySelectorAll('.chip').forEach(c=>c.classList.toggle('sel',c.dataset.s===s));
 const dot=document.querySelector('.actdot');if(dot)dot.classList.toggle('sel',s==='ACT');}
function render(s,an){const o=s==='AU'?NAT:DATA[s];el.name.textContent=o.name;el.kick.textContent=s==='AU'?'National overview':'State & territory';
 el.go.textContent=s==='AU'?'View the research →':('View the '+s+' market report →');
 el.go.href=s==='AU'?'/research/':('/research/sda-market-'+s.toLowerCase()+'/');nums(o,an);paint(s);}
document.querySelectorAll('.st,.actdot').forEach(x=>{const s=x.dataset.s;
 x.addEventListener('mouseenter',()=>render(s,false));x.addEventListener('mouseleave',()=>render(locked,false));
 x.addEventListener('click',()=>{locked=s;render(s,true);});x.addEventListener('keydown',ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();locked=s;render(s,true);}});});
document.querySelectorAll('.chip').forEach(c=>{const s=c.dataset.s;
 c.addEventListener('mouseenter',()=>render(s,false));c.addEventListener('mouseleave',()=>render(locked,false));c.addEventListener('click',()=>{locked=s;render(s,true);});});
render(initialState,false);
</script>
