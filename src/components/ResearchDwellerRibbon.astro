---
// Shared Research Hub graphic motif (Stage 2 v2, Route 1B Dweller Line), reused across several
// sections rather than drawn once in the hero: the same approved curve
// (M51 106 C49.5 92 50 82 55.5 77.5 C61 73 74 70 87 57.5, uniformly scaled 9x and translated,
// see prior revisions of this file for the full point-by-point derivation) is cropped and
// recoloured per call site, so the two or three interventions across the page read as one
// coherent system instead of unrelated illustrations. Every preset reads on the Warm Paper
// ground (the hero itself no longer carries a graphic, per the compact-hero redesign), so all
// colours here are the paper-toned half of the palette (Signal Deep, Wattle/Wattle Deep, Ember),
// never the ink-ground Signal Blue used when this motif still lived on the dark hero.
const RIBBON_D = "M260.7 750 L250 650 C236.5 524 241 434 290.5 393.5 C340 353 457 326 574 213.5 L796 0";

type Variant = 'mark' | 'band' | 'close';

interface Props { variant?: Variant }
const { variant = 'mark' } = Astro.props;

// Each preset is a different crop of the identical curve, so no new geometry is invented per
// placement: only the viewBox window, colour and whether a companion line/dot is shown change.
const presets: Record<Variant, { viewBox: string; main: string; companion?: string; dotCx?: number; dotCy?: number; dot?: string }> = {
  // Head of the curve (574,213.5): a small corner mark for the publications callout.
  mark: { viewBox: '420 150 280 230', main: 'var(--r-signal-deep)', dotCx: 574, dotCy: 213.5, dot: 'var(--r-signal-deep)' },
  // Middle bend: a thin two-line band entering from a section's edge, Signal Deep + Wattle
  // companion, the same pairing the hero's old "large" treatment used. Wide enough to keep the
  // full (290.5,393.5)-(574,213.5) bend in frame rather than clipping it to a near-straight line.
  band: { viewBox: '255 185 340 225', main: 'var(--r-signal-deep)', companion: 'var(--r-wattle)' },
  // The curve's own S-bend just above its tail (250,650)-(290.5,393.5): a small closing
  // flourish, Ember-toned for variety so it reads as a bookend rather than a repeat of the
  // opening mark, and curved enough to read as part of the same family as the other two.
  close: { viewBox: '195 370 180 300', main: 'var(--r-ember)', dotCx: 250, dotCy: 650, dot: 'var(--r-ember-deep)' },
};
const p = presets[variant];
---
<svg class={`rdr-svg rdr-${variant}`} viewBox={p.viewBox} preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  {p.companion && (
    <path d={RIBBON_D} transform="translate(14 12)" fill="none" stroke={p.companion} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="rdr-companion" data-r-motion />
  )}
  <path d={RIBBON_D} pathLength="1" fill="none" stroke={p.main} stroke-width="6" stroke-linecap="round" stroke-linejoin="round" class="rdr-main" data-r-motion />
  {p.dot && <circle cx={p.dotCx} cy={p.dotCy} r="5" fill={p.dot} class="rdr-dot" data-r-motion />}
</svg>
<style>
.rdr-svg{display:block;width:100%;height:100%}
/* One-time draw-on for the main line; the companion line and dot fade in shortly after. All
   three skip straight to their finished, fully-visible state under reduced motion. */
.rdr-main{stroke-dasharray:1;stroke-dashoffset:1;animation:rdrDrawOn 1600ms var(--r-ease-out) forwards}
.rdr-companion,.rdr-dot{opacity:0;animation:rdrFadeIn var(--r-motion-base) var(--r-ease-out) 400ms forwards}
@keyframes rdrDrawOn{to{stroke-dashoffset:0}}
@keyframes rdrFadeIn{to{opacity:1}}
@media(prefers-reduced-motion:reduce){
  .rdr-main{animation:none;stroke-dashoffset:0}
  .rdr-companion,.rdr-dot{animation:none;opacity:1}
}
</style>
