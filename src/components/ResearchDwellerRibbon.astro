---
// Reusable Dweller-derived ribbon graphic, shared by the Research Hub's expressive hero
// (`size="large"`) and its continuation at the top of the Publications section
// (`size="echo"`), so the two read as genuinely the same trajectory continuing rather than two
// independently invented graphics that merely resemble each other.
//
// Both sizes use the exact same base curve, Stage 2 v2's approved Dweller Line
// (M51 106 C49.5 92 50 82 55.5 77.5 C61 73 74 70 87 57.5), uniformly scaled 9x and translated
// (translate(-209 -304)), then extended a short straight distance past each endpoint along that
// endpoint's own tangent direction so it runs off the panel edges rather than floating inside a
// small box. Nothing is redrawn, restretched or arbitrarily reshaped:
//   p1 (51,106)  -> (250,650)      p5 (61,73)   -> (340,353)
//   p2 (49.5,92) -> (236.5,524)    p6 (74,70)   -> (457,326)
//   p3 (50,82)   -> (241,434)      p7 (87,57.5) -> (574,213.5)
//   p4 (55.5,77.5) -> (290.5,393.5)
// extended start (continuing the p2->p1 tangent to y=750): (260.7,750)
// extended end   (continuing the p6->p7 tangent to y=0):   (796,0)
//
// Dimensional "tube" treatment: 3 concentric strokes along that identical centreline (no
// parallel-offset path computed) - widest and darkest at the back, narrowest and brightest at
// the front, each with its own tonal gradient along the ribbon's own length. This is the
// standard 2D-vector technique for implying a rounded, lit cross-section, deliberately not a
// flat stroke with an outer blur/glow filter.
//
// The Wattle accent is a second, thinner offset copy of the identical curve (a secondary
// trajectory, not an isolated shape), and the Ember accent is a soft glow positioned at (574,
// 213.5), a real point already on the curve (its "head"), not a floating decorative dot.
const RIBBON_D = "M260.7 750 L250 650 C236.5 524 241 434 290.5 393.5 C340 353 457 326 574 213.5 L796 0";

interface Props { size?: 'large' | 'echo' }
const { size = 'large' } = Astro.props;
const large = size === 'large';
---
{large ? (
  <svg class="rdr-svg rdr-large" viewBox="150 0 700 750" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="rdrOuterGrad" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="var(--r-midnight-ink)" />
        <stop offset="100%" stop-color="var(--r-navy)" />
      </linearGradient>
      <linearGradient id="rdrMidGrad" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="var(--r-navy)" />
        <stop offset="100%" stop-color="var(--r-blue)" />
      </linearGradient>
      <radialGradient id="rdrGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--r-ember)" stop-opacity=".85" />
        <stop offset="100%" stop-color="var(--r-ember)" stop-opacity="0" />
      </radialGradient>
    </defs>
    <path d={RIBBON_D} transform="translate(26 20)" fill="none" stroke="var(--r-wattle)" stroke-opacity=".5" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" class="rdr-wattle" data-r-motion />
    <path d={RIBBON_D} fill="none" stroke="url(#rdrOuterGrad)" stroke-width="46" stroke-linecap="round" stroke-linejoin="round" class="rdr-outer" data-r-motion />
    <path d={RIBBON_D} fill="none" stroke="url(#rdrMidGrad)" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" class="rdr-mid" data-r-motion />
    <path d={RIBBON_D} pathLength="1" transform="translate(-5 -4)" fill="none" stroke="var(--r-signal-blue)" stroke-width="11" stroke-linecap="round" stroke-linejoin="round" class="rdr-highlight" data-r-motion />
    <circle cx="574" cy="213.5" r="46" fill="url(#rdrGlow)" class="rdr-glow" data-r-motion />
  </svg>
) : (
  <svg class="rdr-svg rdr-echo" viewBox="420 150 280 230" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
    <!-- A direct crop of the identical curve (the window around its "head", (574,213.5), the
         same point the hero's Ember glow sits on), recoloured for the Paper ground: this is what
         makes it read as a continuation rather than an independently invented echo. -->
    <path d={RIBBON_D} fill="none" stroke="var(--r-signal-deep)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" class="rdr-echo-line" />
    <circle cx="574" cy="213.5" r="7" fill="var(--r-ember-deep)" />
  </svg>
)}
<style>
.rdr-svg{display:block;width:100%;height:100%}
.rdr-highlight{stroke-dasharray:1;stroke-dashoffset:1;animation:rdrDrawOn 2800ms var(--r-ease-out) forwards}
.rdr-outer,.rdr-mid,.rdr-wattle{opacity:0;animation:rdrFadeIn var(--r-motion-slow) var(--r-ease-out) forwards}
.rdr-mid{animation-delay:150ms}
.rdr-wattle{animation-delay:300ms}
.rdr-glow{opacity:0;animation:rdrFadeIn var(--r-motion-slow) var(--r-ease-out) 1300ms forwards}
@keyframes rdrDrawOn{0%{stroke-dashoffset:1}40%{stroke-dashoffset:0}100%{stroke-dashoffset:0}}
@keyframes rdrFadeIn{to{opacity:1}}
@media(prefers-reduced-motion:reduce){
  .rdr-highlight{animation:none;stroke-dashoffset:0}
  .rdr-outer,.rdr-mid,.rdr-wattle,.rdr-glow{animation:none;opacity:1}
}
</style>
