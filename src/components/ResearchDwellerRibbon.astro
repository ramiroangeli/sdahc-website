---
// Simplified Research Hub line motif (Stage 2 v2, Route 1B). This is a deliberate interim
// simplification pass, merged now with deeper art direction postponed to a later phase: simple
// flat SVG strokes, no gradients, no blur/glow filters, no multi-layer "tube" rendering. The
// graphic itself is unchanged from every prior version: the exact same approved Dweller Line
// curve, scaled and positioned the same way. Only the RENDERING technique is simplified.
//
// Both sizes share the exact same base curve, Stage 2 v2's approved Dweller Line
// (M51 106 C49.5 92 50 82 55.5 77.5 C61 73 74 70 87 57.5), uniformly scaled 9x and translated,
// then extended a short straight distance past each endpoint along that endpoint's own tangent
// so it runs off the panel edges rather than floating inside a small box. Nothing is redrawn,
// restretched or arbitrarily reshaped:
//   p1 (51,106)  -> (250,650)      p5 (61,73)   -> (340,353)
//   p2 (49.5,92) -> (236.5,524)    p6 (74,70)   -> (457,326)
//   p3 (50,82)   -> (241,434)      p7 (87,57.5) -> (574,213.5)
//   p4 (55.5,77.5) -> (290.5,393.5)
// extended start (continuing the p2->p1 tangent to y=750): (260.7,750)
// extended end   (continuing the p6->p7 tangent to y=0):   (796,0)
//
// `size="large"`: a flat Signal Blue main line plus one thinner Wattle companion line (the same
// curve, offset): "one main curved line and one thinner companion line".
// `size="echo"`: a direct crop of the identical curve around its head point (574,213.5),
// recoloured for the Paper ground, at the top of the Publications section, so the two read as
// one simple motif continuing through the page rather than two separate graphics.
const RIBBON_D = "M260.7 750 L250 650 C236.5 524 241 434 290.5 393.5 C340 353 457 326 574 213.5 L796 0";

interface Props { size?: 'large' | 'echo' }
const { size = 'large' } = Astro.props;
const large = size === 'large';
---
{large ? (
  <svg class="rdr-svg rdr-large" viewBox="150 0 700 750" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <path d={RIBBON_D} transform="translate(32 26)" fill="none" stroke="var(--r-wattle)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="rdr-companion" data-r-motion />
    <path d={RIBBON_D} pathLength="1" fill="none" stroke="var(--r-signal-blue)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" class="rdr-main" data-r-motion />
    <circle cx="574" cy="213.5" r="7" fill="var(--r-signal-blue)" class="rdr-dot" data-r-motion />
  </svg>
) : (
  <svg class="rdr-svg rdr-echo" viewBox="420 150 280 230" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
    <path d={RIBBON_D} fill="none" stroke="var(--r-signal-deep)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" class="rdr-echo-line" />
    <circle cx="574" cy="213.5" r="5" fill="var(--r-wattle-deep)" />
  </svg>
)}
<style>
.rdr-svg{display:block;width:100%;height:100%}
/* One-time draw-on for the main line; the companion line and dot fade in shortly after. All
   three skip straight to their finished, fully-visible state under reduced motion. */
.rdr-main{stroke-dasharray:1;stroke-dashoffset:1;animation:rdrDrawOn 1600ms var(--r-ease-out) forwards}
.rdr-companion,.rdr-dot{opacity:0;animation:rdrFadeIn var(--r-motion-base) var(--r-ease-out) 400ms forwards}
@keyframes rdrDrawOn{to{stroke-dashoffset:0}}
@keyframes rdrFadeIn{to{opacity:1}}
@media(prefers-reduced-motion:reduce){
  .rdr-main{animation:none;stroke-dashoffset:0}
  .rdr-companion,.rdr-dot{animation:none;opacity:1}
}
</style>
