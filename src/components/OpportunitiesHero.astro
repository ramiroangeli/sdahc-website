---
import HeroCardFan from './HeroCardFan.astro';
import type { PublicListing } from '../data/listings/schema';

/*
  /opportunities/ hero. A full-width statement title, a small supporting line attached to it, then two
  equally weighted paths beside a fan of property cards:
    A. Available properties: public listings, in the SDAHC blue. Goes to the catalogue.
    B. Off-market opportunities: confidential access, in the SDAHC orange. Goes to the existing NDA and
       registration steps. It never exposes anything confidential.
  The hero draws no background of its own: the page carries one continuous background (see opportunities.astro),
  so there is no seam between the hero and the sections below.
  It renders with or without published listings; with none, the fan shows locked off-market cards.
*/
interface Props { listings: PublicListing[]; lockedStates: string[] }
const { listings, lockedStates } = Astro.props;
---
<section class="oh" aria-labelledby="oh-h1">
  <div class="wrap oh-top">
    <h1 class="oh-h1" id="oh-h1"><span class="oh-l1">SDA Investment</span> <span class="oh-l2">Opportunities</span></h1>
    <p class="oh-sub">Explore available SDA properties and discover exclusive off-market investment opportunities</p>
  </div>

  <div class="wrap oh-grid">
    <div class="oh-paths">
      <div class="oh-path oh-path-a">
        <span class="oh-ico" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24"><path d="M3.5 11 12 4l8.5 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /><path d="M5.5 10v9.5h13V10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><path d="M10 19.5v-5h4v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
        </span>
        <div class="oh-path-body">
          <p class="oh-k">Listed publicly</p>
          <h2 class="oh-path-h">Available properties</h2>
          <p class="oh-path-d">Browse SDA properties we can show publicly, with location, status and photography.</p>
          <a class="btn oh-cta oh-cta-a" href="#listings">Explore Available Properties<svg class="oh-arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        </div>
      </div>

      <div class="oh-path oh-path-b">
        <span class="oh-ico oh-ico-lock" aria-hidden="true">
          <svg width="30" height="30" viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="9.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><circle cx="12" cy="15" r="1.3" fill="currentColor" /></svg>
        </span>
        <div class="oh-path-body">
          <p class="oh-k">Confidential access</p>
          <h2 class="oh-path-h">Off-market opportunities</h2>
          <p class="oh-path-d">Shared only with qualified buyers under NDA. No confidential detail is shown on this site.</p>
          <a class="btn oh-cta oh-cta-b" href="#access">Access Off-Market Opportunities<svg class="oh-arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        </div>
      </div>
    </div>

    <div class="oh-stage">
      <HeroCardFan listings={listings} lockedStates={lockedStates} />
    </div>
  </div>
</section>

<style>
.oh{position:relative;padding:calc(var(--nav-clearance) + 14px) 0 64px}

/* ===== statement title =====
   Barlow Condensed 700, capitals: the heaviest and most squared face already loaded by the site. It is sized
   from the width of its own container (cqw), so it runs the full width of the content area at every viewport
   rather than a fixed point size. --r1 is the measured width of the whole line in em; --ra and --rb the same for
   each line when it is stacked on narrow screens. */
.oh-top{container-type:inline-size;overflow-x:clip}
.oh-h1{--r1:12.34;font-family:var(--cond);font-weight:700;text-transform:uppercase;letter-spacing:.012em;color:var(--white);margin:0;line-height:.92;font-size:calc(100cqw / var(--r1));white-space:nowrap;animation:ohUp .8s cubic-bezier(.16,1,.3,1) both}
.oh-h1 span{display:inline}
/* the supporting line: small, close to the title and visually attached to it */
.oh-sub{font-family:var(--sans);font-size:clamp(13.5px,1.25vw,16px);line-height:1.45;letter-spacing:.015em;color:var(--pale);margin:12px 0 0;max-width:none;animation:ohUp .8s cubic-bezier(.16,1,.3,1) .1s both}

.oh-grid{position:relative;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:40px;align-items:center;width:100%;margin-top:34px}
.oh-stage{min-width:0}

.oh-paths{display:grid;gap:16px}
.oh-path{position:relative;display:flex;gap:18px;align-items:flex-start;padding:22px 22px 24px;border-radius:12px;border:1px solid transparent;animation:ohUp .8s cubic-bezier(.16,1,.3,1) both;transition:border-color .3s ease,box-shadow .3s ease}

/* A: the SDAHC blue. A clearly blue surface, solid blue icon and a bright blue rule */
.oh-path-a{animation-delay:.2s;background:linear-gradient(135deg,color-mix(in srgb,var(--blue) 34%,var(--navy)) 0%,color-mix(in srgb,var(--blue) 12%,var(--navy)) 100%);border-color:color-mix(in srgb,var(--blue) 75%,transparent);border-top:3px solid var(--blue);box-shadow:0 18px 40px color-mix(in srgb,var(--navy) 60%,transparent)}
/* B: the SDAHC orange. A clearly warm surface, solid orange icon and an orange rule */
.oh-path-b{animation-delay:.3s;background:linear-gradient(135deg,color-mix(in srgb,var(--amber) 24%,var(--navy)) 0%,color-mix(in srgb,var(--amber) 7%,var(--navy)) 100%);border-color:color-mix(in srgb,var(--amber) 70%,transparent);border-top:3px solid var(--amber);box-shadow:0 18px 40px color-mix(in srgb,var(--navy) 60%,transparent)}
.oh-path-a:hover{border-color:var(--blue);box-shadow:0 0 0 1px color-mix(in srgb,var(--blue) 60%,transparent),0 18px 44px color-mix(in srgb,var(--navy) 65%,transparent)}
.oh-path-b:hover{border-color:var(--amber);box-shadow:0 0 0 1px color-mix(in srgb,var(--amber) 60%,transparent),0 18px 44px color-mix(in srgb,var(--navy) 65%,transparent)}

.oh-ico{flex:0 0 auto;display:grid;place-items:center;width:54px;height:54px;border-radius:50%;color:var(--white);background:var(--blue)}
.oh-ico-lock{color:var(--navy);background:var(--amber)}
.oh-path-body{min-width:0}
/* the labels: larger and bolder than before, each in its own colour */
.oh-k{font-family:var(--geo);font-size:14px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;margin:2px 0 8px;color:color-mix(in srgb,var(--blue) 55%,var(--white))}
.oh-path-b .oh-k{color:color-mix(in srgb,var(--amber) 62%,var(--white))}
.oh-path-h{font-family:var(--serif);font-weight:600;color:var(--white);font-size:clamp(21px,2vw,26px);line-height:1.15;margin:0 0 8px}
.oh-path-d{font-family:var(--sans);color:color-mix(in srgb,var(--white) 82%,var(--pale));font-size:15px;line-height:1.55;margin:0 0 16px;max-width:42ch}

.oh-cta{display:inline-flex;align-items:center;gap:8px;font-weight:700}
.oh-cta-a{background:var(--blue);color:var(--white)}
.oh-cta-a:hover{background:color-mix(in srgb,var(--blue) 82%,var(--white))}
.oh-cta-b{background:var(--amber);color:var(--navy)}
.oh-cta-b:hover{background:color-mix(in srgb,var(--amber) 82%,var(--white))}
/* the whole tile is the tap target: the button link stretches over the tile */
.oh-cta::after{content:"";position:absolute;inset:0;border-radius:12px}
.oh-cta:focus-visible{outline:none}
.oh-cta:focus-visible::after{outline:3px solid var(--white);outline-offset:3px}
.oh-arrow{flex:0 0 auto}

@keyframes ohUp{from{opacity:0;transform:translateY(18px)}}

/* tablet and mobile: the hero grid becomes a single column */
@media(max-width:899px){
  .oh{padding-bottom:44px}
  .oh-grid{grid-template-columns:1fr;gap:30px;margin-top:28px}
  .oh-path{padding:18px;gap:14px}
  .oh-ico{width:46px;height:46px}
  .oh-path-d{margin-bottom:14px}
}
/* small screens: the title stacks on two lines and each line fills the width, so it stays large and never breaks mid-word */
@media(max-width:699px){
  .oh-h1{--ra:6.32;--rb:5.8;font-size:inherit;line-height:.94;white-space:normal}
  .oh-h1 span{display:block;white-space:nowrap}
  .oh-l1{font-size:calc(100cqw / var(--ra))}
  .oh-l2{font-size:calc(100cqw / var(--rb))}
  .oh-sub{margin-top:14px}
}
@media(max-width:520px){
  .oh-path{flex-direction:column;gap:12px}
  .oh-cta{width:100%;justify-content:center;text-align:center}
}
@media(prefers-reduced-motion:reduce){
  .oh-h1,.oh-sub,.oh-path{animation:none}
  .oh-path{transition:none}
}
</style>
