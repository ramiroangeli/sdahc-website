---
import { Image } from 'astro:assets';
import logoIcon from '../assets/logo-icon-white.png';
---
<header>
  <nav class="nav">
    <a class="mark" href="/" aria-label="SDA Home Choices home">
      <Image src={logoIcon} alt="SDA Home Choices" class="mkicon" loading="eager" /><span class="wordmark">SDA&nbsp;Home&nbsp;Choices</span>
    </a>
    <div class="nls">
      <a class="l" href="/our-services-and-expertise/">Services</a>
      <div class="nav-dd" data-dd>
        <button type="button" class="l dd-btn" aria-expanded="false" aria-controls="dd-listings" aria-haspopup="true">Listings<span class="dd-chev" aria-hidden="true"></span></button>
        <ul class="dd-menu" id="dd-listings">
          <li><a href="/opportunities/">Public Listings</a></li>
          <li><a href="/opportunities/off-market/">Off-market Listings</a></li>
        </ul>
      </div>
      <a class="l" href="/about/">About</a>
      <a class="l" href="/contact-us/">Contact</a>
    </div>
    <div class="nav-right">
      <a class="nav-cta" href="/research/">Research</a>
      <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
  <div class="mobile-menu" id="mobile-menu">
    <a href="/our-services-and-expertise/">Services</a>
    <p class="mm-group" id="mm-listings">Listings</p>
    <a class="mm-sub" href="/opportunities/" aria-describedby="mm-listings">Public Listings</a>
    <a class="mm-sub" href="/opportunities/off-market/" aria-describedby="mm-listings">Off-market Listings</a>
    <a href="/about/">About</a>
    <a href="/contact-us/">Contact</a>
  </div>
</header>
<style>
header{position:fixed;top:var(--nav-top);left:24px;right:24px;max-width:1180px;margin-inline:auto;z-index:var(--z-nav)}
.nav{position:relative;display:flex;align-items:center;gap:26px;height:var(--nav-height);margin:0 auto;padding:0 30px;background:linear-gradient(180deg,color-mix(in srgb,var(--navy2) 30%,var(--navy)) 0%,var(--navy) 100%);backdrop-filter:blur(12px);border:1px solid color-mix(in srgb,var(--pale) 18%,transparent);border-radius:var(--nav-radius);box-shadow:0 10px 22px color-mix(in srgb,var(--navy) 45%,transparent)}
.mark{display:inline-flex;align-items:center;font-family:var(--geo);font-weight:600;letter-spacing:.30em;font-size:14px;text-transform:uppercase;color:var(--white);margin-right:auto;text-decoration:none}
.mark .mkicon{height:26px;width:auto;margin-right:12px}
.nls{display:flex;gap:22px;align-items:center}
.nav a.l{font-family:var(--geo);font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--pale);text-decoration:none}
.nav a.l:hover,.nav .dd-btn:hover{color:var(--white)}
/* Listings dropdown. Without JavaScript it opens on hover and while focus is inside it (CSS only); with JavaScript (data-js) the script also opens it on click and closes it on Escape, outside click or when focus leaves. */
.nav-dd{position:relative}
.dd-btn{display:inline-flex;align-items:center;gap:7px;background:transparent;border:0;padding:6px 0;cursor:pointer;font-family:var(--geo);font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--pale)}
.dd-chev{width:6px;height:6px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg) translateY(-2px);transition:transform .15s ease}
.nav-dd.is-open .dd-chev{transform:rotate(-135deg) translateY(-1px)}
.dd-menu{display:none;position:absolute;top:100%;left:-18px;min-width:232px;margin:0;padding:14px 0 0;list-style:none;z-index:2}
.dd-menu::before{content:"";position:absolute;inset:10px 0 0 0;background:var(--navy);border:1px solid color-mix(in srgb,var(--pale) 22%,transparent);border-radius:10px;box-shadow:0 18px 40px color-mix(in srgb,#000 45%,transparent)}
.dd-menu li{position:relative}
.dd-menu li:first-child{margin-top:8px}
.dd-menu li:last-child{margin-bottom:8px}
.nav .dd-menu a{display:block;padding:11px 20px;font-family:var(--geo);font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--pale);text-decoration:none}
.nav .dd-menu a:hover,.nav .dd-menu a:focus-visible{color:var(--white);background:color-mix(in srgb,var(--white) 7%,transparent)}
.nav-dd:not([data-js]):hover .dd-menu,.nav-dd:not([data-js]):focus-within .dd-menu,.nav-dd.is-open .dd-menu{display:block}
.dd-btn:focus-visible{outline:2px solid var(--pale);outline-offset:4px}
.nav-right{display:flex;align-items:center;gap:14px}
.nav-cta{font-family:var(--geo);font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--white);background:var(--blue);padding:9px 15px;border-radius:999px;text-decoration:none;white-space:nowrap;transition:background .2s}
.nav-cta:hover{background:color-mix(in srgb,var(--blue) 82%,#000)}
header a:focus-visible,.menu-toggle:focus-visible{outline:2px solid var(--pale);outline-offset:4px}
.nav-cta:focus-visible{outline-offset:3px;border-radius:999px}
/* hamburger: hidden on desktop */
.menu-toggle{display:none;flex-direction:column;justify-content:center;gap:5px;width:40px;height:40px;padding:0;background:transparent;border:0;cursor:pointer}
.menu-toggle span{display:block;width:22px;height:2px;background:var(--white);transition:transform .25s,opacity .25s}
.menu-toggle.is-open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.menu-toggle.is-open span:nth-child(2){opacity:0}
.menu-toggle.is-open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
/* mobile dropdown panel: hidden until opened, and always hidden on desktop */
.mobile-menu{display:none;position:absolute;top:calc(100% + 10px);left:0;right:0;flex-direction:column;max-height:calc(100dvh - var(--nav-clearance) - env(safe-area-inset-bottom,0px));overflow-y:auto;overscroll-behavior:contain;background:var(--navy);border:1px solid color-mix(in srgb,var(--pale) 18%,transparent);border-radius:24px;box-shadow:0 10px 30px color-mix(in srgb,var(--navy) 35%,transparent);padding:8px 24px 16px}
.mobile-menu.open{display:flex}
.mobile-menu a{font-family:var(--geo);font-size:14px;letter-spacing:.12em;text-transform:uppercase;color:var(--pale);text-decoration:none;padding:14px 0;border-top:1px solid color-mix(in srgb,var(--pale) 10%,transparent)}
.mobile-menu a:hover{color:var(--white)}
/* the two listing pages sit under a "Listings" label in the phone menu, always visible (no nested toggle) */
.mm-group{margin:0;padding:14px 0 6px;border-top:1px solid color-mix(in srgb,var(--pale) 10%,transparent);font-family:var(--geo);font-size:14px;letter-spacing:.12em;text-transform:uppercase;color:var(--white)}
.mobile-menu a.mm-sub{padding:12px 0 12px 18px;border-top:0;font-size:13px}
@media(max-width:980px){
  header{left:10px;right:10px}
  .nav{gap:16px;padding:0 16px}
  .nls{display:none}
  .menu-toggle{display:inline-flex}
  .mark .wordmark{display:none}
  .mark .mkicon{margin-right:0}
}
@media(min-width:981px){
  .mobile-menu{display:none !important}
}
@media(prefers-reduced-motion:reduce){.menu-toggle span,.dd-chev{transition:none}}
</style>
<!-- CSP note: this inline script is allow-listed in vercel.json by exact sha256 hash. Editing it requires recomputing and updating that hash, or the CSP will silently block it. -->
<script>
  const toggle = document.querySelector('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      toggle.classList.toggle('is-open', open);
      menu.classList.toggle('open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  }
  // Listings dropdown (desktop): click, hover, keyboard. Escape closes it and returns focus to the button.
  const dd = document.querySelector('[data-dd]');
  const ddBtn = dd && dd.querySelector('.dd-btn');
  if (dd && ddBtn) {
    dd.setAttribute('data-js', '');
    const links = [...dd.querySelectorAll('.dd-menu a')];
    const setDd = (open) => { dd.classList.toggle('is-open', open); ddBtn.setAttribute('aria-expanded', String(open)); };
    ddBtn.addEventListener('click', () => setDd(!dd.classList.contains('is-open')));
    dd.addEventListener('mouseenter', () => setDd(true));
    dd.addEventListener('mouseleave', () => setDd(false));
    dd.addEventListener('focusout', (e) => { if (!dd.contains(e.relatedTarget)) setDd(false); });
    ddBtn.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown') { e.preventDefault(); setDd(true); links[0].focus(); } });
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dd.classList.contains('is-open')) { setDd(false); ddBtn.focus(); }
      if (e.key === 'ArrowDown' && links.includes(document.activeElement)) { e.preventDefault(); links[(links.indexOf(document.activeElement) + 1) % links.length].focus(); }
      if (e.key === 'ArrowUp' && links.includes(document.activeElement)) { e.preventDefault(); links[(links.indexOf(document.activeElement) - 1 + links.length) % links.length].focus(); }
    });
    document.addEventListener('click', (e) => { if (!dd.contains(e.target)) setDd(false); });
  }
</script>
