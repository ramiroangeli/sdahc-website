---
// "Our team": one paper section with a card per person, in a slow right-to-left carousel (src/scripts/team-carousel.ts). The texts live in
// src/content/team.json. Each card has a photo (or a monogram), a coloured label, name, role, a three-line bio and a "Read more" button that opens
// an accessible <dialog> with the large photo and the full bio. Every bio is in the server-rendered HTML.
// Photos: node scripts/prepare-team-photo.mjs <image> <slug> writes /images/team/<slug>.{avif,webp,jpg}; put the slug in "photo".
interface Member { name: string; role: string; label: string; color: 'blue' | 'violet' | 'teal'; photo: string; bio: string; bioFull?: string[] }
interface Props { team: { heading: string; members: Member[] } }
const { team } = Astro.props;
const initials = (name: string) => name.split(/\s+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const full = (m: Member) => m.bioFull ?? [m.bio];
---
<section class="team" aria-labelledby="team-h" data-team>
  <div class="wrap team-head">
    <h2 class="team-h" id="team-h">{team.heading}</h2>
    <button type="button" class="team-pause" data-team-pause aria-label="Pause the team carousel">Pause</button>
  </div>

  <div class="team-viewport" data-team-viewport>
    <ul class="team-track" data-team-track>
      {team.members.map((m, i) => (
        <li class="team-card" data-card={i}>
          <div class="team-media">
            {m.photo ? (
              <picture>
                <source type="image/avif" srcset={`/images/team/${m.photo}.avif`} />
                <source type="image/webp" srcset={`/images/team/${m.photo}.webp`} />
                <img src={`/images/team/${m.photo}.jpg`} alt={`${m.name}, ${m.role}`} width="800" height="800" loading="lazy" decoding="async" />
              </picture>
            ) : (
              <span class="monogram" aria-hidden="true">{initials(m.name)}</span>
            )}
          </div>
          <div class="team-body">
            <p class="pill" data-color={m.color}>{m.label}</p>
            <h3 class="team-name">{m.name}</h3>
            <p class="team-role">{m.role}</p>
            <p class="team-bio">{m.bio}</p>
            <button type="button" class="read-more" data-open={i} aria-haspopup="dialog">Read more<span class="sr"> about {m.name}</span></button>
          </div>
        </li>
      ))}
    </ul>
  </div>

  {team.members.map((m, i) => (
    <dialog class="team-dialog" data-dialog={i} aria-labelledby={`team-dn-${i}`}>
      <div class="dlg-inner">
        <form method="dialog"><button class="dlg-close" aria-label={`Close, ${m.name}`}>Close</button></form>
        <div class="dlg-media">
          {m.photo ? (
            <picture>
              <source type="image/avif" srcset={`/images/team/${m.photo}.avif`} />
              <source type="image/webp" srcset={`/images/team/${m.photo}.webp`} />
              <img src={`/images/team/${m.photo}.jpg`} alt={`${m.name}, ${m.role}`} width="800" height="800" loading="lazy" decoding="async" />
            </picture>
          ) : (
            <span class="monogram" aria-hidden="true">{initials(m.name)}</span>
          )}
        </div>
        <div class="dlg-text">
          <p class="pill" data-color={m.color}>{m.label}</p>
          <h3 class="team-name" id={`team-dn-${i}`}>{m.name}</h3>
          <p class="team-role">{m.role}</p>
          {full(m).map((para) => <p class="dlg-bio">{para}</p>)}
        </div>
      </div>
    </dialog>
  ))}
</section>

<script>
  // loaded as its own file (a small inline script would need a hash in the CSP)
  const root = document.querySelector<HTMLElement>('[data-team]');
  if (root) void import('../scripts/team-carousel').then((m) => m.initTeam(root));
</script>

<style>
.team{background:var(--paper);padding:72px 0 88px;overflow:hidden}
.team-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:12px}
.team-h{font-family:var(--serif);font-weight:600;color:var(--navy);font-size:clamp(24px,3.2vw,34px);line-height:1.15;margin:0}
.team-pause{font-family:var(--geo);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);background:var(--white);border:1px solid color-mix(in srgb,var(--navy) 28%,transparent);border-radius:999px;padding:9px 18px;cursor:pointer}
.team-pause:hover{border-color:var(--blue-mid)}
.team-pause:focus-visible,.read-more:focus-visible,.dlg-close:focus-visible{outline:2px solid var(--blue-mid);outline-offset:3px}

/* the carousel: a full-width viewport; the track is moved by the script. Room above and below for the hover lift and the shadows. */
.team-viewport{overflow:hidden;padding:32px 0 48px;-webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)}
.team-track{display:flex;align-items:stretch;list-style:none;margin:0;padding:0;width:max-content;will-change:transform}
.team-card{flex:0 0 auto;width:380px;margin-right:24px;display:flex;flex-direction:column;background:var(--white);border:1px solid transparent;border-radius:24px;overflow:hidden;box-shadow:0 10px 30px color-mix(in srgb,var(--navy) 10%,transparent);transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}
@media(max-width:700px){.team-card{width:300px}}
.team-card:hover,.team-card:focus-within,.team-card:global(.hov){transform:translateY(-6px) scale(1.02);border-color:var(--blue-mid);box-shadow:0 22px 48px color-mix(in srgb,var(--navy) 22%,transparent)}
.team-media{position:relative;aspect-ratio:1/1;background:color-mix(in srgb,var(--navy) 6%,var(--white));display:flex;align-items:center;justify-content:center}
.team-media img,.dlg-media img{display:block;width:100%;height:100%;object-fit:cover;object-position:top center;filter:saturate(.85);transition:filter .3s ease}
.team-card:hover .team-media img,.team-card:focus-within .team-media img,.team-card:global(.hov) .team-media img,.dlg-media img:hover{filter:saturate(1)}
.monogram{display:flex;align-items:center;justify-content:center;width:42%;aspect-ratio:1/1;border-radius:50%;background:var(--navy);border:2px solid var(--blue-mid);color:var(--paper);font-family:var(--cond);font-weight:700;font-size:clamp(34px,5vw,56px);letter-spacing:.04em}
.team-body{display:flex;flex-direction:column;align-items:flex-start;flex:1;padding:22px 24px 26px}
.pill{--c:var(--blue);--ink:var(--label-blue-ink);display:inline-block;margin:0 0 12px;padding:6px 12px;border-radius:999px;background:color-mix(in srgb,var(--c) 10%,var(--white));color:var(--ink);font-family:var(--geo);font-weight:600;font-size:12px;letter-spacing:.1em;line-height:1.2;text-transform:uppercase}
.pill[data-color="violet"]{--c:var(--brain-violet);--ink:var(--label-violet-ink)}
.pill[data-color="teal"]{--c:var(--teal);--ink:var(--label-teal-ink)}
.team-name{font-family:'Playfair Display',var(--serif);font-weight:700;font-size:26px;line-height:1.15;color:var(--navy);margin:0 0 4px}
.team-role{font-family:'Source Sans 3',var(--sans);font-weight:600;font-size:16px;color:var(--slate);margin:0 0 12px}
.team-bio{font-family:var(--sans);font-size:16px;line-height:1.6;color:var(--slate);margin:0 0 16px;display:-webkit-box;-webkit-line-clamp:3;line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.read-more{margin-top:auto;font-family:var(--sans);font-weight:600;font-size:15px;color:var(--navy);background:none;border:0;border-bottom:2px solid var(--blue-mid);padding:2px 0;cursor:pointer}
.read-more:hover{color:var(--navy2)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* no animation (reduced motion, or no script): three cards in a row on a wide screen, a snapping horizontal scroll otherwise */
@media(prefers-reduced-motion:reduce){
  .team-pause{display:none}
  .team-viewport{-webkit-mask-image:none;mask-image:none}
  .team-track{width:auto;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 30px 8px;-webkit-overflow-scrolling:touch}
  .team-card{scroll-snap-align:center}
  .team-card:last-child{margin-right:0}
  .team-card,.team-media img{transition:none}
}
@media(prefers-reduced-motion:reduce) and (min-width:1240px){.team-track{overflow:visible;justify-content:center;padding:0}}
@media(scripting:none){
  .team-pause{display:none}
  .team-viewport{-webkit-mask-image:none;mask-image:none}
  .team-track{width:auto;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 30px 8px}
  .team-card{scroll-snap-align:center}
}
@media(scripting:none) and (min-width:1240px){.team-track{overflow:visible;justify-content:center;padding:0}}

/* the dialog */
.team-dialog{width:min(820px,calc(100vw - 32px));max-height:calc(100vh - 32px);padding:0;border:0;border-radius:24px;background:var(--white);color:var(--slate);box-shadow:0 30px 80px rgba(0,10,25,.45);overflow:auto}
.team-dialog::backdrop{background:rgba(0,22,43,.62)}
.dlg-inner{position:relative;display:grid;grid-template-columns:minmax(0,320px) 1fr;gap:32px;padding:32px}
@media(max-width:700px){.dlg-inner{grid-template-columns:1fr;gap:20px;padding:24px}}
.dlg-inner>form{display:contents}
.dlg-media{aspect-ratio:1/1;border-radius:16px;overflow:hidden;background:color-mix(in srgb,var(--navy) 6%,var(--white));display:flex;align-items:center;justify-content:center}
.dlg-text .team-name{font-size:30px}
.dlg-bio{font-family:var(--sans);font-size:17px;line-height:1.65;color:var(--slate);margin:0 0 14px}
.dlg-close{position:absolute;top:14px;right:14px;z-index:1;font-family:var(--geo);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);background:var(--white);border:1px solid color-mix(in srgb,var(--navy) 28%,transparent);border-radius:999px;padding:8px 16px;cursor:pointer}
.dlg-close:hover{border-color:var(--blue-mid)}
</style>
