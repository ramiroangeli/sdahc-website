---
// Simple link card for existing, already-indexed Research HTML pages (statistics, snapshot,
// executive summary, methodology). The whole card is one semantic <a>, so it stays a single
// crawlable, keyboard-accessible link rather than a div with a nested link.
// Scoped under .rrc- so the upcoming Design System can restyle these independently.
interface Props { href: string; title: string; description: string }
const { href, title, description } = Astro.props;
---
<a class="rrc-card" href={href}>
  <h3 class="rrc-title">{title}</h3>
  <p class="rrc-desc">{description}</p>
  <span class="rrc-link" aria-hidden="true">&rarr;</span>
</a>
<style>
.rrc-card{display:block;background:rgba(255,255,255,.03);border:1px solid rgba(185,203,224,.16);border-radius:8px;padding:26px;text-decoration:none;transition:border-color .25s,background .25s}
.rrc-card:hover{border-color:var(--blue);background:rgba(4,118,217,.07)}
.rrc-card:focus-visible{outline:2px solid var(--blue);outline-offset:4px}
.rrc-title{font-family:var(--serif);font-weight:600;color:#fff;font-size:18px;margin:0 0 8px}
.rrc-desc{color:var(--pale);font-size:14.5px;line-height:1.5;margin:0 24px 0 0}
.rrc-link{display:block;margin-top:14px;font-family:var(--geo);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--blue)}
.rrc-card:hover .rrc-link{text-decoration:underline;text-underline-offset:3px}
</style>
