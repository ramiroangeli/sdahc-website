---
// Large, purely presentational floating report cover for a dedicated landing page's hero.
// ReportGate (src/components/ReportGate.astro) freezes its own cover's float animation once a
// report is selected (`.cover-img{animation:none}` in its selected state): correct there, since
// attention should move to the form, but it means a single-report landing page using ReportGate
// alone (which now auto-opens its form on load, see ReportGate's single-report behaviour) would
// never show the continuous floating motion at all. This component exists only to keep that
// motion visible, as the hero's primary visual object, above the ReportGate form section.
//
// Deliberately no click handler and no form: selection/registration stays ReportGate's job.
// Deliberately no background box behind the cover (unlike the small ResearchPublicationCard
// thumbnails on the hub): a boxed background flattens the depth this treatment is meant to keep.
//
// Reuses the exact float keyframes, rotation and drop-shadow values from ReportGate's own
// .cover-img so a report's cover looks identical whether shown there or here.
//
// The cover is itself a link to the page's registration section (href, default "#access": the
// id every ReportGate instance on these landing pages is given). Its accessible name reuses the
// registry's own ariaLabel field rather than inventing new copy, since that field already
// distinguishes "download form" from "registration form" per report. The <img> keeps its own alt
// text unchanged; the link's aria-label takes precedence for this link's accessible name, which
// is the standard pattern for a linked image whose destination needs more context than the bare
// image description.
//
// `caption` is an opt-in addition (used only by the Research Hub's publication showcase): when
// true, the title/status/CTA label render inside this SAME <a> rather than as separate markup,
// so the cover, title and CTA stay one accessible link, not nested interactive elements. The
// three individual report landing pages all omit it, so their own usage (image only, no caption,
// href="#access") is completely unchanged.
// `caption` styling borrows the Design System's own published/coming-soon colour pairing and
// fonts from ResearchPublicationCard's `rp-card-ds` treatment (Signal Deep / Wattle Deep on
// Warm Paper), since the Hub showcase that uses `caption` sits on the same Paper ground. This
// file already shares its 4 call sites (3 landing pages + the Hub) with ResearchPublicationCard,
// which already imports research-tokens.css unconditionally on all 4, so this import adds no new
// page-scope exposure.
import '../styles/research-tokens.css';
import { REPORTS } from '../data/research-reports';

interface Props { id: string; href?: string; caption?: boolean }
const { id, href = '#access', caption = false } = Astro.props;
const report = REPORTS[id];
if (!report) throw new Error(`ResearchFloatingCover: unknown report id "${id}"`);

const variants: Record<string, 'A' | 'B' | 'C'> = { sda2026: 'A', special: 'B', providers: 'C' };
const variant = variants[id] ?? 'A';
const statusLabel = report.status === 'published' ? 'Published' : 'In development';
const ctaLabel = report.mode === 'preregistration' ? 'Register your interest' : 'Explore report';
---
<a class={`rfc rfc-${variant} ${caption ? 'rfc-captioned' : ''}`} href={href} aria-label={caption ? undefined : report.ariaLabel}>
  <picture>
    <source srcset={report.cover.webp} type="image/webp" />
    <img
      src={report.cover.png}
      alt={report.cover.alt}
      width={report.cover.width}
      height={report.cover.height}
      fetchpriority="high"
    />
  </picture>
  {caption && (
    <span class="rfc-caption">
      <span class="rfc-meta"><span class={`rfc-status rfc-status-${report.status}`}>{statusLabel}</span></span>
      <span class="rfc-title">{report.title}</span>
      <span class="rfc-cta">{ctaLabel} <span aria-hidden="true">&rarr;</span></span>
    </span>
  )}
</a>
<style>
.rfc{display:flex;justify-content:center;text-decoration:none}
.rfc img{width:100%;max-width:320px;height:auto;filter:drop-shadow(0 26px 50px rgba(0,10,25,.55))}
.rfc:focus-visible{outline:2px solid var(--blue);outline-offset:8px;border-radius:4px}

.rfc-captioned{flex-direction:column;align-items:center;text-align:center}
.rfc-captioned:focus-visible{outline-color:var(--r-signal-deep)}
.rfc-caption{margin-top:26px;display:flex;flex-direction:column;align-items:center;gap:9px;max-width:24ch}
.rfc-meta{display:flex}
.rfc-status{font-family:var(--r-font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:3px 10px;border-radius:999px}
.rfc-status-published{color:var(--r-signal-deep);background:var(--r-signal-tint)}
.rfc-status-coming-soon{color:var(--r-wattle-deep);background:var(--r-wattle-tint)}
.rfc-title{font-family:var(--r-font-display);font-weight:700;font-stretch:90%;color:var(--r-midnight-ink);font-size:17px;line-height:1.25;margin:0}
.rfc-cta{font-family:var(--r-font-mono);font-size:12.5px;font-weight:600;letter-spacing:.04em;color:var(--r-signal-deep)}
@media(hover:hover) and (prefers-reduced-motion:no-preference){
  .rfc-captioned:hover .rfc-cta{text-decoration:underline;text-underline-offset:3px}
}
.rfc-captioned:focus-visible .rfc-cta{text-decoration:underline;text-underline-offset:3px}

.rfc-A img{animation:rfcFloatA 6s ease-in-out infinite;transform:rotate(-3deg)}
.rfc-B img{animation:rfcFloatB 7s ease-in-out infinite;animation-delay:.35s;transform:rotate(0deg)}
.rfc-C img{animation:rfcFloatC 6.5s ease-in-out infinite;animation-delay:.7s;transform:rotate(3deg)}
@keyframes rfcFloatA{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-16px) rotate(-3deg)}}
@keyframes rfcFloatB{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-12px) rotate(0deg)}}
@keyframes rfcFloatC{0%,100%{transform:translateY(0) rotate(3deg)}50%{transform:translateY(-16px) rotate(3deg)}}

@media(prefers-reduced-motion:no-preference){
  .rfc img{transition:scale .25s ease,filter .25s ease}
  .rfc:focus-visible img{scale:1.04;filter:drop-shadow(0 30px 56px rgba(var(--blue-rgb),.35))}
}
@media(hover:hover) and (prefers-reduced-motion:no-preference){
  .rfc:hover img{scale:1.04;filter:drop-shadow(0 30px 56px rgba(var(--blue-rgb),.35))}
}
@media(prefers-reduced-motion:reduce){
  .rfc-A img,.rfc-B img,.rfc-C img{animation:none}
}
@media(max-width:860px){
  .rfc img{max-width:240px}
}
</style>
