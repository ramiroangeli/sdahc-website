---
import ListingImage from './ListingImage.astro';
import type { PublicListing } from '../data/listings/schema';
import { galleryPlan, isFloorplan } from '../data/listings/detail';
import { isDemoPhoto } from '../data/listings/schema';

/*
  Listing gallery: one prominent main photograph, uniform thumbnails and an accessible full-screen viewer.
  - Photographs keep their approved order (cover first, floorplans last). The main photograph is the first one that is not a floorplan.
  - Every container has a fixed shape and photographs are cropped (never stretched). A floorplan is always shown whole (contained, on a neutral
    ground) and is labelled "Floorplan"; the viewer shows every image whole.
  - Without JavaScript each thumbnail is a plain link to the full-size image. With it, the links open a native <dialog> viewer: Escape closes, the
    arrow keys and buttons move between images, focus is trapped while open and returned to the thumbnail that opened it.
  - Thumbnails carry no alt text of their own (the link's label gives the description once); the approved description is the alt text of the main
    image and of the viewer's image.
  The photograph files, their order, their approval and their privacy handling are unchanged.
*/
interface Props { photos: PublicListing['photos']; title: string }
const { photos, title } = Astro.props;
const plan = galleryPlan(photos);
const total = photos.length;
const MAX_THUMBS = 6;
const shownThumbs = plan.thumbIndexes.slice(0, MAX_THUMBS);
const hidden = plan.thumbIndexes.length - shownThumbs.length;
const altOf = (i: number) => photos[i].alt;
const label = (i: number) => `${isFloorplan(photos[i]) ? 'Floorplan' : `Photo ${i + 1} of ${total}`}: ${altOf(i)}`;
const href = (i: number) => {
  const p = photos[i];
  if (isDemoPhoto(p)) return '#';
  const v = [...p.variants].sort((a, b) => b.w - a.w)[0];
  return v ? v.src : '#';
};
// side layout (main plus a 2 x 3 block of thumbnails) needs enough thumbnails to fill it; fewer thumbnails go in a row under the main photograph
const layout = shownThumbs.length >= 4 ? 'side' : shownThumbs.length > 0 ? 'row' : 'solo';
---
<section class={`gx gx--${layout}`} data-gx aria-label={`Photographs of ${title}`}>
  {total > 0 ? (
    <>
      <div class="gx-stage">
        {plan.mainIndex >= 0 ? (
          <a class="gx-main" href={href(plan.mainIndex)} data-gx-open={plan.mainIndex} aria-label={`Open photograph ${plan.mainIndex + 1} of ${total} in the viewer`}>
            <ListingImage photo={photos[plan.mainIndex]} sizes="(min-width: 900px) 760px, 100vw" loading="eager" />
            <span class="gx-count" aria-hidden="true">{total} {total === 1 ? 'photograph' : 'photographs'}</span>
          </a>
        ) : (
          <a class="gx-main gx-main--plan" href={href(plan.floorplanIndex)} data-gx-open={plan.floorplanIndex} aria-label="Open the floorplan in the viewer">
            <ListingImage photo={photos[plan.floorplanIndex]} whole sizes="(min-width: 900px) 760px, 100vw" loading="eager" />
            <span class="gx-tag">Floorplan</span>
          </a>
        )}
        {shownThumbs.length > 0 && (
          <ul class="gx-thumbs">
            {shownThumbs.map((i, n) => (
              <li class="gx-th">
                <a class="gx-thlink" href={href(i)} data-gx-open={i} aria-label={`Open ${label(i)}`}>
                  <ListingImage photo={photos[i]} whole={isFloorplan(photos[i])} alt="" sizes="(min-width: 900px) 190px, 30vw" />
                  {isFloorplan(photos[i]) && <span class="gx-tag">Floorplan</span>}
                  {hidden > 0 && n === shownThumbs.length - 1 && <span class="gx-more" aria-hidden="true">+{hidden}</span>}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      {plan.floorplanIndex >= 0 && !shownThumbs.includes(plan.floorplanIndex) && plan.floorplanIndex !== plan.mainIndex && (
        <p class="gx-plan"><a href={href(plan.floorplanIndex)} data-gx-open={plan.floorplanIndex}>View the floorplan</a></p>
      )}

      <dialog class="gx-dlg" data-gx-dlg aria-label={`Photograph viewer for ${title}`}>
        <div class="gx-bar">
          <p class="gx-pos" role="status" aria-live="polite" data-gx-pos></p>
          <button type="button" class="gx-x" data-gx-close aria-label="Close the viewer">Close</button>
        </div>
        <div class="gx-view">
          <button type="button" class="gx-nav gx-prev" data-gx-prev aria-label="Previous photograph">&larr;</button>
          <ul class="gx-slides">
            {photos.map((p, i) => (
              <li class="gx-slide" data-gx-slide={i} hidden>
                <figure class="gx-fig">
                  <div class="gx-big"><ListingImage photo={p} whole largest mask={false} demoTag={false} sizes="(min-width: 1000px) 1000px, 96vw" /></div>
                  <figcaption class="gx-cap">{isFloorplan(p) ? 'Floorplan. ' : ''}{p.alt}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
          <button type="button" class="gx-nav gx-next" data-gx-next aria-label="Next photograph">&rarr;</button>
        </div>
      </dialog>
    </>
  ) : (
    <div class="gx-empty">
      <svg width="34" height="34" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4z" fill="none" stroke="currentColor" stroke-width="1.3" /><circle cx="9" cy="10" r="1.4" fill="currentColor" /><path d="M4 16l5-5 4 4 3-3 4 4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
      <p>Approved photography will appear here.</p>
      <p class="gx-empty-sub">Ask us for images in your enquiry.</p>
    </div>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-gx]').forEach((root) => {
    const dlg = root.querySelector<HTMLDialogElement>('[data-gx-dlg]');
    if (!dlg || typeof dlg.showModal !== 'function') return;
    const slides = [...dlg.querySelectorAll<HTMLElement>('[data-gx-slide]')];
    const pos = dlg.querySelector<HTMLElement>('[data-gx-pos]')!;
    let at = 0;
    let opener: HTMLElement | null = null;
    // images inside the closed viewer are lazy: load the one being shown and its neighbours as soon as they are needed
    const wake = (n: number) => slides[(n + slides.length) % slides.length]?.querySelectorAll('img').forEach((im) => { im.loading = 'eager'; });
    const show = (i: number) => {
      at = (i + slides.length) % slides.length;
      slides.forEach((s, n) => { s.hidden = n !== at; });
      pos.textContent = `${at + 1} of ${slides.length}`;
      wake(at); wake(at + 1); wake(at - 1);
    };
    const open = (i: number, from: HTMLElement) => { opener = from; show(i); dlg.showModal(); };
    root.querySelectorAll<HTMLAnchorElement>('[data-gx-open]').forEach((a) => {
      a.addEventListener('click', (e) => { e.preventDefault(); open(Number(a.dataset.gxOpen), a); });
    });
    dlg.querySelector('[data-gx-prev]')?.addEventListener('click', () => show(at - 1));
    dlg.querySelector('[data-gx-next]')?.addEventListener('click', () => show(at + 1));
    dlg.querySelector('[data-gx-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(at - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(at + 1); }
    });
    // a click on the dark surround (not on the image or a control) closes it
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => { opener?.focus(); opener = null; });
  });
</script>

<style>
.gx{position:relative}
.gx-stage{display:grid;gap:10px}
.gx a{color:inherit;text-decoration:none}
.gx-main{position:relative;display:block;overflow:hidden;border-radius:10px;border:1px solid color-mix(in srgb,var(--pale) 18%,transparent);aspect-ratio:3/2;background:color-mix(in srgb,var(--navy2) 60%,var(--navy))}
.gx-main:focus-visible,.gx-thlink:focus-visible{outline:2px solid var(--white);outline-offset:3px}
.gx-count{position:absolute;right:12px;bottom:12px;z-index:3;font-family:var(--geo);font-size:12px;font-weight:600;letter-spacing:.08em;color:var(--white);background:color-mix(in srgb,var(--navy) 78%,transparent);border:1px solid color-mix(in srgb,var(--pale) 35%,transparent);border-radius:999px;padding:6px 12px}
.gx-thumbs{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.gx-th{margin:0;padding:0}
.gx-thlink{position:relative;display:block;overflow:hidden;border-radius:8px;border:1px solid color-mix(in srgb,var(--pale) 18%,transparent);aspect-ratio:4/3;background:color-mix(in srgb,var(--navy2) 60%,var(--navy))}
.gx-tag{position:absolute;left:8px;top:8px;z-index:3;font-family:var(--geo);font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);background:var(--white);border-radius:2px;padding:3px 7px}
.gx-more{position:absolute;inset:0;z-index:3;display:grid;place-items:center;font-family:var(--cond);font-weight:700;font-size:34px;color:var(--white);background:color-mix(in srgb,var(--navy) 62%,transparent)}
.gx-plan{margin:10px 0 0;font-family:var(--geo);font-size:13px;letter-spacing:.06em}
.gx-plan a{color:var(--white);text-decoration:underline;text-underline-offset:4px}
/* wide screens: a main photograph beside a two by three block of thumbnails, all the same shape */
@media(min-width:900px){
  .gx--side .gx-stage{grid-template-columns:minmax(0,2fr) minmax(0,1fr);align-items:stretch}
  .gx--side .gx-main{aspect-ratio:auto;min-height:0}
  .gx--side .gx-main :global(.li){position:absolute;inset:0}
  .gx--side .gx-thumbs{grid-template-columns:repeat(2,1fr);align-content:start}
  .gx--row .gx-main,.gx--solo .gx-main{aspect-ratio:21/9}
  .gx--row .gx-thumbs{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:560px){.gx-main{aspect-ratio:4/3}}
/* the viewer */
.gx-dlg{width:min(100vw,1180px);max-width:100vw;height:100dvh;max-height:100dvh;margin:auto;padding:0;border:0;background:transparent;color:var(--white)}
.gx-dlg::backdrop{background:color-mix(in srgb,#000 88%,transparent)}
.gx-dlg[open]{display:flex;flex-direction:column}
.gx-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px}
.gx-pos{margin:0;font-family:var(--geo);font-size:13px;letter-spacing:.1em;color:var(--pale)}
.gx-x,.gx-nav{font-family:var(--sans);font-weight:600;color:var(--white);background:color-mix(in srgb,var(--white) 8%,transparent);border:1px solid color-mix(in srgb,var(--pale) 40%,transparent);border-radius:999px;cursor:pointer}
.gx-x{font-size:14px;padding:9px 18px}
.gx-x:hover,.gx-nav:hover{border-color:var(--white)}
.gx-x:focus-visible,.gx-nav:focus-visible{outline:2px solid var(--white);outline-offset:2px}
.gx-view{flex:1;min-height:0;display:grid;grid-template-columns:auto minmax(0,1fr) auto;grid-template-rows:minmax(0,1fr);align-items:center;gap:10px;padding:0 12px 18px}
.gx-nav{width:46px;height:46px;font-size:20px;line-height:1}
.gx-slides{list-style:none;margin:0;padding:0;min-width:0;height:100%}
.gx-slide{height:100%}
.gx-slide[hidden]{display:none}
.gx-fig{margin:0;height:100%;display:flex;flex-direction:column;gap:10px}
.gx-big{flex:1;min-height:0;position:relative;border-radius:8px;overflow:hidden}
.gx-cap{font-family:var(--sans);font-size:14px;line-height:1.5;color:var(--pale);text-align:center;margin:0}
@media(max-width:640px){.gx-view{grid-template-columns:1fr 1fr;grid-template-rows:minmax(0,1fr) auto;gap:12px 10px;justify-items:stretch}.gx-slides{grid-column:1 / -1;grid-row:1}.gx-prev{grid-row:2;grid-column:1}.gx-next{grid-row:2;grid-column:2}.gx-nav{width:auto;height:46px}}
.gx-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;aspect-ratio:3/2;border-radius:10px;border:1px dashed color-mix(in srgb,var(--pale) 30%,transparent);background:linear-gradient(160deg,color-mix(in srgb,var(--navy2) 70%,var(--navy)),var(--navy));color:var(--pale);text-align:center}
.gx-empty p{margin:0;font-family:var(--sans);font-size:16px}
.gx-empty-sub{font-size:14px;color:var(--muted)}
</style>
