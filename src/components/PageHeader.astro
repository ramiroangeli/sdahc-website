---
interface Props { eyebrow?: string; title: string; standfirst?: string; }
const { eyebrow, title, standfirst } = Astro.props;
---
<section class="pagehead"><div class="wrap">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="ph-title">{title}</h1>
  {standfirst && <p class="ph-standfirst">{standfirst}</p>}
</div></section>
<style>
.pagehead{padding:150px 0 60px;position:relative;background:radial-gradient(1000px 520px at 78% 10%,rgba(4,118,217,.10),transparent 60%),var(--navy)}
.ph-title{font-family:var(--serif);font-weight:600;color:#fff;font-size:clamp(34px,5.2vw,60px);line-height:1.04;letter-spacing:-.01em;margin:0;max-width:20ch}
.ph-standfirst{font-family:var(--sans);color:var(--pale);font-size:clamp(17px,2.1vw,21px);line-height:1.5;max-width:60ch;margin:22px 0 0}
</style>
