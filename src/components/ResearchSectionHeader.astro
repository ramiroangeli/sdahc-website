---
// Reusable section header, shared by the Research Hub AND the three report landing pages.
// `variant="hub"` is an opt-in Design System treatment (Stage 2 v2, Set A editorial) used only
// by the Hub's own call sites; every landing-page call site omits it, so their rendering (the
// original .eyebrow/.sec-h/.sec-lead corporate utility classes) is completely unchanged. Phase
// 4A restyles the Hub only, per its own scope boundary.
import '../styles/research-tokens.css';

// `number` (e.g. "01") is an optional hub-only section number, rendered beside a short accent
// rule ahead of the eyebrow: Set A's own type-scale notes describe its h2 token as "numbered
// section heads", and the source board's own nav-tab specimens number sections the same way
// ("01 Overview", "02 Publications"...). Landing-page call sites never pass it.
interface Props { eyebrow?: string; heading: string; lead?: string; variant?: 'hub'; number?: string }
const { eyebrow, heading, lead, variant, number } = Astro.props;
const hub = variant === 'hub';
---
<div class={hub ? 'rhub-head rhub-head-ds' : 'rhub-head'}>
  {eyebrow && (
    hub ? (
      <p class="r-eyebrow">{number && <span class="r-eyebrow-rule" aria-hidden="true"></span>}{number && `${number} · `}{eyebrow}</p>
    ) : (
      <p class="eyebrow">{eyebrow}</p>
    )
  )}
  <h2 class={hub ? 'r-sec-h' : 'sec-h'}>{heading}</h2>
  {lead && <p class={hub ? 'r-sec-lead' : 'sec-lead'}>{lead}</p>}
</div>
<style>
.rhub-head{margin:0 0 36px}

/* Design System (Set A editorial): Bricolage Grotesque display heading.
   .r-eyebrow/.r-eyebrow-rule (the "NN · Label" treatment above the heading) now live in
   research-tokens.css as shared global utility classes, not here, so the Publications section's
   own hand-written eyebrow (which needs the label without this component's heading/lead) can
   reuse the identical styling instead of duplicating these rules. */
.r-sec-h{font-family:var(--r-font-display);font-weight:700;font-stretch:90%;color:var(--r-midnight-ink);font-size:var(--r-size-h2);line-height:1.05;margin:0;max-width:20ch}
.r-sec-lead{font-family:var(--r-font-body);color:var(--r-graphite);font-size:var(--r-size-lead);line-height:1.5;max-width:66ch;margin:16px 0 0}
</style>
