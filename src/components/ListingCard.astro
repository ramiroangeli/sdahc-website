---
import { Image } from 'astro:assets';
import ListingStatusBadge from './ListingStatusBadge.astro';
import ListingImage from './ListingImage.astro';
import { TYPE_LABEL, type PublicListing } from '../data/listings/schema';
import { localityLine, streetLine } from '../data/listings/address';
import { cardView } from '../data/listings/card';

/*
  Horizontal catalogue card. Three areas: photograph (4:3), property information, and an OPTIONAL commercial column that exists only when
  approved commercial facts exist (see src/data/listings/card.ts). Below them an action row. The marketing agency logo is always visible:
  at the foot of the commercial column when there is one, otherwise at the right of the action row. On mobile everything stacks.
  The list item keeps the data-* attributes the catalogue filter script reads.
*/
interface Props { listing: PublicListing; index?: number }
const { listing, index = 0 } = Astro.props;
const designs = listing.sda.designCategories ?? [];
const a = listing.address;
const search = [a.street, a.suburb, a.state, a.postcode].join(' ').toLowerCase();
const { cover, facts, commercial, agency, sold } = cardView(listing);
const href = `/opportunities/${listing.slug}/`;
// brand files already in src/assets; the card is on a dark surface, so the white variant is used
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/logo-*.png', { eager: true });
const logo = logos[`../assets/${agency.logoOnDark}`]?.default;
---
<li
  class="lc"
  data-state={a.state}
  data-type={listing.type}
  data-status={listing.commercialStatus}
  data-design={designs.join(' ')}
  data-search={search}
  data-suburb={a.suburb.toLowerCase()}
  data-published={listing.publishedAt}
  data-index={index}
>
  <article class="lc-card">
    <div class={`lc-main${commercial ? ' lc-main--comm' : ''}`}>
      <a class="lc-media" href={href} tabindex="-1" aria-hidden="true">
        <ListingImage photo={cover} sizes="(min-width: 900px) 300px, (min-width: 620px) 240px, 100vw" demoTag={false} />
        <span class="lc-state">{a.state}</span>
        {listing.isPreview && <span class="lc-demo">Draft preview</span>}
        {listing.isDemo && <span class="lc-demo">Demo listing</span>}
      </a>

      <div class="lc-body">
        <div class="lc-badges">
          <ListingStatusBadge status={listing.commercialStatus} />
          <span class="lc-type">{TYPE_LABEL[listing.type]}</span>
        </div>
        <h3 class="lc-title"><a class="lc-link" href={href}>{streetLine(a)}</a></h3>
        <p class="lc-loc">{localityLine(a)}</p>
        {facts.length > 0 && (
          <dl class="lc-facts">
            {facts.map((f) => (<div class="lc-fact"><dt>{f.label}</dt><dd>{f.value}</dd></div>))}
          </dl>
        )}
        <p class="lc-sum">{listing.summary}</p>
      </div>

      {commercial && (
        <div class="lc-comm">
          <div class="lc-comm-top">
            {commercial.price && (
              <p class="lc-price"><span class="lc-price-v">{commercial.price.value}</span><span class="lc-yield-l">{commercial.price.label}</span></p>
            )}
            {commercial.yield && (
              <p class="lc-yield"><span class="lc-yield-n">{commercial.yield.text}</span><span class="lc-yield-l">{commercial.yield.label} <span class="lc-yield-b">{commercial.yield.basis.toLowerCase()}</span></span></p>
            )}
            {commercial.lease && <p class="lc-status">{commercial.lease}</p>}
            {commercial.occupancy && <p class="lc-status">{commercial.occupancy}</p>}
          </div>
          {logo && <Image class="lc-logo" src={logo} alt={agency.name} height={52} loading="lazy" />}
        </div>
      )}
    </div>

    <div class="lc-actions">
      {sold
        ? <a class="btn b1 lc-btn" href="/contact-us/">Find similar properties</a>
        : <a class="btn b1 lc-btn" href={`${href}#enquire`}>Contact Agent<span class="lc-sr"> about {streetLine(a)}</span></a>}
      <a class="btn b2 lc-btn" href={href}>View details<span class="lc-sr"> for {streetLine(a)}</span></a>
      {!commercial && logo && <Image class="lc-logo lc-logo--foot" src={logo} alt={agency.name} height={36} loading="lazy" />}
    </div>
  </article>
</li>
<style>
.lc[hidden]{display:none}
.lc{margin:0;padding:0}
.lc-card{display:flex;flex-direction:column;border:1px solid color-mix(in srgb,var(--pale) 18%,transparent);border-radius:10px;background:color-mix(in srgb,var(--white) 5%,transparent);overflow:hidden;transition:border-color .22s ease,background .22s ease}
.lc-card:hover{border-color:color-mix(in srgb,var(--blue) 55%,transparent);background:color-mix(in srgb,var(--white) 8%,transparent)}
.lc-main{display:grid;grid-template-columns:300px minmax(0,1fr)}
.lc-main--comm{grid-template-columns:300px minmax(0,1fr) 220px}
/* every photograph sits in the same 4:3 frame and is cropped, never stretched */
.lc-media{position:relative;display:block;align-self:start;width:100%;aspect-ratio:4/3;overflow:hidden}
.lc-media :global(.li img){object-position:center 40%}
.lc-state{position:absolute;left:12px;top:12px;font-family:var(--geo);font-size:11px;font-weight:600;letter-spacing:.12em;color:var(--white);background:color-mix(in srgb,var(--navy) 72%,transparent);border:1px solid color-mix(in srgb,var(--pale) 40%,transparent);border-radius:2px;padding:3px 8px}
.lc-demo{position:absolute;left:12px;bottom:12px;font-family:var(--geo);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--navy);background:var(--amber);border-radius:2px;padding:4px 8px}
.lc-body{display:flex;flex-direction:column;min-width:0;padding:20px 24px}
.lc-badges{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:12px}
.lc-type{font-family:var(--geo);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--pale)}
.lc-title{font-family:var(--serif);font-weight:600;color:var(--white);font-size:clamp(20px,2vw,24px);line-height:1.2;margin:0 0 4px}
.lc-link{color:inherit;text-decoration:none}
.lc-link:hover{text-decoration:underline;text-underline-offset:4px}
.lc-link:focus-visible{outline:2px solid var(--white);outline-offset:3px;border-radius:2px}
.lc-loc{font-family:var(--geo);font-size:13px;letter-spacing:.04em;color:var(--pale);margin:0 0 14px}
.lc-facts{display:flex;flex-wrap:wrap;gap:12px 26px;margin:0 0 14px}
.lc-fact dt{font-family:var(--geo);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--pale);margin:0 0 2px}
.lc-fact dd{margin:0;font-family:var(--sans);font-size:15px;font-weight:600;color:var(--white)}
.lc-sum{font-family:var(--sans);font-size:14.5px;line-height:1.55;color:var(--white);margin:auto 0 0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
/* optional commercial column: separate data elements, never one marketing sentence */
.lc-comm{display:flex;flex-direction:column;justify-content:space-between;gap:18px;padding:20px 22px;border-left:1px solid color-mix(in srgb,var(--pale) 18%,transparent)}
.lc-price{margin:0 0 12px;display:flex;flex-direction:column}
.lc-price-v{font-family:var(--cond);font-weight:700;font-size:30px;line-height:1.05;color:var(--white)}
.lc-yield{margin:0 0 10px;display:flex;flex-direction:column}
.lc-yield-n{font-family:var(--cond);font-weight:700;font-size:44px;line-height:1;color:var(--teal)}
.lc-yield-l{font-family:var(--geo);font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--white);margin-top:6px}
.lc-yield-b{color:var(--pale);font-weight:500}
.lc-status{margin:0 0 4px;font-family:var(--sans);font-size:15px;font-weight:600;color:var(--white)}
/* the agency logo: the whole mark is always visible (contain), never cropped */
.lc-logo{display:block;width:auto;max-width:100%;object-fit:contain}
.lc-comm .lc-logo{align-self:flex-end}
.lc-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px;padding:14px 24px;border-top:1px solid color-mix(in srgb,var(--pale) 16%,transparent)}
.lc-btn{padding:10px 20px;font-size:14.5px}
.lc-logo--foot{margin-left:auto;opacity:.9}
.lc-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
/* tablet: the commercial column drops under the photograph and information, as a row */
@media(max-width:899px){
  .lc-main,.lc-main--comm{grid-template-columns:240px minmax(0,1fr)}
  .lc-comm{grid-column:1 / -1;flex-direction:row;align-items:flex-end;justify-content:space-between;border-left:0;border-top:1px solid color-mix(in srgb,var(--pale) 18%,transparent);padding:16px 24px}
  .lc-comm-top{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 24px}
  .lc-yield{margin:0}
}
/* mobile: photo, information, commercial, actions */
@media(max-width:620px){
  .lc-main,.lc-main--comm{grid-template-columns:1fr}
  .lc-body{padding:18px}
  .lc-comm{padding:16px 18px}
  .lc-actions{padding:14px 18px}
  .lc-btn{flex:1 1 auto;text-align:center}
  .lc-logo--foot{margin-left:auto}
}
@media(prefers-reduced-motion:reduce){.lc-card{transition:none}}
</style>
