---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';

interface Props { title: string; description?: string; }
const { title, description = 'Independent commercial advisory for the sale, acquisition and strategic review of Specialist Disability Accommodation in Australia.' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-default.png', Astro.site).href;
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SDA Home Choices",
  "url": Astro.site?.href,
  "logo": new URL('/favicon-512.png', Astro.site).href,
  "description": "Independent commercial advisory for the sale, acquisition and strategic review of Specialist Disability Accommodation in Australia.",
  "areaServed": "AU",
  "sameAs": ["https://www.linkedin.com/company/sda-home-choices/"]
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "SDA Home Choices",
  "url": Astro.site?.href
};
---
<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <!-- favicons -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#00162B" />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="SDA Home Choices" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="en_AU" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  <script type="application/ld+json" set:html={JSON.stringify(website)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Source+Sans+3:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <Nav />
  <main><slot /></main>
  <Footer />
  <div class="click-effects" aria-hidden="true"></div>
  <Analytics />
</body>
</html>

<script>
  const effects = document.querySelector<HTMLElement>('.click-effects');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const bursts = new Map<HTMLElement, number>();
  const excluded = 'a, button, input, textarea, select, label, summary, [role="button"], [aria-disabled="true"], [contenteditable]';

  function removeBurst(burst: HTMLElement) {
    window.clearTimeout(bursts.get(burst));
    bursts.delete(burst);
    burst.remove();
  }

  document.addEventListener('click', (event) => {
    if (!effects || reducedMotion.matches || event.detail === 0) return;
    if (!(event.target instanceof Element) || event.target.closest(excluded)) return;

    if (bursts.size >= 8) removeBurst(bursts.keys().next().value!);
    const burst = document.createElement('span');
    burst.className = 'click-burst';
    burst.style.left = `${event.clientX}px`;
    burst.style.top = `${event.clientY}px`;
    for (let i = 0; i < 3; i++) burst.append(document.createElement('i'));
    burst.addEventListener('animationend', () => removeBurst(burst), { once: true });
    burst.addEventListener('animationcancel', () => removeBurst(burst), { once: true });
    bursts.set(burst, window.setTimeout(() => removeBurst(burst), 800));
    effects.append(burst);
  }, { passive: true });

  function clearBursts() {
    bursts.forEach((_, burst) => removeBurst(burst));
  }
  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches) clearBursts();
  });
  window.addEventListener('pagehide', clearBursts);
</script>

<style>
.click-effects{position:fixed;inset:0;z-index:var(--z-click-effects);pointer-events:none;overflow:clip;contain:strict}
.click-effects :global(.click-burst){position:fixed;width:26px;height:16px;pointer-events:none;animation:click-rise .6s ease-out forwards}
.click-effects :global(.click-burst i){position:absolute;bottom:0;width:2px;height:12px;border-radius:1px;background:var(--pale)}
.click-effects :global(.click-burst i:nth-child(1)){left:3px;transform:rotate(-24deg)}
.click-effects :global(.click-burst i:nth-child(2)){left:12px;height:16px}
.click-effects :global(.click-burst i:nth-child(3)){left:21px;transform:rotate(24deg)}
@keyframes click-rise{from{opacity:.7;transform:translate(-50%,-100%)}to{opacity:0;transform:translate(-50%,calc(-100% - 26px))}}
@media(prefers-reduced-motion:reduce){.click-effects{display:none}.click-effects :global(.click-burst){animation:none}}
</style>
