---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/opportunities.json';

const { statesCovered } = data;

/*
  Internal note, not rendered on the page: the real geocoded property counts behind the
  "100+" headline are QLD 76, VIC 39, SA 26, NSW 8, WA 3, ACT 1 (153 geocoded, roughly 220
  records in total). These counts fluctuate and include pipeline opportunities, so they are
  deliberately not broken out per state on the page. NT is claimed through a portfolio but
  not yet confirmed in the records, so it is excluded from statesCovered for now.
*/

// Pluggable hero background. heroVideo stays empty (no SDAHC-hosted clip exists yet); heroPoster
// points at the same generic reference photo used to be a standalone content image (see below),
// now repurposed as the hero's static background, shown under a dark navy mask so it reads as a
// quiet texture rather than a bright photo. To swap in a real SDAHC-hosted clip later, set
// heroVideo = '/videos/opportunities-hero.mp4' (heroPoster already covers the poster/fallback
// role). Never point either at a third party's branded asset. If either is ever hosted on a
// domain other than this site's own, that domain must be added to media-src (video) / img-src
// (poster) in vercel.json's Content-Security-Policy, or the browser will block it.
const heroVideo = '';
const heroPoster = '/images/opportunities/feature.jpg';

// Reference images for the 3-up row. GENERIC reference photography only (accessible housing,
// purpose-built dwelling exteriors/interiors, community settings): NEVER a specific off-market
// asset, and must never carry an address or other identifying detail. Keep captions generic.
// Source files (square, 800 x 800) live at:
//   refImages[0].src -> public/images/opportunities/ref-1.jpg
//   refImages[1].src -> public/images/opportunities/ref-2.jpg
//   refImages[2].src -> public/images/opportunities/ref-3.jpg
// If an image is ever hosted off-origin instead, that domain must be added to img-src in
// vercel.json's Content-Security-Policy, or the browser will block it. Clearing a slot's src back
// to '' renders the styled placeholder instead of a broken image.
const refImages = [
  { src: '/images/opportunities/ref-1.jpg', alt: 'Accessible, purpose-built home with ramp access', caption: 'Accessible, purpose-built dwellings', w: 800, h: 800 },
  { src: '/images/opportunities/ref-2.jpg', alt: 'Contemporary purpose-built homes in an established location', caption: 'Purpose-built housing', w: 800, h: 800 },
  { src: '/images/opportunities/ref-3.jpg', alt: 'Aerial view of an Australian residential neighbourhood', caption: 'Communities across Australia', w: 800, h: 800 },
];
---
<BaseLayout title="Off-market SDA opportunities | SDA Home Choices" description="Off-market Specialist Disability Accommodation opportunities across Australia. Register your buyer mandate or speak to us about selling an SDA asset.">
  <section class="opp-cinehero" id="oppHero" data-has-video={heroVideo ? '1' : ''}>
    <div class="opp-cinehero-bg" aria-hidden="true">
      {heroVideo ? (
        <>
          <video class="opp-hero-video v1" muted autoplay loop playsinline preload="auto" poster={heroPoster || undefined} aria-hidden="true">
            <source src={heroVideo} type="video/mp4" />
          </video>
          <video class="opp-hero-video v2" muted autoplay loop playsinline preload="auto" poster={heroPoster || undefined} aria-hidden="true">
            <source src={heroVideo} type="video/mp4" />
          </video>
        </>
      ) : heroPoster ? (
        <img class="opp-hero-poster" src={heroPoster} alt="" />
      ) : null}
      <div class="opp-aurora">
        <span class="opp-aurora-blob b1"></span>
        <span class="opp-aurora-blob b2"></span>
        <span class="opp-aurora-blob b3"></span>
      </div>
      <div class="opp-hero-scrim"></div>
    </div>

    <div class="opp-cinehero-inner">
      <h1 class="opp-hero-headline">
        <span class="ln"><span class="ln-i">Off-market SDA opportunities</span></span>
        <span class="ln"><span class="ln-i">across Australia</span></span>
      </h1>
      <p class="opp-hero-subtitle">We hold 100+ off-market Specialist Disability Accommodation opportunities nationally, from single dwellings to large portfolios. Most never reach the open market.</p>
      <div class="opp-hero-ctas">
        <a class="btn b1 opp-hero-cta" href="#enquiry">Register your interest<svg class="opp-arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        <a class="btn b2 opp-hero-cta-ghost" href="#enquiry">Selling an SDA asset?</a>
      </div>
    </div>
  </section>

  <section class="section opp-states-band"><div class="wrap">
    <div class="opp-states">
      <p class="opp-states-caption">Active mandates and listings across six states and territories.</p>
      <div class="opp-pills">
        {statesCovered.map((s) => <span class="opp-pill">{s}</span>)}
      </div>
    </div>
  </div></section>

  <section class="section opp-why-band"><div class="wrap">
    <h2 class="opp-heading">Why off-market</h2>
    <div class="opp-why-grid">
      <div class="opp-why-card">
        <span class="card-mark"></span>
        <h3>A curated, confidential market</h3>
        <p>Most SDA transactions of scale happen off-market. We match qualified buyers to opportunities without public listing, protecting price and tenant stability.</p>
      </div>
      <div class="opp-why-card">
        <span class="card-mark"></span>
        <h3>Specialist diligence built in</h3>
        <p>Every opportunity is assessed against SDA design category, enrolment, tenancy and compliance, so you are evaluating real investable positions, not raw listings.</p>
      </div>
      <div class="opp-why-card">
        <span class="card-mark"></span>
        <h3>Access to the full picture</h3>
        <p>Pricing is by EOI and detailed Information Memoranda are released under NDA, so serious parties see what they need to make a decision.</p>
      </div>
    </div>

    <div class="opp-img-row">
      {refImages.map((img) => (
        <figure class="opp-img-cell">
          {img.src ? (
            <img src={img.src} alt={img.alt} loading="lazy" width={img.w} height={img.h} class="opp-img-cell-media" />
          ) : (
            <div class="opp-img-cell-media opp-img-ph" aria-hidden="true">
              <svg class="opp-img-ph-icon" width="28" height="28" viewBox="0 0 24 24"><path d="M4 5h16v14H4z" fill="none" stroke="currentColor" stroke-width="1.3" /><circle cx="9" cy="10" r="1.4" fill="currentColor" /><path d="M4 16l5-5 4 4 3-3 4 4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span class="opp-img-ph-dim">{img.w} x {img.h}</span>
            </div>
          )}
        </figure>
      ))}
    </div>
  </div></section>

  <section class="section opp-access-band"><div class="wrap">
    <h2 class="opp-heading">How access works</h2>
    <div class="opp-step-grid">
      <div class="opp-step-card">
        <span class="opp-step-no">01</span>
        <h3>Register your interest</h3>
        <p>Tell us what you are looking for, or what you are selling.</p>
      </div>
      <div class="opp-step-card">
        <span class="opp-step-no">02</span>
        <h3>Sign an NDA</h3>
        <p>A short mutual NDA unlocks confidential detail.</p>
      </div>
      <div class="opp-step-card">
        <span class="opp-step-no">03</span>
        <h3>Receive matched opportunities</h3>
        <p>We share Information Memoranda that fit your brief.</p>
      </div>
      <div class="opp-step-card">
        <span class="opp-step-no">04</span>
        <h3>Submit an EOI</h3>
        <p>Move to offer and diligence on the assets that fit.</p>
      </div>
    </div>
  </div></section>

  <section class="section opp-enquiry-band" id="enquiry"><div class="wrap opp-enquiry-grid">
    <div class="opp-enquiry-info">
      <h2 class="opp-heading opp-heading-left">Register your interest</h2>
      <p class="opp-enquiry-intro">Tell us whether you are buying or selling and a little about your brief. The right person at SDA Home Choices will get back to you.</p>
      <ul class="opp-enquiry-items">
        <li class="opp-enquiry-item">
          <span class="card-mark" aria-hidden="true"></span>
          <p class="ci-label">Email</p>
          <a href="mailto:steve@sdahomechoices.com.au">steve@sdahomechoices.com.au</a>
        </li>
        <li class="opp-enquiry-item">
          <span class="card-mark" aria-hidden="true"></span>
          <p class="ci-label">Phone</p>
          <a href="tel:+61408550441">+61 408 550 441</a>
        </li>
      </ul>
    </div>

    <div class="opp-enquiry-card">
      <form class="form" data-endpoint="/api/opportunities/">
        <input type="text" name="company" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
        <fieldset class="opp-radio-group">
          <legend>I am a...</legend>
          <label class="opp-radio"><input type="radio" name="enquiryType" value="Buyer" required /> Buyer</label>
          <label class="opp-radio"><input type="radio" name="enquiryType" value="Vendor" required /> Vendor</label>
        </fieldset>
        <div>
          <label for="oppName">Name</label>
          <input type="text" id="oppName" name="name" required />
        </div>
        <div>
          <label for="oppEmail">Email</label>
          <input type="email" id="oppEmail" name="email" required />
        </div>
        <div>
          <label for="oppPhone">Phone</label>
          <input type="tel" id="oppPhone" name="phone" required />
        </div>
        <div>
          <label for="oppMessage">Your brief or property</label>
          <textarea id="oppMessage" name="message" required></textarea>
        </div>
        <button type="submit" class="btn b1">Send enquiry</button>
        <p class="form-status" role="status"></p>
      </form>
    </div>
  </div></section>
</BaseLayout>

<!-- CSP note: this inline script is allow-listed in vercel.json by exact sha256 hash. Editing it requires recomputing and updating that hash, or the CSP will silently block it. -->
<script>
  const hero = document.getElementById('oppHero');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero) {
    // pluggable background video: cross-fades two looped <video> elements near the loop
    // point to hide the seam. Inert (no-op) until heroVideo is set on the page, since the
    // video elements then do not exist in the DOM at all.
    if (hero.dataset.hasVideo === '1') {
      const v1 = hero.querySelector('.opp-hero-video.v1');
      const v2 = hero.querySelector('.opp-hero-video.v2');
      if (v1 && v2) {
        if (reduceMotion) {
          v1.pause();
          v2.pause();
        } else {
          let active = v1, idle = v2;
          idle.style.opacity = '0';
          const crossfade = () => {
            idle.currentTime = 0;
            idle.play().catch(() => {});
            idle.style.opacity = '1';
            active.style.opacity = '0';
            const next = idle;
            idle = active;
            active = next;
          };
          active.addEventListener('timeupdate', () => {
            if (active.duration && active.duration - active.currentTime < 1) crossfade();
          });
        }
      }
    }

    // masked line-rise entrance: the hidden/offset state is the plain CSS default (no flash),
    // and arming is gated on fonts.ready (with a timeout ceiling) so type doesn't visibly reflow
    // mid-animation. The apparatus detaches itself (transitions removed) once the last tween ends,
    // so the resting page is fully static.
    if (reduceMotion) {
      hero.classList.add('is-armed', 'is-settled');
    } else {
      const arm = () => {
        if (hero.classList.contains('is-armed')) return;
        hero.classList.add('is-armed');
        const tweened = hero.querySelectorAll('.ln-i, .opp-hero-subtitle, .opp-hero-ctas .btn');
        let pending = tweened.length;
        const settle = () => { hero.classList.add('is-settled'); };
        const onEnd = () => { pending -= 1; if (pending <= 0) { settle(); hero.removeEventListener('transitionend', onEnd); } };
        hero.addEventListener('transitionend', onEnd);
        window.setTimeout(settle, 1800);
      };
      const ceiling = window.setTimeout(arm, 400);
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(() => { window.clearTimeout(ceiling); arm(); });
      } else {
        arm();
      }
    }
  }
</script>

<!-- CSP note: this inline script is allow-listed in vercel.json by exact sha256 hash. Editing it requires recomputing and updating that hash, or the CSP will silently block it. -->
<script>
  const form = document.querySelector('form[data-endpoint]');
  if (form) form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]');
    const status = form.querySelector('.form-status');
    const enquiryType = form.querySelector('input[name="enquiryType"]:checked');
    const name = form.querySelector('#oppName').value.trim();
    const email = form.querySelector('#oppEmail').value.trim();
    const message = form.querySelector('#oppMessage').value.trim();
    if (!enquiryType || !name || !email || !message) {
      status.textContent = 'Please complete all required fields.';
      return;
    }
    btn.disabled = true; status.textContent = 'Sending...';
    try {
      const res = await fetch(form.dataset.endpoint, { method: 'POST', body: new FormData(form) });
      const out = await res.json();
      if (out.ok) { status.textContent = 'Thank you. We will be in touch shortly.'; }
      else { status.textContent = out.error || 'Something went wrong.'; btn.disabled = false; }
    } catch { status.textContent = 'Network error. Please try again.'; btn.disabled = false; }
  });
</script>
<style>
:root{
  --opp-depth:.85;
}

/* cinematic hero: full-bleed, scrolls as a normal section (no viewport lock). Background layer
   order (bottom to top): the photo (heroPoster, or the video once heroVideo is set), a subtle
   brand aurora drifting above it, then a dark navy mask on top of both so the photo reads as a
   quiet texture behind the hero rather than a bright image, and the aurora reads as a soft glow
   rather than competing with the photo. */
.opp-cinehero{position:relative;overflow:hidden;width:100%;height:min(100svh,760px);min-height:560px;display:flex;align-items:center;justify-content:center}
.opp-cinehero-bg{position:absolute;inset:0;z-index:0;background:var(--navy);overflow:hidden}
.opp-hero-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none}
.opp-hero-video.v2{opacity:0}
.opp-hero-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;pointer-events:none}
.opp-aurora{position:absolute;inset:-12%;pointer-events:none}
.opp-aurora-blob{position:absolute;border-radius:50%;filter:blur(80px);will-change:transform,opacity}
.opp-aurora-blob.b1{width:58vw;height:58vw;max-width:780px;max-height:780px;left:-8%;top:-12%;background:radial-gradient(circle,var(--navy2) 0%,rgba(6,51,107,0) 70%);opacity:.32;animation:auroraDrift1 30s ease-in-out infinite alternate}
.opp-aurora-blob.b2{width:52vw;height:52vw;max-width:720px;max-height:720px;right:-10%;top:6%;background:radial-gradient(circle,var(--blue) 0%,rgba(4,118,217,0) 70%);opacity:.18;animation:auroraDrift2 36s ease-in-out infinite alternate}
.opp-aurora-blob.b3{width:42vw;height:42vw;max-width:600px;max-height:600px;left:22%;bottom:-18%;background:radial-gradient(circle,var(--teal) 0%,rgba(47,160,168,0) 70%);opacity:.1;animation:auroraDrift3 42s ease-in-out infinite alternate}
@keyframes auroraDrift1{0%{transform:translate(0,0) scale(1)}100%{transform:translate(6%,5%) scale(1.14)}}
@keyframes auroraDrift2{0%{transform:translate(0,0) scale(1);opacity:.16}100%{transform:translate(-6%,-5%) scale(1.1);opacity:.24}}
@keyframes auroraDrift3{0%{transform:translate(0,0) scale(1)}100%{transform:translate(-5%,6%) scale(1.12)}}
/* the mask: strong dark navy overall, a touch stronger toward the top, so the photo and aurora
   both read as a quiet texture and hero text stays fully legible at every point */
.opp-hero-scrim{position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(0,22,43,.92) 0%,rgba(0,22,43,.82) 45%,rgba(0,22,43,.88) 100%)}

.opp-cinehero-inner{position:relative;z-index:1;max-width:1140px;margin:0 auto;padding:var(--nav-clearance) 24px 0;display:flex;flex-direction:column;align-items:center}

/* headline: a proportional unit authored against a 1280x760 composition drives desktop sizing,
   filling close to the hero's content width while keeping "Off-market SDA opportunities" on one
   line at 1160px and up, with a safety margin; below that, and on mobile, it falls back to the
   site's normal clamp()-based responsive scale. No max-width in ch is set on the headline itself,
   so each authored line wraps only when the viewport is genuinely too narrow for it, never mid-word. */
.opp-hero-headline{font-family:var(--serif);font-weight:600;color:#fff;line-height:1.08;letter-spacing:-.01em;margin:0;text-align:center;overflow-wrap:normal;word-break:normal;hyphens:none;font-size:clamp(34px,8.4vw,60px)}
@media(min-width:1160px){
  .opp-cinehero{--u:min(calc(100vw / 1280px),calc(100svh / 760px))}
  .opp-hero-headline{font-size:min(calc(var(--u) * 70px),72px)}
}
.opp-hero-headline .ln{display:block;overflow:hidden}
.opp-hero-headline .ln-i{display:block;transform:translateY(110%);transition:transform .9s cubic-bezier(.16,1,.3,1)}
.opp-hero-headline .ln:nth-child(2) .ln-i{transition-delay:.14s}

.opp-hero-subtitle{font-family:var(--sans);color:var(--pale);font-size:clamp(16px,1.6vw,20px);line-height:1.55;max-width:58ch;margin:28px 0 0;text-align:center;opacity:0;filter:blur(6px);transform:translateY(14px);transition:opacity .7s ease,filter .7s ease,transform .7s ease;transition-delay:.32s}

.opp-hero-ctas{display:flex;flex-wrap:wrap;justify-content:center;gap:16px;margin-top:40px}
.opp-hero-ctas .btn{opacity:0;transform:translateY(14px);transition:opacity .6s ease,transform .6s ease;display:inline-flex;align-items:center;gap:8px}
.opp-hero-ctas .btn:nth-child(1){transition-delay:.44s}
.opp-hero-ctas .btn:nth-child(2){transition-delay:.54s}
.opp-arrow{flex:0 0 auto}
.opp-hero-cta-ghost{backdrop-filter:blur(6px);background:rgba(255,255,255,.06)}

.opp-cinehero.is-armed .opp-hero-headline .ln-i{transform:translateY(0)}
.opp-cinehero.is-armed .opp-hero-subtitle{opacity:1;filter:blur(0);transform:translateY(0)}
.opp-cinehero.is-armed .opp-hero-ctas .btn{opacity:1;transform:translateY(0)}

/* detach the entrance apparatus once settled: the resting page carries no live transitions */
.opp-cinehero.is-settled .opp-hero-headline .ln-i,
.opp-cinehero.is-settled .opp-hero-subtitle,
.opp-cinehero.is-settled .opp-hero-ctas .btn{transition:none}

@media(max-width:480px){.opp-hero-ctas{flex-direction:column;width:100%}.opp-hero-ctas .btn{width:100%;justify-content:center}}

@media(prefers-reduced-motion:reduce){
  .opp-hero-headline .ln-i,.opp-hero-subtitle,.opp-hero-ctas .btn{transition:none!important;transform:none!important;opacity:1!important;filter:none!important}
  .opp-aurora-blob{animation:none!important}
}

/* ===== section colour rhythm =====
   The page alternates light (paper) and dark (navy) bands down the page, closing on a deeper
   navy2 "accent" band before the footer. Each band fades only on its OWN outgoing (bottom) edge
   toward the next band's colour; the next band then starts flat at that same colour, so every
   seam is a single soft gradient rather than two competing ones. The hero (its own component)
   and the footer (plain navy) are the fixed colour anchors at each end of the sequence. */
.opp-heading{font-family:var(--serif);font-weight:600;color:#fff;font-size:clamp(24px,3.2vw,34px);line-height:1.15;margin:0 0 16px;text-align:center}

/* states coverage strip: LIGHT. Fades in from the hero's navy and out to the next (dark) band. */
.opp-states-band{position:relative;overflow:hidden;background:var(--paper)}
.opp-states-band::before{content:"";position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,var(--navy) 0%,var(--paper) 16%,var(--paper) 84%,var(--navy) 100%)}
.opp-states-band>*{position:relative;z-index:1}
.opp-states{text-align:center}
.opp-states-caption{font-family:var(--sans);color:var(--slate);font-size:15px;margin:0 0 18px}
.opp-pills{display:flex;flex-wrap:wrap;justify-content:center;gap:10px}
.opp-pill{display:inline-flex;align-items:center;font-family:var(--geo);font-size:13px;font-weight:600;letter-spacing:.08em;color:var(--navy);border:1px solid color-mix(in srgb,var(--navy) 22%,transparent);background:color-mix(in srgb,var(--navy) 5%,transparent);border-radius:999px;padding:10px 20px}

/* why off-market: DARK. Receives the states-band fade-out (starts flat navy) and fades out at its
   own bottom toward the light how-access-works band below. */
.opp-why-band{position:relative;overflow:hidden;background:var(--navy)}
.opp-why-band::before{content:"";position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,var(--navy) 0%,var(--navy) 86%,var(--paper) 100%)}
.opp-why-band::after{content:"";position:absolute;inset:0;z-index:0;opacity:var(--opp-depth);background:radial-gradient(900px 560px at 50% 30%,rgba(4,118,217,.28) 0%,rgba(4,118,217,0) 62%)}
.opp-why-band>*{position:relative;z-index:1}
.opp-why-grid{margin-top:28px;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;align-items:stretch}
.opp-why-card{display:flex;flex-direction:column;height:100%;padding:28px 24px;border:1px solid color-mix(in srgb,var(--pale) 18%,transparent);border-radius:10px;background:rgba(255,255,255,.05);transition:transform .22s ease,border-color .22s ease,background .22s ease}
.opp-why-card:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--blue) 55%,transparent);background:rgba(255,255,255,.08)}
.opp-why-card .card-mark{display:block;width:28px;height:3px;background:var(--blue);margin-bottom:16px;border-radius:2px}
.opp-why-card h3{font-family:var(--serif);font-weight:600;color:#fff;font-size:clamp(18px,1.8vw,21px);line-height:1.2;margin:0 0 12px}
.opp-why-card p{font-family:var(--sans);color:#fff;font-size:14.5px;line-height:1.6;margin:0}
@media(max-width:860px){.opp-why-grid{grid-template-columns:1fr;gap:20px}}

/* 3-up reference image row, embedded at the foot of the why-off-market band. Square tiles, kept
   deliberately modest (max-width, centred) so the photos read as supporting imagery. */
.opp-img-row{margin:36px auto 0;max-width:560px;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.opp-img-cell{margin:0}
.opp-img-cell-media{display:block;width:100%;height:100%;aspect-ratio:1/1;border-radius:10px;object-fit:cover}
.opp-img-caption{margin:10px 0 0;font-family:var(--geo);font-size:12px;letter-spacing:.06em;color:var(--pale);text-align:center}
@media(max-width:860px){.opp-img-row{grid-template-columns:1fr 1fr;gap:16px}}
@media(max-width:560px){.opp-img-row{grid-template-columns:1fr}}

/* generic placeholder surface used by the 3-up row until a real src is supplied; never a broken
   image, always an intentional styled slot */
.opp-img-ph.opp-img-ph{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;width:100%;border-radius:10px;border:1px dashed color-mix(in srgb,var(--pale) 30%,transparent);background:linear-gradient(160deg,color-mix(in srgb,var(--navy2) 55%,transparent) 0%,color-mix(in srgb,var(--navy) 70%,transparent) 100%);color:var(--pale)}
