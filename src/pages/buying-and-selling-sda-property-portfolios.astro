---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="Buying and Selling SDA Property Portfolios | SDA Home Choices" description="We facilitate transactions, managing all aspects of SDA portfolio sales.">
  <PageHeader
    eyebrow="Our services"
    title="Buying and Selling SDA Property Portfolios"
  />
  <section class="section"><div class="prose">
    <p>We facilitate transactions, managing all aspects of SDA portfolio sales. From coordinating specialist valuations and exit strategy planning to complex off-market sales negotiations, we connect investors with opportunities.</p>
    <p>Our network includes leading SDA housing providers, financiers, capital providers, specialist valuers, and legal professionals, ensuring that every transaction is executed diligently.</p>
  </div></section>
</BaseLayout>
