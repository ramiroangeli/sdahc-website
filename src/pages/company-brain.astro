---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrainHero from '../components/BrainHero.astro';
import { SITE, ORG_ID, WEBSITE_ID, faqPage } from '../data/seo';

// The FAQ is rendered from this list and repeated in the FAQPage schema, so the two never drift.
const faqs = [
  { q: 'Do we need to replace our existing systems?', a: 'Usually, no. A company brain connects selected information from your CRM, document hub and other existing sources. Any proposed changes should solve a specific operational problem.' },
  { q: 'Is a company brain the same as an AI assistant?', a: 'No. An AI assistant can help explain or retrieve information. The company brain provides the structured relationships and evidence that make those answers easier to check.' },
  { q: 'Can everyone see all company information?', a: 'They should not. Access is designed around roles and approved sources. Confidential relationships and documents need appropriate restrictions, including when information appears in search or visual views.' },
  { q: 'How does the information stay current?', a: 'Selected sources can synchronise nightly. The views should show when information was refreshed, flag unsuccessful updates and identify records that need a person to review them.' },
  { q: 'What if our records are incomplete or inconsistent?', a: 'That is a useful starting finding. Missing ownership, conflicting records and unsupported connections should be visible. The map should distinguish confirmed information from gaps rather than silently filling them.' },
  { q: 'What does an initial conversation cover?', a: 'We discuss how your company operates, where knowledge becomes difficult to find, and which process would benefit first. From there, we can define a practical scope and implementation approach.' },
];

const views = [
  { i: 'flow', h: 'How the company operates', p: 'Follow a process from the first enquiry through delivery and follow-up. See the steps, supporting documents and systems involved. This helps a new team member understand the whole workflow rather than learning isolated tasks.' },
  { i: 'person', h: 'Who is responsible for what', p: 'See which role owns a process, who contributes and who approves the outcome. Separate responsibility from system access: being able to open a record does not necessarily mean being accountable for it.' },
  { i: 'broken', h: 'Where single points of failure sit', p: 'Identify work that depends on one person, one source or one system. A visible dependency gives management somewhere to start: document the process, clarify ownership or decide whether additional coverage is needed.' },
  { i: 'network', h: 'Who knows whom', p: 'Explore recorded relationships between the business, clients, partners and projects. Understand where an introduction or previous interaction is documented. A connection should show evidence; it should not imply a relationship simply because two names appear together.' },
  { i: 'feeds', h: 'Which system feeds which', p: 'Understand where information starts and where it is used. See which records feed another system or view, helping the team identify outdated information and understand the consequences of changing a source.' },
];

const steps = [
  { h: 'Start with sources you already use', p: 'Identify the useful information in your CRM, database, document hub and approved operational records. Start with a defined scope rather than collecting everything. Agree which source is authoritative for each type of information.' },
  { h: 'Synchronise selected information overnight', p: 'In this model, approved sources synchronise nightly. The process checks for changes and records whether the update succeeded. A scheduled refresh is not the same as live information, so its timing should remain visible.' },
  { h: 'Organise the records in a database', p: 'Bring the selected information into a consistent structure. Keep its source reference and refresh date, and resolve duplicate or conflicting records carefully. The original systems continue to serve their agreed operational purposes.' },
  { h: 'Build the relationship graph', p: 'Connect roles, processes, systems and other records using explicit relationships. Each connection has supporting evidence, such as a source record or approved process document. Unsupported connections stay unconfirmed, and conflicting evidence prompts review.' },
  { h: 'Present useful views with access by role', p: 'Give authorised users visual views suited to their work, supported by single sign-on where appropriate. An AI assistant can help explain the information, while source links let people check it. Access restrictions must carry through to connected views.' },
];

const industries = [
  { i: 'property', h: 'Property and SDA', p: 'Connect a property review to the responsible roles, information requests, supporting documents and sale preparation process. The team can see what is outstanding without exposing confidential property, investor or participant information in a general view.' },
  { i: 'case', h: 'Professional services', p: 'Map an engagement from enquiry to proposal, delivery, review and invoicing. Link each stage to its owner and current templates. This helps teams hand work over and understand approval requirements without relying on an informal explanation.' },
  { i: 'build', h: 'Construction', p: 'Connect projects, project roles, consultants, document sets and approval stages. Make it clearer which record supports a decision and who owns the next action. The map supports coordination while existing project controls remain in place.' },
  { i: 'heart', h: 'Health and disability providers', p: 'Map organisational responsibilities, service processes, systems and approved partner relationships. Focus on operational continuity and document ownership. Access to personal or sensitive information requires separate consideration; a company map does not justify broader access to it.' },
];

const help = [
  { h: 'Discovery.', p: 'We start with how your company runs: recurring work, handovers, key dependencies and the questions people repeatedly ask. Together, we choose a useful starting scope.' },
  { h: 'Operational map.', p: 'We identify roles, processes, systems and their relationships. We separate documented facts from assumptions and agree who will maintain the information.' },
  { h: 'Build.', p: 'We connect the approved sources and develop the database, relationship graph and visual views around the agreed use cases. We test access, evidence and refresh behaviour alongside the people who will use them.' },
  { h: 'Handover and training.', p: 'We explain how to use the views, check sources and correct information. Your team receives a clear account of ownership, maintenance and known limitations. Implementation detail is worked through in a conversation about your business.' },
];


const ICONS: Record<string, string> = {
  flow: '<circle cx="5" cy="6" r="2"/><circle cx="19" cy="12" r="2"/><circle cx="5" cy="18" r="2"/><path d="M7 6h6a4 4 0 0 1 4 4M7 18h6a4 4 0 0 0 4-4"/>',
  person: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6"/>',
  broken: '<circle cx="5" cy="12" r="2.5"/><circle cx="19" cy="12" r="2.5"/><path d="M7.5 12H10M14 12h2.5M11 8.5l2 7"/>',
  network: '<circle cx="6" cy="7" r="2.5"/><circle cx="18" cy="7" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M8.5 7h7M7.5 9l3.5 7M16.5 9l-3.5 7"/>',
  feeds: '<rect x="3" y="4" width="7" height="6" rx="1.5"/><rect x="14" y="14" width="7" height="6" rx="1.5"/><path d="M10 7h4a3 3 0 0 1 3 3v4M15 12l2 2 2-2"/>',
  property: '<path d="M4 20V9l8-5 8 5v11"/><path d="M9 20v-6h6v6"/>',
  case: '<rect x="3" y="7" width="18" height="12" rx="2"/><path d="M9 7V5h6v2M3 12h18"/>',
  build: '<path d="M4 20h16"/><path d="M7 20V8h6l4 4v8"/><path d="M13 8V4"/>',
  heart: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.4A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
  sources: '<rect x="4" y="3" width="12" height="16" rx="2"/><path d="M8 8h4M8 12h4M18 7v13H8"/>',
  sync: '<path d="M20 12a8 8 0 1 1-2.3-5.7"/><path d="M20 4v4h-4"/>',
  db: '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/>',
  graph: '<circle cx="12" cy="12" r="2.5"/><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="20" r="2"/><path d="M6.5 7.5l4 3M17.5 7.5l-4 3M12 14.5V18"/>',
  views: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>',
};
const flow = [
  { i: 'sources', l: 'Sources' }, { i: 'sync', l: 'Nightly sync' }, { i: 'db', l: 'Database' }, { i: 'graph', l: 'Relationship graph' }, { i: 'views', l: 'Views by role' },
];
// Flag: the "Watch the 2-minute tour" section is hidden until the new video is supplied. Set to true to show it again (the markup and files are kept).
const SHOW_TOUR = false;
const toc = [
  ['s01', 'The problem'], ['s02', 'What it is'], ['s03', 'Five views'], ['s04', 'How it works'],
  ['s05', 'What it is not'], ['s06', 'Where it helps'], ['s07', 'How we help'], ['s08', 'FAQ'],
];

// Text shown on screen in the video, in order, for the transcript.
const transcript = [
  'SDAHC Brain',
  'We built a brain for our company.',
  'Every company runs on knowledge that lives in people’s heads.',
  'SDAHC Brain puts it in one place.',
  'A living map of how SDA Home Choices runs: People, Roles, Processes, Systems, Deals, Investors.',
  'Sources (CRM, Document hub, Operating Map) feed a nightly sync, then a database, a brain build and a 3D map.',
  'Rebuilt every night. Every link carries its evidence.',
  'Click a role. See everything it touches.',
  'Zoom out. The whole company, in one view.',
  'Questions the map answers: Who knows this investor? Who is accountable for this process? Where is a single point of failure? Which buyers have seen this deal?',
  'Who in your team knows this investor best? The brain finds the warmest path.',
  'Every process has an owner. Roles, not people.',
  '11 roles, 39 processes, 28 systems, 29 capabilities, 900+ entities, 1,900+ connections.',
  'Roles, not people. Single sign-on. Default-deny access.',
  'Built for SDA property. Same shape, any industry: your company, clients, partners, projects, products, roles and processes.',
  'Ask us what yours would look like.',
  'A company anyone can operate.',
  'Want to know how we built it? Comment BRAIN or send us a message.',
];

const PATH = '/company-brain/';
const TITLE = 'Company Brain: A Living Map of Your Business | SDAHC';
const DESC = 'See how a company brain connects roles, processes, systems and relationships to support clearer decisions, smoother handovers and business continuity.';
const schema = [
  { '@type': 'WebPage', '@id': `${SITE}${PATH}#page`, url: `${SITE}${PATH}`, name: TITLE, description: DESC, isPartOf: { '@id': WEBSITE_ID }, publisher: { '@id': ORG_ID } },
  faqPage(faqs),
];
---
<BaseLayout title={TITLE} description={DESC} ogImage="/images/og-company-brain.jpg" ogImageAlt="The Company Brain guide: Give your business a brain, with a glowing network of roles, systems and processes." extraFontsHref="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,900&display=swap" breadcrumbs={[{ name: 'Company Brain', path: PATH }]} schema={schema}>
  <BrainHero />

  {SHOW_TOUR && (
  <section class="cb-video" aria-labelledby="tour-title"><div class="wrap">
    <h2 id="tour-title" class="cb-tour-title">Watch the 2-minute tour</h2>
    <figure class="cb-video-frame">
      <video controls preload="none" playsinline muted width="1920" height="1080" poster="/videos/company-brain-poster.jpg" aria-label="We built a brain for our company: a two and a half minute explainer">
        <source src="/videos/company-brain.mp4" type="video/mp4" />
        Your browser does not support embedded video. The explainer is available at <a href="/videos/company-brain.mp4">/videos/company-brain.mp4</a>.
      </video>
    </figure>
    <details class="cb-transcript">
      <summary>Read the video transcript</summary>
      <p class="cb-transcript-note">The video has no voice-over. This is the text shown on screen, in order.</p>
      <ol>
        {transcript.map((line) => <li>{line}</li>)}
      </ol>
      <p class="cb-credit">Music: “Ethereal Relaxation” by Kevin MacLeod (<a href="https://incompetech.com" rel="noopener">incompetech.com</a>). Licensed under Creative Commons: By Attribution 4.0 License, <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">creativecommons.org/licenses/by/4.0</a>.</p>
    </details>
  </div></section>
  )}

  <div class="guide" data-guide>
    <nav class="rail" aria-label="Guide contents">
      <p class="rail-title">Contents</p>
      <ol>
        {toc.map(([id, label], i) => <li><a href={`#${id}`} data-toc={id}><span class="rn">{String(i + 1).padStart(2, '0')}</span>{label}</a></li>)}
      </ol>
    </nav>

    <div class="guide-body">
      <section id="s01" class="g-sec" aria-labelledby="t01">
        <header class="g-head"><span class="g-num" data-num="01" aria-hidden="true"></span><p class="g-label">The problem</p><h2 id="t01">When the business depends on what someone remembers</h2></header>
        <p>Every business develops knowledge that never quite makes it into a system.</p>
        <p>Someone knows why a process changed. Someone else remembers which adviser helped with a similar project. A team member knows where the current document lives, while a new colleague finds an older version.</p>
        <p>The information exists, but finding it depends on asking the right person.</p>
        <p>That creates interruptions, slow handovers and uncertainty about who should act next. As the business grows, the same people become the answer to more questions. Leave, staff changes or a business sale can expose how much knowledge sits outside the formal records.</p>
        <p>A Company Brain makes that knowledge easier to locate, understand and maintain.</p>
      </section>

      <section id="s02" class="g-sec" aria-labelledby="t02">
        <header class="g-head"><span class="g-num" data-num="02" aria-hidden="true"></span><p class="g-label">What it is</p><h2 id="t02">What is a Company <em class="b">Brain</em>?</h2></header>
        <p>A company brain is a living map of the relationships that explain a business: people organised by role, processes, systems, clients, partners and projects.</p>
        <p>It connects those elements to the records that support them. A process links to its responsible role, the systems it uses and the documents that explain it. A project links to the people and relationships involved.</p>
        <p>At SDAHC, developing this approach began with a practical question: how can a business explain the way it operates without relying on one person to describe every connection?</p>
        <p>The purpose is continuity, clearer responsibility and more informed decisions.</p>
      </section>

      <section id="s03" class="g-sec" aria-labelledby="t03">
        <header class="g-head"><span class="g-num" data-num="03" aria-hidden="true"></span><p class="g-label">Five views</p><h2 id="t03">Five views of the same business</h2></header>
        <ol class="g-cards g-cards-3">
          {views.map((v, i) => (
            <li class="g-card">
              <svg class="g-icon" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONS[v.i]}></svg>
              <h3>{i + 1}. {v.h}</h3>
              <p>{v.p}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="s04" class="g-sec" aria-labelledby="t04">
        <header class="g-head"><span class="g-num" data-num="04" aria-hidden="true"></span><p class="g-label">How it works</p><h2 id="t04">How it works, at a high level</h2></header>
        <ol class="flow" data-flow aria-label="The five stages, from approved sources to views by role">
          {flow.map((f, i) => (
            <li style={`--i:${i}`}>
              <span class="fn"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONS[f.i]}></svg></span>
              <span class="fl">{f.l}</span>
            </li>
          ))}
        </ol>
        <ol class="g-steps">
          {steps.map((st, i) => (
            <li>
              <h3>Step {i + 1}: {st.h}</h3>
              <p>{st.p}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="s05" class="g-sec" aria-labelledby="t05">
        <header class="g-head"><span class="g-num" data-num="05" aria-hidden="true"></span><p class="g-label">What it is not</p><h2 id="t05">It does not replace your CRM</h2></header>
        <p>Your CRM continues to manage customer records and activity. Your document hub continues to hold documents. A company brain connects their operational meaning, making it easier to understand where information belongs and how it supports work.</p>
        <p>It is not another dashboard. A dashboard may show a result; a company brain helps explain the responsibilities, relationships and systems behind it.</p>
        <p>The value comes from those connections and their evidence. A sophisticated visual presentation cannot compensate for unclear ownership or unreliable records.</p>
      </section>

      <section id="s06" class="g-sec" aria-labelledby="t06">
        <header class="g-head"><span class="g-num" data-num="06" aria-hidden="true"></span><p class="g-label">Where it helps</p><h2 id="t06">Where the approach can help</h2></header>
        <p>The following examples are illustrative, not descriptions of our internal records.</p>
        <div class="g-cards g-cards-2">
          {industries.map((x) => (
            <div class="g-card">
              <svg class="g-icon" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONS[x.i]}></svg>
              <h3>{x.h}</h3>
              <p>{x.p}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="s07" class="g-sec" aria-labelledby="t07">
        <header class="g-head"><span class="g-num" data-num="07" aria-hidden="true"></span><p class="g-label">How we help</p><h2 id="t07">How we help</h2></header>
        <ul class="g-help">
          {help.map((x) => <li><strong>{x.h}</strong> {x.p}</li>)}
        </ul>
      </section>

      <section id="s08" class="g-sec" aria-labelledby="t08">
        <header class="g-head"><span class="g-num" data-num="08" aria-hidden="true"></span><p class="g-label">FAQ</p><h2 id="t08">Frequently asked questions</h2></header>
        <div class="g-faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </div>

  <button class="toc-chip" type="button" data-toc-open aria-haspopup="dialog" hidden>Contents</button>
  <dialog class="toc-sheet" data-toc-sheet aria-label="Guide contents">
    <div class="toc-head"><p>Contents</p><button type="button" data-toc-close aria-label="Close contents">Close</button></div>
    <ol>
      {toc.map(([id, label], i) => <li><a href={`#${id}`} data-toc={id}><span class="rn">{String(i + 1).padStart(2, '0')}</span>{label}</a></li>)}
    </ol>
  </dialog>

  <section class="cb-final" data-final>
    <div class="wrap cb-final-inner">
      <h2>Want a brain for your business?<br />Tell us how your company runs.</h2>
      <p class="cb-lead">Start with the questions your team struggles to answer, the handovers that take too long or the knowledge that depends on one person.</p>
      <p><a class="btn b1" href="/contact-us/">Tell us about your business</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const sections = [...document.querySelectorAll<HTMLElement>('.g-sec')];
  const setActive = (id: string) => links.forEach((a) => (a.dataset.toc === id ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
  const spy = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) setActive(e.target.id); }), { rootMargin: '-30% 0px -62% 0px' });
  sections.forEach((s) => spy.observe(s));

  // Contents chip (small screens): only while the guide is on screen
  const chip = document.querySelector<HTMLButtonElement>('[data-toc-open]');
  const sheet = document.querySelector<HTMLDialogElement>('[data-toc-sheet]');
  const guide = document.querySelector('[data-guide]');
  if (chip && sheet && guide) {
    new IntersectionObserver(([e]) => { chip.hidden = !e.isIntersecting; }, { rootMargin: '-80px 0px -80px 0px' }).observe(guide);
    chip.addEventListener('click', () => sheet.showModal());
    sheet.querySelector('[data-toc-close]')?.addEventListener('click', () => sheet.close());
    sheet.addEventListener('click', (e) => { if (e.target === sheet) sheet.close(); });
    sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => sheet.close()));
  }

  // The five-stage diagram plays once when it enters the screen
  const flow = document.querySelector('[data-flow]');
  if (flow && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    flow.classList.add('armed');
    new IntersectionObserver(([e], o) => { if (e.isIntersecting) { flow.classList.add('in'); o.disconnect(); } }, { threshold: 0.4 }).observe(flow);
  } else flow?.classList.add('in');
</script>

<style>
.cb-video{padding:8px 0 64px;background:var(--navy)}
.cb-tour-title{font-family:var(--cond);font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--paper);font-size:clamp(26px,3.6vw,40px);line-height:1;margin:0 0 22px;text-align:center}
.cb-video-frame{margin:0;border-radius:10px;overflow:hidden;border:1px solid color-mix(in srgb,var(--pale) 18%,transparent);background:#000}
.cb-video-frame video{display:block;width:100%;height:auto;aspect-ratio:16/9}
.cb-video-frame video a{color:var(--pale)}
.cb-transcript{margin-top:18px;border-top:1px solid rgba(185,203,224,.16);border-bottom:1px solid rgba(185,203,224,.16);padding:16px 0;color:var(--pale)}
.cb-transcript summary{cursor:pointer;font-family:var(--geo);font-size:15px;font-weight:600;color:#fff;letter-spacing:.01em}
.cb-transcript ol{margin:14px 0 0;padding-left:22px;line-height:1.6;font-size:15.5px}
.cb-transcript li{margin:0 0 8px}
.cb-transcript-note{margin:14px 0 0;color:var(--pale);font-size:14px}
.cb-credit{margin:18px 0 0;font-size:14px;color:var(--pale)}
.cb-credit a{color:var(--pale);text-underline-offset:2px}

/* guide: reading sections on paper, with a contents rail on wide screens */
.guide{background:var(--paper);color:var(--slate);padding:56px 30px 40px}
.guide-body{max-width:820px;margin:0 auto}
.rail{display:none}
.g-sec{padding:40px 0 48px;border-top:1px solid color-mix(in srgb,var(--navy) 12%,transparent)}
.g-sec:first-child{border-top:0;padding-top:0}
.g-sec p{font-size:18px;line-height:1.7;margin:0 0 18px;color:var(--slate)}
.g-head{margin:0 0 22px}
.g-num{display:block;font-family:var(--cond);font-weight:700;font-size:clamp(84px,12vw,150px);line-height:.85;color:var(--amber);letter-spacing:.01em}
.g-num::before{content:attr(data-num)}
.g-label{font-family:var(--cond);font-weight:600;text-transform:uppercase;letter-spacing:.14em;font-size:15px;color:var(--slate);margin:8px 0 8px!important}
.g-head h2{font-family:var(--serif);font-weight:600;color:var(--navy);font-size:clamp(28px,4vw,42px);line-height:1.1;margin:0}
.g-head h2 .b,.cb-final h2 .b{font-family:var(--serif);font-style:italic;font-weight:600;color:var(--amber-ink)}
.g-cards{list-style:none;margin:0;padding:0;display:grid;gap:16px}
.g-cards-3{grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
.g-cards-2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr));margin-top:22px}
.g-card{padding:24px 22px;background:#fff;border:1px solid color-mix(in srgb,var(--navy) 12%,transparent);border-radius:10px;box-shadow:0 10px 26px rgba(0,22,43,.06)}
.g-icon{display:block;color:var(--blue);margin-bottom:14px}
.g-card h3{font-family:var(--serif);font-weight:600;color:var(--navy);font-size:19px;line-height:1.25;margin:0 0 10px}
.g-card p{font-size:15.5px;line-height:1.6;margin:0;color:var(--slate)}
.g-steps{list-style:none;margin:30px 0 0;padding:0;display:grid;gap:22px}
.g-steps h3{font-family:var(--serif);font-weight:600;color:var(--navy);font-size:20px;margin:0 0 6px}
.g-steps p{font-size:17px;margin:0}
.g-help{list-style:none;margin:0;padding:0;display:grid;gap:14px}
.g-help li{padding:20px 22px;background:#fff;border:1px solid color-mix(in srgb,var(--navy) 12%,transparent);border-left:3px solid var(--blue);border-radius:6px;font-size:17px;line-height:1.65;color:var(--slate)}
.g-help strong{font-family:var(--serif);color:var(--navy);font-size:19px}
.g-faq{border-top:1px solid color-mix(in srgb,var(--navy) 14%,transparent)}
.g-faq details{border-bottom:1px solid color-mix(in srgb,var(--navy) 14%,transparent);padding:18px 0}
.g-faq summary{cursor:pointer;font-family:var(--geo);font-size:16px;font-weight:600;color:var(--navy);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:14px}
.g-faq summary::-webkit-details-marker{display:none}
.g-faq summary::after{content:"+";font-family:var(--sans);font-size:22px;line-height:1;color:var(--slate);transition:transform .2s ease}
.g-faq details[open] summary::after{transform:rotate(45deg)}
.g-faq details p{margin:14px 0 0}

/* the five-stage diagram */
.flow{list-style:none;margin:8px 0 0;padding:0;display:grid;grid-template-columns:repeat(5,1fr);gap:0;counter-reset:f}
.flow li{position:relative;display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;transition:opacity .6s ease,transform .6s cubic-bezier(.2,.7,.2,1);transition-delay:calc(var(--i) * .28s)}
.flow.armed li{opacity:0;transform:translateY(14px)}
.flow.armed.in li{opacity:1;transform:none}
.fn{display:grid;place-items:center;width:64px;height:64px;border-radius:50%;background:var(--navy);color:var(--paper);border:2px solid var(--blue);position:relative;z-index:1}
.fl{font-family:var(--cond);font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:15px;line-height:1.15;color:var(--navy);max-width:11ch}
.flow li:not(:last-child)::before{content:"";position:absolute;top:31px;left:calc(50% + 34px);width:calc(100% - 68px);height:2px;background:linear-gradient(90deg,var(--blue),var(--blue)) left/0 100% no-repeat,color-mix(in srgb,var(--navy) 16%,transparent);transition:background-size .5s ease;transition-delay:calc(var(--i) * .28s + .25s)}
.flow li:not(:last-child)::before{background-size:100% 100%,auto}
.flow.armed li:not(:last-child)::before{background-size:0 100%,auto}
.flow.armed.in li:not(:last-child)::before{background-size:100% 100%,auto}
.flow li:not(:last-child)::after{content:"";position:absolute;top:27px;left:calc(50% + 34px);width:10px;height:10px;border-radius:50%;background:var(--amber);opacity:0}
@media(prefers-reduced-motion:no-preference){.flow.in li:not(:last-child)::after{animation:dot 2.8s ease-in-out infinite;animation-delay:calc(var(--i) * .28s + .9s)}}
@keyframes dot{0%{opacity:0;left:calc(50% + 34px)}15%{opacity:1}85%{opacity:1}100%{opacity:0;left:calc(150% - 44px)}}

.toc-chip{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:50;font-family:var(--geo);font-size:14px;font-weight:600;letter-spacing:.04em;color:#fff;background:var(--navy2);border:1px solid rgba(185,203,224,.35);border-radius:999px;padding:12px 18px;box-shadow:0 8px 24px rgba(0,10,25,.35);cursor:pointer}
.toc-chip[hidden]{display:none}
.toc-sheet{margin:auto 0 0;width:100%;max-width:none;border:0;border-radius:16px 16px 0 0;background:var(--paper);color:var(--navy);padding:18px 22px calc(22px + env(safe-area-inset-bottom,0px))}
.toc-sheet::backdrop{background:rgba(0,22,43,.55)}
.toc-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.toc-head p{font-family:var(--cond);font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:15px;margin:0;color:var(--slate)}
.toc-head button{font-family:var(--geo);font-size:14px;font-weight:600;background:none;border:0;color:var(--navy);padding:10px 4px;cursor:pointer}
.toc-sheet ol,.rail ol{list-style:none;margin:0;padding:0}
.toc-sheet a,.rail a{display:flex;gap:12px;align-items:baseline;text-decoration:none;color:var(--navy);padding:12px 4px;font-family:var(--sans);font-size:17px}
.rn{font-family:var(--cond);font-weight:700;color:var(--amber-ink);min-width:1.6em}
a[aria-current="location"]{font-weight:700}

.cb-final{padding:80px 0 110px;text-align:center;background:radial-gradient(120% 130% at 12% 0%,#0b4a86 0%,rgba(11,74,134,0) 55%),linear-gradient(160deg,var(--navy2) 0%,var(--navy) 78%)}
/* the closing title is exactly two lines (one phrase each) at every width; the lead is one line from 1280px up */
.cb-final-inner h2{font-family:var(--serif);font-weight:600;color:#fff;font-size:clamp(16px,5.2vw,46px);line-height:1.15;margin:0 auto;white-space:nowrap}
.cb-final-inner p{color:var(--pale);margin:20px auto 0;line-height:1.6}
.cb-final-inner .cb-lead{max-width:60ch;font-size:clamp(16px,1.25vw,20px)}
.cb-final-inner .btn{margin-top:10px}
@media(min-width:1280px){.cb-final-inner .cb-lead{white-space:nowrap;max-width:none;width:max-content;position:relative;left:50%;transform:translateX(-50%)}}

@media(min-width:1100px){
  .guide{display:grid;grid-template-columns:200px minmax(0,820px);gap:0 60px;justify-content:center;padding:72px 30px 56px}
  .guide-body{margin:0}
  .rail{display:block;position:sticky;top:calc(var(--nav-clearance) + 8px);align-self:start}
  .rail-title{font-family:var(--cond);font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:15px;color:var(--slate);margin:0 0 10px}
  .rail a{font-size:16px;padding:8px 0 8px 12px;border-left:2px solid color-mix(in srgb,var(--navy) 14%,transparent)}
  .rail a[aria-current="location"]{border-left-color:var(--amber);color:var(--navy)}
  .toc-chip{display:none!important}
}
@media(max-width:700px){
  .flow{grid-template-columns:1fr;gap:6px;max-width:260px;margin:8px auto 0}
  .flow li{flex-direction:row;text-align:left;gap:16px;padding-bottom:30px}
  .fl{max-width:none;font-size:17px}
  .flow li:not(:last-child)::before{top:64px;left:31px;width:2px;height:calc(100% - 64px);background:linear-gradient(180deg,var(--blue),var(--blue)) top/100% 0 no-repeat,color-mix(in srgb,var(--navy) 16%,transparent)}
  .flow li:not(:last-child)::before{background-size:100% 100%,auto}
  .flow.armed li:not(:last-child)::before{background-size:100% 0,auto}
  .flow.armed.in li:not(:last-child)::before{background-size:100% 100%,auto}
  .flow li:not(:last-child)::after{display:none}
}
@media(prefers-reduced-motion:reduce){.flow li,.flow li::before{transition:none}.flow li::after{animation:none!important}.g-faq summary::after{transition:none}}
</style>
