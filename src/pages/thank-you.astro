---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { REPORTS } from '../data/research-reports';

// Only reports with a `pdf` entry are eligible for the auto-download here; `providers` has none,
// so its PDF (which doesn't exist yet) is never referenced or exposed on this page.
const downloads = Object.fromEntries(
  Object.entries(REPORTS)
    .filter(([, r]) => r.pdf)
    .map(([id, r]) => [id, { href: r.pdf!.href, filename: r.pdf!.filename, label: r.pdf!.downloadLabel }])
);
---
<BaseLayout title="Thank You | SDA Home Choices" description="Thank you for reaching out to SDA Home Choices. We've received your request and our team will be in touch shortly.">
  <PageHeader
    title="Thank you"
  />
  <section class="section"><div class="prose">
    <p id="msg-default">Thank you for reaching out! We've received your request, and our team will be in touch shortly. We look forward to working with you!</p>
    <p id="msg-report" style="display:none">Your download is starting. If it doesn't begin automatically, <a href="/sda-market-report-2026.pdf" id="report-link">download the report (PDF)</a>.</p>
    <p class="thankyou-links">
      <a href="/research/">Explore SDAHC Research</a>
      <a href="/our-services-and-expertise/">Explore our services</a>
      <a href="/">Back to the homepage</a>
    </p>
  </div></section>
</BaseLayout>

<style>
.thankyou-links{display:flex;flex-wrap:wrap;gap:8px 22px}
</style>

<!-- CSP note: this inline script is allow-listed in vercel.json by exact sha256 hash. Editing it requires recomputing and updating that hash, or the CSP will silently block it. -->
<script define:vars={{ downloads }}>
  const reportKey = new URLSearchParams(window.location.search).get('report');
  const report = reportKey ? downloads[reportKey] : undefined;
  if (report) {
    document.getElementById('msg-default').style.display = 'none';
    const msgReport = document.getElementById('msg-report');
    msgReport.style.display = '';
    const link = document.getElementById('report-link');
    link.href = report.href;
    link.textContent = `download the ${report.label} (PDF)`;
    setTimeout(() => {
      const a = document.createElement('a');
      a.href = link.href;
      a.download = report.filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
    }, 600);
  }
</script>
