  </div></section>
  <section class="section"><div class="prose">
    <h2>Key figures</h2>
    <table>
      <thead><tr><th>Measure</th><th>Figure</th></tr></thead>
      <tbody>
      <tr><td>Enrolled dwellings</td><td>176</td></tr>
      <tr><td>Participants in SDA</td><td>130</td></tr>
      <tr><td>SDA funding committed</td><td>$7.9M</td></tr>
      <tr><td>Active providers</td><td>17</td></tr>
      </tbody>
    </table>

    <h2>Enrolled dwellings by SA4 region</h2>
    <table>
      <thead><tr><th>Region</th><th>Enrolled dwellings</th></tr></thead>
