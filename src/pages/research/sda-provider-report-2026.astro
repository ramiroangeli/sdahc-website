---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReportGate from '../../components/ReportGate.astro';
import ResearchFloatingCover from '../../components/ResearchFloatingCover.astro';
import ResearchSectionHeader from '../../components/ResearchSectionHeader.astro';
import ResearchFeatureGrid from '../../components/ResearchFeatureGrid.astro';
import ResearchPublicationCard from '../../components/ResearchPublicationCard.astro';
import { REPORTS } from '../../data/research-reports';

const report = REPORTS.providers;
const title = 'SDA Provider Report 2026 | SDA Home Choices';
const description = "The SDA Provider Report is in development. Register your interest with SDAHC Research to be notified when it's published.";

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const absolute = (path: string) => new URL(path, Astro.site).href;

// No Report/CreativeWork schema here: the publication does not exist yet, so nothing beyond the
// page itself and its place in the site should be described as though it did.
const webPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  url: canonical,
  description,
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: 'Research', item: absolute('/research/') },
    { '@type': 'ListItem', position: 3, name: report.fullTitle, item: canonical },
  ],
};
---
<BaseLayout title={title} description={description}>
  <section class="rpt-hero section">
    <div class="wrap rpt-hero-grid">
      <div class="rpt-hero-copy">
        <p class="eyebrow">SDAHC Research</p>
        <h1 class="rpt-h1">A commercial view of Australia's SDA providers, in development.</h1>
        <p class="rpt-standfirst">SDAHC Research is developing a dedicated report on the commercial landscape of SDA providers across Australia. No publication date is confirmed. Register your interest and we'll notify you when it's released.</p>
        <p class="rpt-meta"><span class="rpt-year">{report.year}</span><span class="rpt-status rpt-status-coming-soon">In development</span></p>
        <p class="rpt-cta"><a class="btn b1" href="#access">Register your interest</a></p>
      </div>
      <div class="rpt-hero-cover">
        <ResearchFloatingCover id="providers" />
      </div>
    </div>
  </section>

  <section class="section rpt-about">
    <div class="wrap">
      <ResearchSectionHeader eyebrow="About the publication" heading="Why this report is being developed" />
      <p class="rpt-copy">SDAHC's existing research separates the SDA property asset from the SDA provider business operating within it, a distinction that matters most clearly during distress, but applies across the whole market. The SDA Provider Report will extend that commercial lens to the provider landscape generally: how providers are structured, how they're assessed, and what influences the commercial standing of a provider business. It has not been published, and this page does not represent its findings.</p>
    </div>
  </section>

  <section class="section rpt-topics">
    <div class="wrap">
      <ResearchSectionHeader eyebrow="Planned scope" heading="What the report will explore" lead="These are the areas the report is being developed to address, not findings from a completed publication." />
      <ResearchFeatureGrid items={[
        { title: 'Provider registration and participant relationships', description: 'How provider registration, service agreements and participant relationships shape a provider business.' },
        { title: 'Claiming and rent-roll quality', description: 'What distinguishes a well-run provider rent roll from one carrying hidden commercial risk.' },
        { title: 'Provider scale, reputation and reach', description: 'How scale, reputation and geographic reach influence a provider business commercially.' },
        { title: 'Consolidation and strategic transactions', description: 'The commercial dynamics behind consolidation, restructuring and strategic transactions among SDA providers.' },
      ]} />
    </div>
  </section>

  <section class="section rpt-audience">
    <div class="wrap">
      <ResearchSectionHeader eyebrow="Who it's for" heading="Built for the provider market" />
      <ResearchFeatureGrid items={[
        { title: 'SDA housing providers and their boards', description: 'Benchmarking their own provider business against the broader market.' },
        { title: 'Property investors and fund managers', description: 'Assessing provider quality as part of an SDA investment decision.' },
        { title: 'Lenders and advisers', description: 'Needing commercial context on provider businesses, not just the underlying property.' },
        { title: 'Organisations considering consolidation', description: 'Weighing a merger, restructuring or strategic transaction in the provider market.' },
      ]} />
    </div>
  </section>

  <ReportGate reportIds={['providers']} id="access" />

  <section class="section rpt-methodology">
    <div class="wrap">
      <ResearchSectionHeader eyebrow="Methodology" heading="How this report will be built" />
      <p class="rpt-copy">Once published, this report will draw on the same combination of public data, transaction evidence and SDAHC's own commercial experience used across SDAHC Research publications, including the <a href="/research/sda-market-report-2026/">SDA Market Report 2026</a>. See the site-wide <a href="/research/research-methodology/">research methodology</a> for how SDAHC Research approaches its publications generally.</p>
    </div>
  </section>

  <section class="section rpt-bridge bg-glow-bc">
    <div class="wrap">
      <ResearchSectionHeader heading="Considering a provider transaction now?" />
      <p class="rpt-copy">If you're assessing a provider business, consolidation or strategic transaction today, you don't need to wait for this report. See our <a href="/sda-strategic-divestment-advisory/">strategic divestment advisory</a> service, or the full <a href="/our-services-and-expertise/">services and expertise</a> overview.</p>
    </div>
  </section>

  <section class="section rpt-related">
    <div class="wrap">
      <ResearchSectionHeader eyebrow="More from SDAHC Research" heading="Related publications" />
      <div class="rpt-related-grid">
        <ResearchPublicationCard id="sda2026" />
        <ResearchPublicationCard id="special" />
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(webPage)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
</BaseLayout>
<style>
.rpt-hero{padding-top:calc(150px + var(--nav-top))}
.rpt-hero-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:center}
.rpt-h1{font-family:var(--serif);font-weight:600;color:#fff;font-size:clamp(32px,4.6vw,52px);line-height:1.08;letter-spacing:-.01em;margin:0 0 22px;max-width:18ch}
.rpt-standfirst{font-family:var(--sans);color:var(--pale);font-size:clamp(16px,1.6vw,19px);line-height:1.55;max-width:56ch;margin:0 0 22px}
.rpt-meta{display:flex;align-items:center;gap:12px;margin:0 0 28px;font-family:var(--geo);font-size:12px;letter-spacing:.1em;text-transform:uppercase}
.rpt-year{color:var(--muted)}
.rpt-status{padding:3px 10px;border-radius:999px;font-size:11px}
.rpt-status-published{color:var(--teal);background:rgba(47,160,168,.12)}
.rpt-status-coming-soon{color:var(--amber);background:rgba(201,122,10,.12)}
.rpt-copy{max-width:74ch;color:var(--pale);font-size:17px;line-height:1.7;margin:0}
.rpt-copy a{color:var(--blue);text-decoration:underline;text-underline-offset:2px}
.rpt-related-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
@media(max-width:980px){
  .rpt-hero-grid{grid-template-columns:1fr;gap:36px}
  .rpt-hero-cover{order:-1}
  .rpt-related-grid{grid-template-columns:1fr}
}
</style>
