---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchSectionHeader from '../../components/ResearchSectionHeader.astro';
import ResearchFloatingCover from '../../components/ResearchFloatingCover.astro';
import ResearchResourceCard from '../../components/ResearchResourceCard.astro';
import ResearchStateGrid from '../../components/ResearchStateGrid.astro';
import ResearchDwellerRibbon from '../../components/ResearchDwellerRibbon.astro';
import { REPORTS } from '../../data/research-reports';
import '../../styles/research-tokens.css';

const title = 'SDA Research Hub: Market Reports & Sector Analysis | SDA Home Choices';
const description = "SDAHC Research publishes market analysis, transaction intelligence and evidence-based insight into Australia's Specialist Disability Accommodation sector, including the SDA Market Report 2026 and state-by-state data.";

// Set C (interface) fonts plus the Set A (editorial) and metadata faces this page needs beyond
// the corporate set already loaded by BaseLayout. Opt-in via extraFontsHref so no other page
// requests these. Query params copied directly from the approved Stage 2 v2 source document's
// own (working) Google Fonts link, so the variable axes requested (Bricolage Grotesque's wdth,
// Source Serif 4's italic-only opsz range) match what those fonts actually expose.
const researchFontsHref = "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Source+Serif+4:ital,opsz,wght@1,8..60,400&family=Plus+Jakarta+Sans:wght@800&family=IBM+Plex+Mono:wght@400;500&display=swap";

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const absolute = (path: string) => new URL(path, Astro.site).href;

// CollectionPage + ItemList describe this page as a hub of publications, not a single article.
// The provider report has no `url` entry here (schema.org ListItem.url is optional) since it has
// no live destination yet: structured data must not present a future page as an existing one.
const collectionPage = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'SDAHC Research',
  url: canonical,
  description,
  isPartOf: { '@type': 'WebSite', url: Astro.site?.href },
  about: "Specialist Disability Accommodation (SDA) market research, Australia",
};
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'SDAHC Research publications',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: REPORTS.sda2026.fullTitle, url: absolute(REPORTS.sda2026.url) },
    { '@type': 'ListItem', position: 2, name: REPORTS.special.fullTitle, url: absolute(REPORTS.special.url) },
    { '@type': 'ListItem', position: 3, name: REPORTS.providers.fullTitle, description: 'In development; pre-registration will open in a future release.' },
  ],
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: 'Research', item: canonical },
  ],
};
---
<BaseLayout title={title} description={description} extraFontsHref={researchFontsHref}>
  <!-- Compact hero: headline only. No standfirst/tagline and no graphic, so the floating report
       covers in the Publications section below are the first screen's primary visual focus. -->
  <section class="rhub-hero r-grain-dark">
    <div class="wrap rhub-hero-inner">
      <p class="rhub-eyebrow">SDAHC Research</p>
      <h1 class="rhub-h1"><span class="rhub-h1-line">Commercial intelligence for</span><span class="rhub-h1-line rhub-h1-accent">Australia's SDA market</span></h1>
    </div>
  </section>

  <section class="section rhub-publications rhub-paper" id="publications">
    <div class="wrap">
      <!-- Compact intro: a small eyebrow label carries the section's own heading as a
           visually-hidden h2 for semantics/a11y, since the Design System's large heading+lead
           pattern (ResearchSectionHeader) cost too much vertical space before the covers. The
           eyebrow markup/classes (.r-eyebrow/.r-eyebrow-rule) and their styling are shared with
           ResearchSectionHeader via research-tokens.css (see that file), not duplicated here, so
           this label is visually identical to "02 · Online research" and the other numbered
           section labels below it. -->
      <div class="rhub-pub-head">
        <p class="r-eyebrow"><span class="r-eyebrow-rule" aria-hidden="true"></span>01 · Our publications</p>
        <h2 class="rhub-sr-only">Research Publications</h2>
      </div>
      <div class="rhub-showcase">
        <ResearchFloatingCover id="sda2026" href={REPORTS.sda2026.url} caption />
        <ResearchFloatingCover id="special" href={REPORTS.special.url} caption />
        <ResearchFloatingCover id="providers" href={REPORTS.providers.url} caption />
      </div>
    </div>
  </section>

  <section class="section rhub-explore rhub-paper">
    <div class="wrap">
      <ResearchSectionHeader
        variant="hub"
        number="02"
        eyebrow="Online research"
        heading="Explore the SDA Market"
        lead="Key findings from the SDA Market Report 2026, published as standalone pages."
      />
      <div class="rhub-resource-grid">
        <ResearchResourceCard
          href="/sda-statistics/"
          title="Australian SDA Statistics"
          description="Key figures, definitions and quarterly data for the national SDA sector."
        />
        <ResearchResourceCard
          href="/research/national-snapshot/"
          title="National Snapshot"
          description="A national overview of supply, demand and participant growth across Australia."
        />
        <ResearchResourceCard
          href="/research/executive-summary/"
          title="Executive Summary"
          description="The Market Report 2026's key findings in brief, for readers short on time."
        />
        <ResearchResourceCard
          href="/research/research-methodology/"
          title="Research Methodology"
          description="How we source, verify and interpret the data behind our publications."
        />
      </div>
    </div>
  </section>

  <section class="section rhub-states rhub-paper">
    <!-- Second graphic intervention: the same curve's middle bend, entering from the section's
         own top-right edge. Purely decorative (aria-hidden) and never covers the heading, lead
         or state grid: it sits above and clear of the text column, not layered behind it. -->
    <div class="rhub-states-band" aria-hidden="true"><ResearchDwellerRibbon variant="band" /></div>
    <div class="wrap">
      <ResearchSectionHeader
        variant="hub"
        number="03"
        eyebrow="Jurisdictional data"
        heading="State & Territory Intelligence"
        lead="State-level analysis drawn from the SDA Market Report 2026: enrolled dwellings, participant demand and funding committed by jurisdiction."
      />
      <ResearchStateGrid />
    </div>
  </section>

  <section class="section rhub-approach rhub-paper">
    <div class="wrap">
      <!-- Third, closing intervention: a small Ember-toned flourish beside the heading, bookending
           the opening mark in the publications callout. In normal document flow (flex row, not
           absolute positioning), so it never overlaps text and reflows naturally on mobile. -->
      <div class="rhub-approach-head">
        <ResearchSectionHeader variant="hub" number="04" eyebrow="Methodology" heading="Research Approach" />
        <span class="rhub-approach-mark" aria-hidden="true"><ResearchDwellerRibbon variant="close" /></span>
      </div>
      <p class="rhub-approach-copy">SDAHC Research draws on relevant public datasets, sector observations and SDAHC's own commercial transaction experience. Sources and methodology are stated where applicable, and not every publication necessarily draws on the same data or approach. Read the full <a href="/research/research-methodology/">research methodology</a> for sources and definitions.</p>
    </div>
  </section>

  <section class="section rhub-bridge rhub-paper">
    <div class="wrap">
      <ResearchSectionHeader variant="hub" number="05" eyebrow="Next steps" heading="From market intelligence to informed commercial decisions" />
      <p class="rhub-bridge-copy">Sector-wide research provides useful context: where demand is concentrated, how supply is moving, and what the national picture looks like. An asset-specific decision, buying, selling or holding a particular SDA property, requires closer examination: sustainable income, contracts, enrolment, property condition and market evidence specific to that asset. That is where specialist commercial advice becomes useful.</p>
      <p class="rhub-bridge-links">
        <a class="btn b1" href="/our-services-and-expertise/">Explore our services</a>
        <a class="btn b2" href="/opportunities/">Current opportunities</a>
      </p>
    </div>
  </section>

  <section class="section rhub-about rhub-paper">
    <div class="wrap">
      <ResearchSectionHeader variant="hub" number="06" eyebrow="About" heading="About SDAHC Research" />
      <p class="rhub-about-copy">SDAHC Research is the research and publications initiative of SDA Home Choices, an independent commercial advisory specialising in Specialist Disability Accommodation. It draws on the firm's specialist commercial market experience to produce evidence-based research for investors, providers and other sector participants. Read more <a href="/about/">about SDA Home Choices</a>.</p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(collectionPage)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
</BaseLayout>
<style>
/* ---- Hero: expressive register, Set C, grad-ink-field ----
   Compact by design: headline only, no standfirst/tagline and no graphic, so the floating
   report covers in the Publications section are the page's first visual focus rather than
   competing with a hero graphic above them. */
.rhub-hero{position:relative;overflow:hidden;padding:calc(var(--nav-clearance) + 10px) 0 26px;background:var(--r-grad-ink-field)}
.rhub-hero-inner{position:relative;z-index:1}
/* White, not Signal Blue: grad-ink-field's own documented contrast note says Signal Blue only
   passes reliably at 24px+ near its glow zones, and this eyebrow sits in that zone at 12px. */
.rhub-eyebrow{font-family:var(--r-font-mono);font-size:var(--r-size-meta);letter-spacing:.14em;text-transform:uppercase;color:#FFFFFF;margin:0 0 16px}
.rhub-h1{font-family:var(--r-font-interface);font-weight:800;letter-spacing:-.02em;color:#FFFFFF;font-size:clamp(28px,2vw + 22px,44px);line-height:1.18;margin:0}
/* Each half of the headline is its own block-level line, not a natural wrap point: "Commercial
   intelligence for" always renders as line one in the display sans; "Australia's SDA market"
   always renders as line two, entirely in the Source Serif 4 italic accent (previously applied
   only to the final word), in the same Signal Blue. Both share the h1's own font-size/line-height
   for a coherent scale between the two treatments. */
.rhub-h1-line{display:block}
.rhub-h1-accent{font-family:var(--r-font-serif-accent);font-style:italic;font-weight:400;letter-spacing:0;color:var(--r-signal-blue)}

/* ---- Editorial register: "Paper to read, Ink to frame" ----
   Every section after the hero reads on Warm Paper with Ink/Graphite text, so dark stays
   confined to the hero (roughly one section of seven on this page). Scoped to this page's own
   .rhub-* wrapper classes only: global.css's shared .section/.wrap are untouched, so every other
   page on the site keeps its existing navy background exactly as it is. */
.rhub-paper{background:var(--r-paper);color:var(--r-graphite)}
/* Tight top/bottom padding (overriding .section's default 60px/90px): the Publications section
   is the page's first-screen anchor, so it keeps as much of the floating covers as possible
   above the fold without the showcase itself being shrunk to compensate. */
.rhub-publications{padding-top:18px;padding-bottom:56px}
/* Visually hidden but still in the accessibility tree and document order: the section keeps a
   real h2 for semantics/outline even though its visible heading is now just the small eyebrow
   label to its left. Standard clip-based sr-only technique (not display:none, which would also
   remove it from the accessibility tree). */
.rhub-sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
/* Compact publications intro: just the small eyebrow label (same shared .r-eyebrow styling as
   every other numbered section below it), which is what recovers the vertical space the Design
   System's stacked eyebrow+heading+lead used to cost. 36px bottom margin matches
   ResearchSectionHeader's own .rhub-head spacing so the gap before the showcase reads the same
   as the gap before every other section's content. */
.rhub-pub-head{margin:0 0 36px}
/* A deliberate editorial rule between sections, rather than every Paper section running directly
   into the next with no visual rhythm: the Approach/bridge/About sections that follow another
   Paper section get a top divider; the two sections right after the hero and state grid don't
   need one, since the dark-to-paper and card-grid-to-rule transitions already read as a break. */
.rhub-approach,.rhub-bridge,.rhub-about{border-top:var(--r-rule-divider) solid var(--r-cover-slate)}
/* Third intervention: a small Ember-toned flourish beside the Research Approach heading, in
   normal flex flow (not absolute), so it reflows below the heading on narrow viewports instead
   of risking overlap. */
.rhub-approach-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}
.rhub-approach-mark{flex:0 0 auto;width:34px;height:52px;margin-top:6px;opacity:.65}
.rhub-approach-copy,.rhub-bridge-copy,.rhub-about-copy{max-width:68ch;font-family:var(--r-font-body);color:var(--r-graphite);font-size:var(--r-size-body);line-height:1.65;margin:0}
.rhub-approach-copy a,.rhub-bridge-copy a,.rhub-about-copy a{color:var(--r-signal-deep);text-decoration:underline;text-underline-offset:2px}
.rhub-bridge-links{display:flex;flex-wrap:wrap;gap:14px;margin:30px 0 0}
/* the shared .btn/.b1/.b2 utilities are corporate-navy-toned; on this light section they need
   their own colours rather than inheriting defaults meant for a dark background */
.rhub-bridge .btn.b1{background:var(--r-signal-deep);color:#FFFFFF}
.rhub-bridge .btn.b1:hover{background:var(--r-navy)}
.rhub-bridge .btn.b2{background:transparent;color:var(--r-midnight-ink);border-color:var(--r-cover-slate)}
.rhub-bridge .btn.b2:hover{border-color:var(--r-signal-deep)}

/* Three independent floating covers (ResearchFloatingCover with `caption`), not a card grid:
   a balanced horizontal row with generous gaps so each cover's float/rotation has room to read
   as continuous motion rather than crowding its neighbours. */
.rhub-showcase{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;align-items:start}
/* Slightly smaller than the component's own 320px default: still large enough to recognise each
   cover (not a thumbnail), but the main lever that brings all three covers' full height inside a
   typical 1440x900 first screen alongside the nav and compact hero. */
.rhub-showcase :global(.rfc img){max-width:252px}
.rhub-resource-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}

/* Second intervention: the same curve's middle bend, bleeding in from the section's own top
   edge. Clipped by this section's own overflow:hidden and kept clear of the text column (the
   heading/lead/state grid all start at the .wrap's left edge; this sits top-right, well above
   where ResearchStateGrid's cards begin), and pointer-events:none so it can never intercept
   clicks or sit in the keyboard tab order. */
.rhub-states{position:relative;overflow:hidden}
.rhub-states-band{position:absolute;top:0;right:4%;width:260px;height:170px;opacity:.55;pointer-events:none}

@media(max-width:980px){
  .rhub-resource-grid{grid-template-columns:1fr}
  .rhub-states-band{width:190px;height:125px}
}
@media(max-width:860px){
  .rhub-showcase{grid-template-columns:1fr;gap:52px;max-width:280px;margin:40px auto 0}
}
/* Mobile: the closing mark already sits in normal flex flow, so it wraps beneath the heading on
   its own; the only change needed is retiring the state-grid band, since at this width it would
   sit too close to the heading text to read as a clearly separate decorative layer. */
@media(max-width:560px){
  .rhub-states-band{display:none}
}
</style>
