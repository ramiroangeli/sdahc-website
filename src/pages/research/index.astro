---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchSectionHeader from '../../components/ResearchSectionHeader.astro';
import ResearchPublicationCard from '../../components/ResearchPublicationCard.astro';
import ResearchResourceCard from '../../components/ResearchResourceCard.astro';
import ResearchStateGrid from '../../components/ResearchStateGrid.astro';
import { REPORTS } from '../../data/research-reports';
import '../../styles/research-tokens.css';

const title = 'SDA Research Hub: Market Reports & Sector Analysis | SDA Home Choices';
const description = "SDAHC Research publishes market analysis, transaction intelligence and evidence-based insight into Australia's Specialist Disability Accommodation sector, including the SDA Market Report 2026 and state-by-state data.";

// Set C (interface) fonts plus the Set A (editorial) and metadata faces this page needs beyond
// the corporate set already loaded by BaseLayout. Opt-in via extraFontsHref so no other page
// requests these. Query params copied directly from the approved Stage 2 v2 source document's
// own (working) Google Fonts link, so the variable axes requested (Bricolage Grotesque's wdth,
// Source Serif 4's italic-only opsz range) match what those fonts actually expose.
const researchFontsHref = "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Source+Serif+4:ital,opsz,wght@1,8..60,400&family=Plus+Jakarta+Sans:wght@800&family=IBM+Plex+Mono:wght@400;500&display=swap";

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const absolute = (path: string) => new URL(path, Astro.site).href;

// CollectionPage + ItemList describe this page as a hub of publications, not a single article.
// The provider report has no `url` entry here (schema.org ListItem.url is optional) since it has
// no live destination yet: structured data must not present a future page as an existing one.
const collectionPage = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'SDAHC Research',
  url: canonical,
  description,
  isPartOf: { '@type': 'WebSite', url: Astro.site?.href },
  about: "Specialist Disability Accommodation (SDA) market research, Australia",
};
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'SDAHC Research publications',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: REPORTS.sda2026.fullTitle, url: absolute(REPORTS.sda2026.url) },
    { '@type': 'ListItem', position: 2, name: REPORTS.special.fullTitle, url: absolute(REPORTS.special.url) },
    { '@type': 'ListItem', position: 3, name: REPORTS.providers.fullTitle, description: 'In development; pre-registration will open in a future release.' },
  ],
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: 'Research', item: canonical },
  ],
};
---
<BaseLayout title={title} description={description} extraFontsHref={researchFontsHref}>
  <!-- Hero: text and graphic are two SEPARATE grid columns (not one layered behind the other),
       which is what guarantees the graphic can never cross or sit behind the H1 or standfirst at
       any wrap width or viewport size, without narrowing the full-width H1 to dodge a zone. The
       graphic is a single large composition, not several small isolated ornaments: three
       layered copies of the one approved Dweller Line curve (back, soft and blurred; mid; front,
       crisp, with a Navy -> Research Blue -> Signal Blue gradient stroke) plus a soft depth glow
       behind them, the Dweller Dot on a real point of the curve, and one small Wattle accent dot
       as restrained colour punctuation. Collapses to a single simplified layer below the text on
       narrow viewports (see the responsive rules below). -->
  <section class="rhub-hero r-grain-dark">
    <div class="wrap rhub-hero-grid">
      <div class="rhub-hero-text">
        <p class="rhub-eyebrow">SDAHC Research</p>
        <h1 class="rhub-h1">Commercial intelligence for Australia's Specialist Disability Accommodation <span class="rhub-h1-accent">market</span></h1>
        <p class="rhub-standfirst">SDAHC Research produces market analysis, transaction intelligence and evidence-based insight into Australia's Specialist Disability Accommodation sector, drawing on publicly available industry data alongside SDAHC's specialist commercial market experience.</p>
        <p class="rhub-tagline">Market research. Investment intelligence. Sector analysis.</p>
      </div>
      <div class="rhub-hero-graphic" aria-hidden="true">
        <svg class="rhub-graphic-svg" viewBox="170 -20 260 320" preserveAspectRatio="xMidYMid meet" focusable="false">
          <defs>
            <filter id="rhubRibbonBlur" x="-60%" y="-60%" width="220%" height="220%">
              <feGaussianBlur stdDeviation="9" />
            </filter>
            <linearGradient id="rhubRibbonGrad" x1="0%" y1="100%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="var(--r-navy)" />
              <stop offset="55%" stop-color="var(--r-blue)" />
              <stop offset="100%" stop-color="var(--r-signal-blue)" />
            </linearGradient>
            <radialGradient id="rhubDepthGlow" cx="55%" cy="55%" r="60%">
              <stop offset="0%" stop-color="var(--r-blue)" stop-opacity=".30" />
              <stop offset="100%" stop-color="var(--r-blue)" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="rhubDotGrad" cx="35%" cy="35%" r="65%">
              <stop offset="0%" stop-color="var(--r-signal-blue)" />
              <stop offset="100%" stop-color="var(--r-signal-deep)" />
            </radialGradient>
          </defs>
          <!-- Soft depth glow, centred behind the ribbon, not behind any text (the graphic
               occupies its own grid column, see the structural note above). -->
          <rect x="170" y="-20" width="260" height="320" fill="url(#rhubDepthGlow)" />
          <!-- The one approved Dweller Line curve (M51 106 C49.5 92 50 82 55.5 77.5 C61 73 74 70
               87 57.5), uniformly scaled 4.5x and translated, then extended a short straight
               distance past each endpoint along that endpoint's own tangent so it exits through
               the panel edges. Nothing here is redrawn or restretched: every layer below is the
               identical path, only translated slightly (a rigid offset, not a reshape) and
               restyled, to build a sense of depth rather than a single flat stroke. -->
          <path
            d="M203.21 280 L200 250 C193.25 187 195.5 142 220.25 121.75 C245 101.5 303.5 88 362 31.75 L395 0"
            fill="none" stroke="var(--r-navy)" stroke-opacity=".4" stroke-width="18" stroke-linecap="round" stroke-linejoin="round"
            transform="translate(-10 9)" filter="url(#rhubRibbonBlur)" class="rhub-ribbon-back" data-r-motion
          />
          <path
            d="M203.21 280 L200 250 C193.25 187 195.5 142 220.25 121.75 C245 101.5 303.5 88 362 31.75 L395 0"
            fill="none" stroke="var(--r-blue)" stroke-opacity=".55" stroke-width="13" stroke-linecap="round" stroke-linejoin="round"
            transform="translate(-4 4)" class="rhub-ribbon-mid" data-r-motion
          />
          <path
            d="M203.21 280 L200 250 C193.25 187 195.5 142 220.25 121.75 C245 101.5 303.5 88 362 31.75 L395 0"
            pathLength="1" fill="none" stroke="url(#rhubRibbonGrad)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"
            class="rhub-ribbon-front" data-r-motion
          />
          <!-- Dweller Dot at (245,101.5), a real point already on the curve, not an arbitrary
               position, given a subtle radial highlight for the same dimensional quality as the
               ribbon rather than a flat fill. -->
          <circle cx="245" cy="101.5" r="11" fill="url(#rhubDotGrad)" class="rhub-ribbon-dot" data-r-motion />
          <!-- One small Wattle accent dot, restrained colour punctuation (Wattle on Midnight Ink:
               10.3:1, from the source board's own approved shape/ground contrast table), clear of
               the ribbon and the panel edges. -->
          <circle cx="380" cy="260" r="6" fill="var(--r-wattle)" class="rhub-ribbon-accent" data-r-motion />
        </svg>
      </div>
    </div>
  </section>

  <section class="section rhub-publications rhub-paper" id="publications">
    <div class="wrap">
      <ResearchSectionHeader
        variant="hub"
        number="01"
        eyebrow="Our publications"
        heading="Research Publications"
        lead="Three publications covering the national SDA market, administration and special situations, and the provider landscape."
      />
      <div class="rhub-pub-grid">
        <ResearchPublicationCard id="sda2026" variant="hub" />
        <ResearchPublicationCard id="special" variant="hub" />
        <ResearchPublicationCard id="providers" variant="hub" />
      </div>
    </div>
  </section>

  <section class="section rhub-explore rhub-paper">
    <div class="wrap">
      <ResearchSectionHeader
        variant="hub"
        number="02"
        eyebrow="Online research"
        heading="Explore the SDA Market"
        lead="Key findings from the SDA Market Report 2026, published as standalone pages."
      />
      <div class="rhub-resource-grid">
        <ResearchResourceCard
          href="/sda-statistics/"
          title="Australian SDA Statistics"
          description="Key figures, definitions and quarterly data for the national SDA sector."
        />
        <ResearchResourceCard
          href="/research/national-snapshot/"
          title="National Snapshot"
          description="A national overview of supply, demand and participant growth across Australia."
        />
        <ResearchResourceCard
          href="/research/executive-summary/"
          title="Executive Summary"
          description="The Market Report 2026's key findings in brief, for readers short on time."
        />
        <ResearchResourceCard
          href="/research/research-methodology/"
          title="Research Methodology"
          description="How we source, verify and interpret the data behind our publications."
        />
      </div>
    </div>
  </section>

  <section class="section rhub-states rhub-paper">
    <div class="wrap">
      <ResearchSectionHeader
        variant="hub"
        number="03"
        eyebrow="Jurisdictional data"
        heading="State & Territory Intelligence"
        lead="State-level analysis drawn from the SDA Market Report 2026: enrolled dwellings, participant demand and funding committed by jurisdiction."
      />
      <ResearchStateGrid />
    </div>
  </section>

  <section class="section rhub-approach rhub-paper">
    <div class="wrap">
      <ResearchSectionHeader variant="hub" number="04" eyebrow="Methodology" heading="Research Approach" />
      <p class="rhub-approach-copy">SDAHC Research draws on relevant public datasets, sector observations and SDAHC's own commercial transaction experience. Sources and methodology are stated where applicable, and not every publication necessarily draws on the same data or approach. Read the full <a href="/research/research-methodology/">research methodology</a> for sources and definitions.</p>
    </div>
  </section>

  <section class="section rhub-bridge rhub-paper">
    <div class="wrap">
      <ResearchSectionHeader variant="hub" number="05" eyebrow="Next steps" heading="From market intelligence to informed commercial decisions" />
      <p class="rhub-bridge-copy">Sector-wide research provides useful context: where demand is concentrated, how supply is moving, and what the national picture looks like. An asset-specific decision, buying, selling or holding a particular SDA property, requires closer examination: sustainable income, contracts, enrolment, property condition and market evidence specific to that asset. That is where specialist commercial advice becomes useful.</p>
      <p class="rhub-bridge-links">
        <a class="btn b1" href="/our-services-and-expertise/">Explore our services</a>
        <a class="btn b2" href="/opportunities/">Current opportunities</a>
      </p>
    </div>
  </section>

  <section class="section rhub-about rhub-paper">
    <div class="wrap">
      <ResearchSectionHeader variant="hub" number="06" eyebrow="About" heading="About SDAHC Research" />
      <p class="rhub-about-copy">SDAHC Research is the research and publications initiative of SDA Home Choices, an independent commercial advisory specialising in Specialist Disability Accommodation. It draws on the firm's specialist commercial market experience to produce evidence-based research for investors, providers and other sector participants. Read more <a href="/about/">about SDA Home Choices</a>.</p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(collectionPage)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
</BaseLayout>
<style>
/* ---- Hero: expressive register, Set C, grad-ink-field ----
   Text and graphic are two separate grid columns (not one layered behind the other). That is a
   deliberate structural choice, not a styling detail: it is what guarantees the graphic can
   never visually cross or sit behind the H1 or standfirst, however the full-width H1 wraps at a
   given viewport width, rather than relying on z-index or a guessed-safe pixel zone. */
.rhub-hero{position:relative;overflow:hidden;padding:calc(150px + var(--nav-top)) 0 64px;background:var(--r-grad-ink-field)}
.rhub-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.3fr 1fr;gap:48px;align-items:center}
/* White, not Signal Blue: grad-ink-field's own documented contrast note says Signal Blue only
   passes reliably at 24px+ near its glow zones, and this eyebrow sits in that zone at 12px. */
.rhub-eyebrow{font-family:var(--r-font-mono);font-size:var(--r-size-meta);letter-spacing:.14em;text-transform:uppercase;color:#FFFFFF;margin:0 0 22px}
.rhub-h1{font-family:var(--r-font-interface);font-weight:800;letter-spacing:-.02em;color:#FFFFFF;font-size:clamp(36px,4.2vw,58px);line-height:1.05;margin:0;max-width:none}
/* The one typographic accent: the final word, Source Serif 4 italic in Signal Blue, echoing the
   same bold-sans/italic-serif pairing the brand's own "SDAHC | Research" wordmark uses, rather
   than a generic highlight colour applied for its own sake. */
.rhub-h1-accent{font-family:var(--r-font-serif-accent);font-style:italic;font-weight:400;letter-spacing:0;color:var(--r-signal-blue)}
.rhub-standfirst{font-family:var(--r-font-body);color:var(--r-signal-tint);font-size:var(--r-size-lead);line-height:1.5;max-width:52ch;margin:22px 0 0}
.rhub-tagline{margin:28px 0 0;font-family:var(--r-font-mono);font-size:var(--r-size-meta);letter-spacing:.2em;text-transform:uppercase;color:var(--r-cover-slate)}

/* Graphic column: the dimensional Dweller Line ribbon. */
/* max-width keeps the panel's height proportionate: the artwork's viewBox is portrait (260:320),
   so left unconstrained in a wide 1fr grid column it would scale to an excessively tall hero. */
.rhub-hero-graphic{position:relative;max-width:380px;margin-left:auto}
.rhub-graphic-svg{display:block;width:100%;height:auto}
.rhub-ribbon-front{stroke-dasharray:1;stroke-dashoffset:1;animation:r-draw-on 2600ms var(--r-ease-out) forwards}
.rhub-ribbon-back,.rhub-ribbon-mid{opacity:0;animation:r-layer-in var(--r-motion-slow) var(--r-ease-out) forwards}
.rhub-ribbon-back{animation-delay:0ms}
.rhub-ribbon-mid{animation-delay:200ms}
.rhub-ribbon-dot,.rhub-ribbon-accent{opacity:0;animation:r-layer-in var(--r-motion-slow) var(--r-ease-out) 1100ms forwards}
@keyframes r-draw-on{0%{stroke-dashoffset:1}37.5%{stroke-dashoffset:0}100%{stroke-dashoffset:0}}
@keyframes r-layer-in{to{opacity:1}}

/* ---- Editorial register: "Paper to read, Ink to frame" ----
   Every section after the hero reads on Warm Paper with Ink/Graphite text, so dark stays
   confined to the hero (roughly one section of seven on this page). Scoped to this page's own
   .rhub-* wrapper classes only: global.css's shared .section/.wrap are untouched, so every other
   page on the site keeps its existing navy background exactly as it is. */
.rhub-paper{background:var(--r-paper);color:var(--r-graphite)}
/* Publications transition: a thin gradient rule in the same Navy -> Research Blue -> Signal Blue
   direction as the hero's ribbon, so the Hub reads as one continuous composition rather than an
   expressive hero followed by an unrelated flat section, without one SVG spanning both. */
.rhub-publications{position:relative}
.rhub-publications::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--r-navy),var(--r-blue) 55%,var(--r-signal-blue))}
/* A deliberate editorial rule between sections, rather than every Paper section running directly
   into the next with no visual rhythm: the Approach/bridge/About sections that follow another
   Paper section get a top divider; the two sections right after the hero and state grid don't
   need one, since the dark-to-paper and card-grid-to-rule transitions already read as a break. */
.rhub-approach,.rhub-bridge,.rhub-about{border-top:var(--r-rule-divider) solid var(--r-cover-slate)}
.rhub-approach-copy,.rhub-bridge-copy,.rhub-about-copy{max-width:68ch;font-family:var(--r-font-body);color:var(--r-graphite);font-size:var(--r-size-body);line-height:1.65;margin:0}
.rhub-approach-copy a,.rhub-bridge-copy a,.rhub-about-copy a{color:var(--r-signal-deep);text-decoration:underline;text-underline-offset:2px}
.rhub-bridge-links{display:flex;flex-wrap:wrap;gap:14px;margin:30px 0 0}
/* the shared .btn/.b1/.b2 utilities are corporate-navy-toned; on this light section they need
   their own colours rather than inheriting defaults meant for a dark background */
.rhub-bridge .btn.b1{background:var(--r-signal-deep);color:#FFFFFF}
.rhub-bridge .btn.b1:hover{background:var(--r-navy)}
.rhub-bridge .btn.b2{background:transparent;color:var(--r-midnight-ink);border-color:var(--r-cover-slate)}
.rhub-bridge .btn.b2:hover{border-color:var(--r-signal-deep)}

.rhub-pub-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.rhub-resource-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}

@media(max-width:980px){
  .rhub-pub-grid{grid-template-columns:1fr}
  .rhub-resource-grid{grid-template-columns:1fr}
  /* Simplify, don't just shrink: the graphic drops below the text (one column) and loses its
     back/mid depth layers, down to the single gradient line, the dot, and the accent, so it
     reads as a clean accent under the text rather than a crowded miniature of the desktop
     version. */
  .rhub-hero-grid{grid-template-columns:1fr;gap:28px}
  .rhub-hero-graphic{max-width:280px;margin:0 auto}
  .rhub-ribbon-back,.rhub-ribbon-mid{display:none}
}
@media(prefers-reduced-motion:reduce){
  /* Show the fully-drawn, fully-visible end state immediately rather than just freezing
     mid-animation: the base rules set stroke-dashoffset:1/opacity:0 as the pre-animation
     starting point, so disabling the animation alone would leave the whole graphic invisible. */
  .rhub-ribbon-front{animation:none;stroke-dashoffset:0}
  .rhub-ribbon-back,.rhub-ribbon-mid,.rhub-ribbon-dot,.rhub-ribbon-accent{animation:none;opacity:1}
}
</style>
