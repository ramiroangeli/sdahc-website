---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<BaseLayout title="Contact Us | SDA Home Choices" description="Get in touch with Steve Dawson at SDA Home Choices to discuss a sale, acquisition or strategic review.">
  <PageHeader
    eyebrow="Get in touch"
    title="Contact Us"
  />
  <section class="section"><div class="wrap">
    <div class="contact-details">
      <p class="cd-name">Steve Dawson</p>
      <p><a href="tel:+61408550441">+61 408 550 441</a></p>
      <p><a href="mailto:steve@sdahomechoices.com.au">steve@sdahomechoices.com.au</a></p>
    </div>
  </div></section>
  <section class="section">
    <form class="form" data-endpoint="/api/contact/" data-success="/thank-you/">
      <input type="text" name="company" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
      <div>
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required />
      </div>
      <div>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required />
      </div>
      <div>
        <label for="phone">Phone</label>
        <input type="tel" id="phone" name="phone" />
      </div>
      <div>
        <label for="message">Message</label>
        <textarea id="message" name="message" required></textarea>
      </div>
      <button type="submit" class="btn b1">Submit</button>
      <p class="form-status" role="status"></p>
    </form>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector('form[data-endpoint]');
  if (form) form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]');
    const status = form.querySelector('.form-status');
    const name = form.querySelector('#name').value.trim();
    const email = form.querySelector('#email').value.trim();
    const message = form.querySelector('#message').value.trim();
    if (!name || !email || !message) {
      status.textContent = 'Please complete all required fields.';
      return;
    }
    btn.disabled = true; status.textContent = 'Sending...';
    try {
      const res = await fetch(form.dataset.endpoint, { method: 'POST', body: new FormData(form) });
      const out = await res.json();
      if (out.ok) { window.location.href = form.dataset.success; }
      else { status.textContent = out.error || 'Something went wrong.'; btn.disabled = false; }
    } catch { status.textContent = 'Network error. Please try again.'; btn.disabled = false; }
  });
</script>
<style>
.contact-details{max-width:620px;margin:0 auto;padding:0 30px;color:var(--pale)}
.contact-details p{margin:0 0 8px}
.contact-details a{color:var(--blue);text-decoration:underline;text-underline-offset:2px}
.cd-name{font-family:var(--geo);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
.form button{justify-self:start}
</style>
