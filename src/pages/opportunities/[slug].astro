---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ListingGallery from '../../components/ListingGallery.astro';
import ListingStatusBadge from '../../components/ListingStatusBadge.astro';
import ListingEnquiryForm from '../../components/ListingEnquiryForm.astro';
import { getPublicListings } from '../../data/listings';
import { formatPublicAddress, localityLine } from '../../data/listings/address';
import { formatPricing } from '../../data/listings/pricing';
import { listingJsonLd, listingOgImage } from '../../data/listings/seo';
import { DESIGN_LABEL, TYPE_LABEL } from '../../data/listings/schema';

// Only published listings get a page. A draft, withdrawn or fixture-in-production listing is simply
// absent from getPublicListings(), so its URL does not exist after the next build.
export function getStaticPaths() {
  return getPublicListings().map((listing) => ({ params: { slug: listing.slug }, props: { listing } }));
}

const { listing } = Astro.props;
const { sda, address } = listing;
const price = formatPricing(listing.pricing);
const facts: [string, string][] = [
  ['Address', formatPublicAddress(address)],
  ['Type', TYPE_LABEL[listing.type]],
  [price.label, price.value ? `${price.value} AUD` : price.label === 'Contact Agent' ? 'Enquire for details' : 'Registrations open'],
  ...(sda.designCategories?.length ? [['Design category', sda.designCategories.map((d) => DESIGN_LABEL[d]).join(', ')] as [string, string]] : []),
  ...(sda.buildingType ? [['Build type', sda.buildingType] as [string, string]] : []),
  ...(sda.bedrooms ? [['Bedrooms', String(sda.bedrooms)] as [string, string]] : []),
  ...(sda.residentPlaces ? [['Resident places', String(sda.residentPlaces)] as [string, string]] : []),
];
const hasSdaDetail = Object.values(sda).some((v) => v !== undefined);
const jsonLd = listingJsonLd(listing, Astro.site!.href);
const ogImage = listingOgImage(listing);
const title = `${address.street}, ${address.suburb} ${address.state} | SDA property | SDA Home Choices`;
---
<BaseLayout title={title} description={listing.summary} ogImage={ogImage ?? undefined}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <PageHeader eyebrow={`${localityLine(address)}`} title={listing.title} standfirst={listing.summary} />

  <section class="section ld-main"><div class="wrap">
    <p class="ld-back"><a href="/opportunities/#listings">&larr; All available properties</a></p>
    {listing.isPreview && <p class="ld-fixture" role="note">Local draft preview. Not published, not approved. Enquiries are not sent.</p>}
    {listing.isDemo && <p class="ld-fixture" role="note">Demo listing. Not a live property and contains no verified facts. Images are placeholders.</p>}

    <div class="ld-grid">
      <div class="ld-primary">
        <ListingGallery photos={listing.photos} title={listing.title} />
        <div class="ld-copy">
          <h2>About this property</h2>
          {listing.description.map((p) => <p>{p}</p>)}
          {!hasSdaDetail && <p>Design category, dwelling configuration, enrolment and tenancy detail are released to registered parties under NDA.</p>}
        </div>
      </div>

      <aside class="ld-aside" aria-label="Key details">
        <div class="ld-panel">
          <span class="card-mark" aria-hidden="true"></span>
          <div class="ld-status"><ListingStatusBadge status={listing.commercialStatus} /></div>
          <h2 class="ld-panel-h">Key details</h2>
          <dl class="ld-facts">
            {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
          </dl>
          <a class="btn b1 ld-cta" href="#enquire">Enquire about this property</a>
        </div>
        <div class="ld-panel ld-panel-soft">
          <h2 class="ld-panel-h">How access works</h2>
          <ol class="ld-steps">
            <li>Register your interest below.</li>
            <li>Sign a short mutual NDA.</li>
            <li>Receive the Information Memorandum.</li>
            <li>Submit an EOI.</li>
          </ol>
        </div>
      </aside>
    </div>
  </div></section>

  <section class="section ld-enquire" id="enquire"><div class="wrap ld-enquire-grid">
    <div>
      <h2 class="ld-h2">Enquire about this property</h2>
      <p class="ld-lead">Tell us a little about your brief. The right person at SDA Home Choices will respond and, where it is a fit, send the NDA.</p>
      <p class="ld-lead">Prefer to talk? Call <a href="tel:+61408550441">+61 408 550 441</a> or email <a href="mailto:steve@sdahomechoices.com.au">steve@sdahomechoices.com.au</a>.</p>
    </div>
    <div class="ld-card"><ListingEnquiryForm listingId={listing.id} listingTitle={listing.title} /></div>
  </div></section>
</BaseLayout>

<style>
.ld-main{background:var(--navy);padding-top:24px}
.ld-back{margin:0 0 20px;font-family:var(--geo);font-size:13px;letter-spacing:.06em}
.ld-back a{color:var(--pale);text-underline-offset:3px}
.ld-back a:hover,.ld-back a:focus-visible{color:var(--white)}
.ld-fixture{display:inline-block;margin:0 0 24px;font-family:var(--geo);font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--navy);background:var(--amber);border-radius:2px;padding:8px 12px}
.ld-grid{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:40px;align-items:start}
@media(max-width:900px){.ld-grid{grid-template-columns:1fr;gap:32px}}

.ld-copy{margin-top:32px;max-width:66ch}
.ld-copy h2,.ld-h2{font-family:var(--serif);font-weight:600;color:var(--white);font-size:clamp(22px,2.8vw,30px);line-height:1.15;margin:0 0 16px}
.ld-copy p,.ld-lead{font-family:var(--sans);color:var(--pale);font-size:17px;line-height:1.7;margin:0 0 16px}
.ld-lead a{color:var(--white);text-underline-offset:3px}

.ld-aside{display:flex;flex-direction:column;gap:20px;position:sticky;top:calc(var(--nav-top) + var(--nav-height) + 20px)}
@media(max-width:900px){.ld-aside{position:static}}
.ld-panel{padding:26px 24px;border:1px solid color-mix(in srgb,var(--pale) 18%,transparent);border-radius:10px;background:color-mix(in srgb,var(--white) 5%,transparent)}
.ld-panel-soft{background:transparent}
.ld-panel .card-mark{display:block;width:28px;height:3px;background:var(--blue);margin-bottom:16px;border-radius:2px}
.ld-status{margin-bottom:14px}
.ld-panel-h{font-family:var(--serif);font-weight:600;color:var(--white);font-size:20px;line-height:1.2;margin:0 0 14px}
.ld-facts{margin:0 0 22px;display:grid;grid-template-columns:auto 1fr;gap:10px 18px;font-size:15px}
.ld-facts dt{font-family:var(--geo);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pale);padding-top:3px}
.ld-facts dd{margin:0;color:var(--white)}
.ld-cta{display:inline-block}
.ld-steps{margin:0;padding-left:20px;font-family:var(--sans);font-size:15px;line-height:1.6;color:var(--pale)}
.ld-steps li{margin:0 0 6px}

.ld-enquire{background:var(--navy)}
.ld-enquire-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:56px;align-items:start}
@media(max-width:860px){.ld-enquire-grid{grid-template-columns:1fr;gap:32px}}
.ld-card{border:1px solid color-mix(in srgb,var(--pale) 26%,transparent);border-radius:10px;background:color-mix(in srgb,var(--white) 10%,transparent);padding:36px 34px}
@media(max-width:520px){.ld-card{padding:28px 22px}}
</style>
