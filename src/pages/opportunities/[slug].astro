---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingGallery from '../../components/ListingGallery.astro';
import ListingStatusBadge from '../../components/ListingStatusBadge.astro';
import ListingEnquiryForm from '../../components/ListingEnquiryForm.astro';
import ListingFacts from '../../components/ListingFacts.astro';
import ListingInvestment from '../../components/ListingInvestment.astro';
import AgencyPanel from '../../components/AgencyPanel.astro';
import { getPublicListings } from '../../data/listings';
import { agencyFor } from '../../data/listings/agencies';
import { detailFacts, detailInvestment, detailLocation, detailPricing, designText } from '../../data/listings/detail';
import { listingJsonLd, listingOgImage } from '../../data/listings/seo';
import { TYPE_LABEL } from '../../data/listings/schema';

// Only published listings get a page. A draft, withdrawn or fixture-in-production listing is simply
// absent from getPublicListings(), so its URL does not exist after the next build.
export function getStaticPaths() {
  return getPublicListings().map((listing) => ({ params: { slug: listing.slug }, props: { listing } }));
}

const { listing } = Astro.props;
const { address } = listing;
// a sold property is not offered: no price, no purchase enquiry, no access steps, no commercial figures (a general enquiry route instead)
const sold = listing.commercialStatus === 'sold';
const location = detailLocation(listing);
const design = designText(listing);
const allFacts = detailFacts(listing);
// one optional fact is shown compactly under the title; two or more get the full Key property information section; none shows nothing
const compactFact = allFacts.length === 1 ? allFacts[0] : null;
const facts = allFacts.length >= 2 ? allFacts : [];
const investment = detailInvestment(listing);
const pricing = detailPricing(listing);
const agency = agencyFor(listing.marketing?.agency);
const hasSdaDetail = Object.values(listing.sda).some((v) => v !== undefined) || facts.length > 0;
const jsonLd = listingJsonLd(listing, Astro.site!.href);
const ogImage = listingOgImage(listing);
const title = `${address.street}, ${address.suburb} ${address.state} | SDA property | SDA Home Choices`;
---
<BaseLayout title={title} description={listing.summary} ogImage={ogImage ?? undefined}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="ld-top"><div class="wrap">
    <p class="ld-back"><a href="/opportunities/#listings">&larr; All public listings</a></p>
    {listing.isPreview && <p class="ld-fixture" role="note">Local draft preview. Not published, not approved. Enquiries are not sent.</p>}
    {listing.isDemo && <p class="ld-fixture" role="note">Demo listing. Not a live property and contains no verified facts. Images are placeholders.</p>}

    <header class="ld-head">
      <div class="ld-head-main">
        <div class="ld-badges">
          <ListingStatusBadge status={listing.commercialStatus} />
          <span class="ld-type">{TYPE_LABEL[listing.type]}</span>
          {design && <span class="ld-cat">{design}</span>}
        </div>
        <h1 class="ld-h1">{listing.title}</h1>
        {location && <p class="ld-loc">{location}</p>}
        {compactFact && (compactFact.bare
          ? <p class="ld-fact">{compactFact.value}</p>
          : <p class="ld-fact"><span>{compactFact.label}</span> {compactFact.value}</p>)}
      </div>
      {!sold && <a class="btn b1 ld-head-cta" href="#enquire">Enquire about this property</a>}
    </header>

    <ListingGallery photos={listing.photos} title={listing.title} />
  </div></section>

  <section class="section ld-main"><div class="wrap ld-grid">
    <div class="ld-primary">
      <ListingFacts heading="Key property information" rows={facts} id="facts-h" />
      <ListingInvestment section={investment} />
      <section class="ld-copy" aria-labelledby="about-h">
        <h2 class="ld-h2" id="about-h">About this property</h2>
        {listing.description.map((p) => <p>{p}</p>)}
        {!hasSdaDetail && <p>Design category, dwelling configuration, enrolment and tenancy detail are released to registered parties under NDA.</p>}
      </section>
    </div>

    <div class="ld-aside">
      <AgencyPanel agency={agency} sold={sold} pricing={pricing} />
      {!sold && (
        <div class="ld-steps-panel">
          <h2 class="ld-panel-h">How access works</h2>
          <ol class="ld-steps">
            <li>Register your interest below.</li>
            <li>Sign a short mutual NDA.</li>
            <li>Receive the Information Memorandum.</li>
            <li>Submit an EOI.</li>
          </ol>
        </div>
      )}
    </div>
  </div></section>

  {sold ? (
    <section class="section ld-enquire" id="enquire"><div class="wrap"><div class="ld-sold">
      <h2 class="ld-h2">This property has been sold</h2>
      <p class="ld-lead">If you are looking for a similar SDA property, tell us about your brief and we will contact you when a suitable property becomes available, including off-market opportunities.</p>
      <p class="ld-lead">Prefer to talk? Call <a href="tel:+61408550441">+61 408 550 441</a> or email <a href="mailto:steve@sdahomechoices.com.au">steve@sdahomechoices.com.au</a>.</p>
      <p><a class="btn b1" href="/contact-us/">Tell us what you are looking for</a></p>
    </div></div></section>
  ) : (
    <section class="section ld-enquire" id="enquire"><div class="wrap ld-enquire-grid">
      <div>
        <h2 class="ld-h2">Enquire about this property</h2>
        <p class="ld-lead">Tell us a little about your brief. The right person at SDA Home Choices will respond and, where it is a fit, send the NDA.</p>
        <p class="ld-lead">Prefer to talk? Call <a href="tel:+61408550441">+61 408 550 441</a> or email <a href="mailto:steve@sdahomechoices.com.au">steve@sdahomechoices.com.au</a>.</p>
      </div>
      <div class="ld-card"><ListingEnquiryForm listingId={listing.id} listingTitle={listing.title} /></div>
    </div></section>
  )}
</BaseLayout>

<style>
/* the top of the page: same navy surface as the page headers, with the gallery directly under the title */
.ld-top{padding:calc(118px + var(--nav-top)) 0 44px;position:relative;background:radial-gradient(1000px 520px at 78% 10%,rgba(4,118,217,.10),transparent 60%),var(--navy)}
.ld-back{margin:0 0 18px;font-family:var(--geo);font-size:13px;letter-spacing:.06em}
.ld-back a{color:var(--pale);text-underline-offset:3px}
.ld-back a:hover,.ld-back a:focus-visible{color:var(--white)}
.ld-fixture{display:inline-block;margin:0 0 20px;font-family:var(--geo);font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--navy);background:var(--amber);border-radius:2px;padding:8px 12px}
.ld-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:18px 32px;margin:0 0 26px}
.ld-head-main{min-width:0;flex:1 1 560px}
.ld-badges{display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px;margin:0 0 14px}
.ld-type{font-family:var(--geo);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--pale)}
.ld-cat{font-family:var(--geo);font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--white);border:1px solid color-mix(in srgb,var(--blue) 70%,transparent);border-radius:2px;padding:4px 10px}
.ld-h1{font-family:var(--serif);font-weight:600;color:#fff;font-size:clamp(30px,4.2vw,50px);line-height:1.08;letter-spacing:-.01em;margin:0;max-width:24ch;overflow-wrap:anywhere}
.ld-loc{font-family:var(--geo);font-size:15px;letter-spacing:.04em;color:var(--pale);margin:12px 0 0}
.ld-fact{margin:14px 0 0;font-family:var(--sans);font-size:17px;font-weight:600;color:var(--white)}
.ld-fact span{margin-right:8px;font-family:var(--geo);font-size:12px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--pale)}
.ld-head-cta{flex:0 0 auto;display:inline-block;text-align:center}

.ld-main{background:var(--navy);padding-top:16px}
.ld-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:48px;align-items:start}
@media(max-width:940px){.ld-grid{grid-template-columns:1fr;gap:36px}}
.ld-aside{display:flex;flex-direction:column;gap:20px;position:sticky;top:calc(var(--nav-top) + var(--nav-height) + 20px)}
@media(max-width:940px){.ld-aside{position:static}}

.ld-copy{max-width:68ch}
.ld-h2{font-family:var(--serif);font-weight:600;color:var(--white);font-size:clamp(22px,2.6vw,28px);line-height:1.15;margin:0 0 16px}
.ld-copy p,.ld-lead{font-family:var(--sans);color:var(--pale);font-size:17px;line-height:1.7;margin:0 0 16px}
.ld-lead a{color:var(--white);text-underline-offset:3px}

.ld-steps-panel{padding:22px 22px 20px;border:1px solid color-mix(in srgb,var(--pale) 18%,transparent);border-radius:10px;background:transparent}
.ld-panel-h{font-family:var(--serif);font-weight:600;color:var(--white);font-size:19px;line-height:1.2;margin:0 0 12px}
.ld-steps{margin:0;padding-left:20px;font-family:var(--sans);font-size:15px;line-height:1.6;color:var(--pale)}
.ld-steps li{margin:0 0 6px}
.ld-sold{max-width:66ch}

/* both enquiry buttons link here; keep the heading clear of the fixed navigation when it scrolls into view */
.ld-enquire{background:var(--navy);scroll-margin-top:calc(var(--nav-top) + var(--nav-height) + 16px)}
.ld-enquire-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:56px;align-items:start}
@media(max-width:860px){.ld-enquire-grid{grid-template-columns:1fr;gap:32px}}
.ld-card{border:1px solid color-mix(in srgb,var(--pale) 26%,transparent);border-radius:10px;background:color-mix(in srgb,var(--white) 10%,transparent);padding:36px 34px}
@media(max-width:520px){.ld-card{padding:28px 22px}.ld-head-cta{width:100%}}
</style>
