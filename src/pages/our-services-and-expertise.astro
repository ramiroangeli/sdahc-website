---
import BaseLayout from '../layouts/BaseLayout.astro';
import DisplayHeader from '../components/DisplayHeader.astro';
import { SITE, ORG_ID } from '../data/seo';
const services = [
  { name: 'SDA property and portfolio sales', path: '/sda-property-and-portfolio-sales/' },
  { name: 'SDA strategic divestment advisory', path: '/sda-strategic-divestment-advisory/' },
  { name: 'Buying and selling SDA property portfolios', path: '/buying-and-selling-sda-property-portfolios/' },
];
const schema = [{
  '@type': 'OfferCatalog',
  '@id': `${SITE}/our-services-and-expertise/#services`,
  name: 'SDA advisory and transaction services',
  url: `${SITE}/our-services-and-expertise/`,
  provider: { '@id': ORG_ID },
  itemListElement: services.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s.name, url: `${SITE}${s.path}`, provider: { '@id': ORG_ID } },
  })),
}];
---
<BaseLayout title="Our services and expertise | SDA Home Choices" description="SDA advisory across the asset lifecycle: acquisition and divestment strategy, commercial due diligence, and portfolio transactions in Specialist Disability Accommodation." breadcrumbs={[{ name: 'Our services', path: '/our-services-and-expertise/' }]} schema={schema}>
  <DisplayHeader eyebrow="SDA portfolio advisory" intro="From individual dwellings to institutional portfolios, we advise across the full lifecycle of an SDA asset, and we do nothing else." ratio={10.65} ratioMobile={8.05}>Services<br class="sm-br" /> and<br /> expertise</DisplayHeader>
  <section class="section svcs-section"><div class="wrap">
    <div class="svcs">
      <div class="svc a1"><h2><a href="/sda-property-and-portfolio-sales/">SDA Property and Portfolio Sales</a></h2><p>We specialise in the divestment of completed SDA properties, tenanted or untenanted, and provide expert support in vendor due diligence.</p><a href="/sda-property-and-portfolio-sales/">Learn more →</a></div>
      <div class="svc a2"><h2><a href="/sda-strategic-divestment-advisory/">SDA Strategic Divestment Advisory</a></h2><p>We provide strategic divestment advice and receivership support, helping clients navigate the complexities of SDA divestment, assess asset viability, and implement tailored exit or recovery strategies.</p><a href="/sda-strategic-divestment-advisory/">Learn more →</a></div>
      <div class="svc a3"><h2><a href="/buying-and-selling-sda-property-portfolios/">Buying and Selling SDA Property Portfolios</a></h2><p>We facilitate transactions, managing all aspects of SDA portfolio sales, from coordinating specialist valuations and exit strategy planning to complex off-market sales negotiations, connecting investors with opportunities.</p><a href="/buying-and-selling-sda-property-portfolios/">Learn more →</a></div>
    </div>
  </div></section>
</BaseLayout>
<style>
/* the cards sit on paper (the header above is the page's navy block): white cards, navy type, accent bar on hover */
.svcs-section{background:var(--paper)}
.svcs{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.svc{position:relative;overflow:hidden;background:var(--white);border:1px solid color-mix(in srgb,var(--navy) 12%,transparent);border-radius:8px;padding:38px 30px;box-shadow:0 10px 26px color-mix(in srgb,var(--navy) 6%,transparent);transition:transform .25s,border-color .25s}
.svc::before{content:"";position:absolute;left:0;top:0;height:3px;width:100%;background:var(--acc);transform:scaleX(0);transform-origin:left;transition:transform .3s}
.svc:hover{transform:translateY(-5px);border-color:var(--acc)}
.svc:hover::before{transform:scaleX(1)}
.svc.a1{--acc:var(--blue)}
.svc.a2{--acc:var(--teal)}
.svc.a3{--acc:var(--amber)}
.svc h2{font-family:var(--serif);font-weight:600;font-size:24px;color:var(--navy);margin:0 0 12px;line-height:1.15}
.svc h2 a{color:var(--navy);text-decoration:none}
.svc p{font-size:15.5px;color:var(--slate);margin:0 0 20px}
.svc a{font-family:var(--geo);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--navy2);text-decoration:none}
.svc a:hover,.svc a:focus-visible{text-decoration:underline;text-underline-offset:3px}
@media(max-width:860px){.svcs{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.svc{transition:border-color .25s}.svc:hover{transform:none}}
</style>
