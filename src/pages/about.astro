---
import BaseLayout from '../layouts/BaseLayout.astro';
import DisplayHeader from '../components/DisplayHeader.astro';
import { Image, getImage } from 'astro:assets';
import steveDawson from '../assets/steve-dawson.jpg';
import { SITE, ORG_ID, STEVE_ID } from '../data/seo';
import team from '../content/team.json';

// Same size and format as the visible portrait below, so the build reuses one file.
// Team section: the texts come from src/content/team.json (name, role, photo path under /public, bio, three areas). A member without a photo shows a monogram.
// Placeholder text ("to come") never reaches production: on a Vercel production build the section is left out until the file is filled in. Previews and local builds show it.
const hasPlaceholders = team.members.some((m) => /to come/i.test(JSON.stringify(m)));
const showTeam = !(hasPlaceholders && process.env.VERCEL_ENV === 'production');
const initials = (name: string) => name.split(/\s+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const portrait = await getImage({ src: steveDawson, width: 400, height: 400 });
const schema = [
  {
    '@type': 'AboutPage',
    '@id': `${SITE}/about/#page`,
    url: `${SITE}/about/`,
    name: 'About SDA Home Choices',
    mainEntity: { '@id': ORG_ID },
  },
  {
    '@type': 'Person',
    '@id': STEVE_ID,
    name: 'Steve Dawson',
    jobTitle: 'Managing Director',
    worksFor: { '@id': ORG_ID },
    url: `${SITE}/about/`,
    image: new URL(portrait.src, SITE).href,
    description: 'Steve Dawson has over 25 years of commercial real estate experience and 9 years in Specialist Disability Accommodation. He is a trusted board advisor to organisations such as Multiple Sclerosis Queensland and has sold SDA properties for multiple organisations.',
    knowsAbout: ['Specialist Disability Accommodation', 'Commercial real estate', 'SDA property and portfolio sales', 'SDA divestment strategy'],
  },
];
---
<BaseLayout title="About | SDA Home Choices" description="SDA Home Choices is an independent advisory and transactions firm working exclusively in Specialist Disability Accommodation across Australia." breadcrumbs={[{ name: 'About', path: '/about/' }]} schema={schema}>
  <DisplayHeader eyebrow="About SDA Home Choices" subtitle="The specialist behind SDA transactions in Australia." intro="SDA Home Choices is an independent advisory and transactions firm working exclusively in Specialist Disability Accommodation. We help investors, providers, boards, lenders and family offices buy, sell and reposition SDA assets with commercial clarity the sector has rarely had." ratio={7.3}>About us</DisplayHeader>

  <section class="section about-flow">
    <div class="wrap about-trio">
      <div class="trio-item">
        <span class="trio-no">01</span>
        <h2>What we do</h2>
        <p>We advise on the sale, acquisition and strategic review of SDA properties and portfolios, from individual dwellings to institutional holdings. Our work spans vendor due diligence, buyer representation, and independent commercial assessment of whether to hold, improve, reposition or sell.</p>
      </div>
      <div class="trio-item">
        <span class="trio-no">02</span>
        <h2>Why specialist</h2>
        <p>SDA is a niche, maturing market where headline funding and fully occupied forecasts can obscure real performance. We focus on the operating evidence that actually drives occupancy, income sustainability and capital value, and we do nothing else.</p>
      </div>
      <div class="trio-item">
        <span class="trio-no">03</span>
        <h2>Backed by research</h2>
        <p>Our transaction work is supported by dedicated SDA research, including the SDA Market Report 2026, combining public NDIS data with proprietary transaction evidence across every Australian jurisdiction.</p>
      </div>
    </div>

    <div class="wrap about-cta-row">
      <a class="btn b1 about-cta-bar" href="/contact-us/">Talk to our team</a>
      <span class="about-cta-or">or</span>
      <a class="btn b1 about-cta-bar" href="/our-services-and-expertise/">Explore our services</a>
    </div>

    <div class="wrap about-stats">
      <div class="about-stat"><div class="n">25+</div><div class="k">Years of specialist commercial experience</div></div>
      <div class="about-stat"><div class="n">Australia&#8209;wide</div><div class="k">National coverage across every jurisdiction</div></div>
      <div class="about-stat"><div class="n">SDA&#8209;exclusive</div><div class="k">We do nothing else</div></div>
      <div class="about-stat"><div class="n">76&#8209;page</div><div class="k">SDA Market Report 2026, free</div></div>
    </div>

    <div class="wrap">
      <p class="about-coverage">SDA Home Choices provides specialist SDA property and portfolio advisory services across Australia, with licensed operations in Queensland, Victoria and the Northern Territory.</p>
    </div>
  </section>

  <section class="section about-paper about-steve-section"><div class="wrap about-grid">
    <div class="about-portrait-frame">
      <Image src={steveDawson} alt="Portrait of Steve Dawson, Managing Director of SDA Home Choices" class="portrait" width={400} height={400} />
    </div>
    <div class="prose about-prose">
      <h2>Steve Dawson, Managing Director</h2>
      <p>Steve Dawson has over 25 years of commercial real estate experience and 9 years in Specialist Disability Accommodation. He is a trusted board advisor to organisations such as Multiple Sclerosis Queensland, has sold SDA properties for multiple organisations, and has built a reputation for achieving results with discretion. Steve is passionate about the sector and works collaboratively with all stakeholders, including the major SDA funds invested in the space.</p>
    </div>
  </div></section>

  {showTeam && (
  <section class="section about-paper about-team" aria-labelledby="team-h"><div class="wrap">
    <h2 class="team-h" id="team-h">{team.heading}</h2>
    <div class="team-grid">
      {team.members.map((m) => (
        <article class="team-card">
          {m.photo ? (
            <div class="team-photo-frame"><img src={m.photo} alt={m.photoAlt || `Portrait of ${m.name}`} class="team-photo" width="96" height="96" loading="lazy" decoding="async" /></div>
          ) : (
            <div class="team-monogram" aria-hidden="true">{initials(m.name)}</div>
          )}
          <h3 class="team-name">{m.name}</h3>
          <p class="team-role">{m.role}</p>
          <p class="team-bio">{m.bio}</p>
          <ul class="team-areas" aria-label={`Areas of specialty, ${m.name}`}>
            {m.areas.slice(0, 3).map((a) => <li>{a}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div></section>
  )}
</BaseLayout>
<style>
:root{
  --about-depth:.85;
  --about-flow-top:var(--navy);
  --about-flow-mid:var(--slate);
  --about-flow-bottom:color-mix(in srgb,var(--navy) 45%,var(--paper));
}

/* the single flowing band: blends out of the hero navy, through a lighter slate zone behind the trio,
   back toward a richer glow behind the stats row, then eases toward paper for the handoff into Steve */
.about-flow{position:relative;overflow:hidden;padding:88px 0 96px}
.about-flow::before{content:"";position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,var(--about-flow-top) 0%,var(--about-flow-mid) 30%,var(--about-flow-mid) 56%,var(--navy) 76%,var(--about-flow-bottom) 100%)}
.about-flow::after{content:"";position:absolute;inset:0;z-index:0;opacity:var(--about-depth);background:radial-gradient(900px 560px at 50% 84%,rgba(4,118,217,.35) 0%,rgba(4,118,217,0) 62%)}
.about-flow>*{position:relative;z-index:1}

/* the three items: one consistent, uniform set, same structure and surface throughout */
.about-trio{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;align-items:stretch}
.trio-item{display:flex;flex-direction:column;height:100%;padding:30px 26px;border:1px solid color-mix(in srgb,var(--pale) 18%,transparent);border-radius:10px;background:rgba(255,255,255,.05);transition:transform .22s ease,border-color .22s ease,background .22s ease}
.trio-item:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--blue) 55%,transparent);background:rgba(255,255,255,.08)}
.trio-no{display:block;font-family:var(--cond);font-weight:600;font-size:13px;letter-spacing:.1em;color:#fff;margin-bottom:14px}
.trio-item h2{font-family:var(--serif);font-weight:600;color:#fff;font-size:clamp(21px,2.1vw,25px);line-height:1.18;margin:0 0 14px}
.trio-item p{font-family:var(--sans);color:#fff;font-size:15.5px;line-height:1.65;margin:0}
@media(max-width:860px){.about-trio{grid-template-columns:1fr;gap:22px}}
@media(prefers-reduced-motion:reduce){.trio-item{transition:background .22s ease,border-color .22s ease}.trio-item:hover{transform:none}}

.about-cta-row{display:flex;align-items:center;gap:24px;max-width:760px;margin:48px auto 0}
.about-cta-bar{flex:1 1 0;display:block;text-align:center}
.about-cta-or{flex:0 0 auto;font-family:var(--sans);font-size:15px;color:#fff}
@media(max-width:600px){.about-cta-row{flex-direction:column;gap:16px}.about-cta-bar{width:100%}}

/* stats / credentials row */
.about-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:88px}
.about-stat{padding:30px 24px;border:1px solid color-mix(in srgb,var(--pale) 16%,transparent);border-radius:8px;background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.015))}
.about-stat .n{font-family:var(--cond);font-weight:600;font-size:clamp(30px,3.4vw,44px);line-height:1;color:#fff;font-variant-numeric:tabular-nums}
.about-stat .k{font-size:14px;color:var(--pale);margin-top:12px;max-width:22ch}
.about-coverage{font-family:var(--sans);font-size:17px;line-height:1.65;color:var(--white);max-width:74ch;margin:40px 0 0}
@media(max-width:860px){.about-stats{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.about-stats{grid-template-columns:1fr}}

/* Steve Dawson feature, unchanged from the approved pass */
.about-paper{background:var(--paper)}
.about-paper .prose{color:var(--slate)}
.about-paper .prose h2{color:var(--navy)}
.about-paper .prose strong{color:var(--navy)}
.about-paper .prose a{color:var(--navy2)}
.about-grid{display:grid;grid-template-columns:340px 1fr;gap:56px;align-items:center}
.about-portrait-frame{background:#fff;padding:16px;border-radius:12px;box-shadow:0 24px 60px rgba(0,10,25,.28)}
.portrait{display:block;width:100%;height:auto;border-radius:6px}
.about-prose{padding:0;max-width:none}
.about-prose h2{margin-top:0}
@media(max-width:700px){.about-grid{grid-template-columns:1fr}.about-portrait-frame{max-width:280px;margin:0 auto}}

/* Our team: same paper surface as the Steve feature, in card size */
.about-team{padding-top:0}
.team-h{font-family:var(--serif);font-weight:600;color:var(--navy);font-size:clamp(24px,3.2vw,34px);line-height:1.15;margin:0 0 28px}
.team-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:900px}
@media(max-width:700px){.team-grid{grid-template-columns:1fr}}
.team-card{display:flex;flex-direction:column;align-items:flex-start;padding:30px 28px 32px;border:1px solid color-mix(in srgb,var(--navy) 12%,transparent);border-radius:10px;background:var(--white);box-shadow:0 10px 26px color-mix(in srgb,var(--navy) 6%,transparent)}
.team-photo-frame{background:var(--white);padding:8px;border-radius:12px;box-shadow:0 14px 34px rgba(0,10,25,.22);margin-bottom:18px}
.team-photo{display:block;width:96px;height:96px;object-fit:cover;border-radius:6px}
.team-monogram{display:flex;align-items:center;justify-content:center;width:96px;height:96px;border-radius:50%;background:var(--navy);border:2px solid var(--blue-mid);color:var(--paper);font-family:var(--cond);font-weight:700;font-size:34px;letter-spacing:.04em;margin-bottom:18px}
.team-name{font-family:var(--serif);font-weight:600;font-size:22px;line-height:1.2;color:var(--navy);margin:0 0 4px}
.team-role{font-family:var(--geo);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--slate);margin:0 0 14px}
.team-bio{font-family:var(--sans);font-size:16px;line-height:1.6;color:var(--slate);margin:0 0 18px}
.team-areas{list-style:none;margin:auto 0 0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
.team-areas li{font-family:var(--geo);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--navy);border:1px solid color-mix(in srgb,var(--navy) 22%,transparent);border-radius:999px;padding:6px 12px}
</style>
